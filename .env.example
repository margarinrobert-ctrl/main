# ---- Barchart OnDemand ----
# Your API key. Get one at https://www.barchart.com/ondemand (account + ToS required).
# NEVER commit your real key. Copy this file to .env.local and fill it in.
BARCHART_API_KEY=

# Base host. Confirm against your account docs — some accounts get a different subdomain.
BARCHART_BASE_URL=https://ondemand.websol.barchart.com/

# ---- App behavior ----
# Data source: 'fixtures' (default — canned JSON, no key, no quota) | 'live'
DATA_SOURCE=fixtures

# Cache TTL for live responses, in seconds.
CACHE_TTL_SECONDS=60

# Background poll interval in ms. 0 = manual refresh only (default; safest for trial limits).
POLL_INTERVAL_MS=0
