# ---- Barchart OnDemand ----
# Your API key. Get one at https://www.barchart.com/ondemand (account + ToS required).
# NEVER commit your real key. Copy this file to .env.local and fill it in.
BARCHART_API_KEY=

# Base host. Confirm against your account docs — some accounts get a different subdomain.
BARCHART_BASE_URL=https://ondemand.websol.barchart.com/

# ---- App behavior ----
# Data source: 'live' (default — fetch fresh data) | 'fixtures' (offline canned JSON)
DATA_SOURCE=live

# Underlying quote + price history provider:
#   'stooq' (default; free, keyless, EOD ~1 day old) | 'barchart' (uses your key)
MARKET_DATA_PROVIDER=stooq

# ---- Options data (chain / heatmap / flow) ----
# Free EOD options chains (~1 day old) via Alpha Vantage. Get a FREE key (instant):
#   https://www.alphavantage.co/support/#api-key
# With a key set, the options provider auto-switches to Alpha Vantage.
ALPHAVANTAGE_API_KEY=
# OPTIONS_PROVIDER=alphavantage          # or 'barchart' (paid). Auto-selected from the key above.
# OPTIONS_WATCHLIST=SPY,QQQ,AAPL,NVDA,TSLA,AMD
# OPTIONS_CACHE_TTL_SECONDS=21600        # 6h — EOD data changes once a day

# Cache TTL for live quote/history responses, in seconds.
CACHE_TTL_SECONDS=60

# Background poll interval in ms. 0 = manual refresh only (default; safest for trial limits).
POLL_INTERVAL_MS=0
