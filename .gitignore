# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# typescript
*.tsbuildinfo

# production
/build

# env (NEVER commit secrets)
.env
.env*.local

# probe output (raw live responses saved by `npm run probe`)
/fixtures/*.live.json
/fixtures/*.raw.json

# static export: fixtures copied into public/ at build time (source of truth is /fixtures)
/public/fixtures/

# misc
*.log
.DS_Store
/coverage

# Research data — large, often licensed, and reproducible from the ingest command
# recorded in each study's header. Never commit raw or canonical bar files.
/data/*.csv
/data/*.json
# uploaded bar files arrive in several formats; the registry in research/datasets.py is
# the durable memory of the data, so no raw feed is ever committed.
/data/*.rtf
/data/*.txt
/data/*.7z
/data/*.parquet

# Python research layer
__pycache__/
*.pyc

# ML layer artifacts: local experiment store, exported platform data, model caches
research/mlruns.db
research/mlruns/
research/qlib_data/
research/lean_data/
research/**/__pycache__/
catboost_info/
research/trend_search_results.parquet
research/portfolio_daily.parquet
research/edgelab/_*.parquet
research/atme/_*.parquet
research/hypo/_*.parquet

# sweep artefacts are large and regenerable
research/vbt/_*.npz

data/CAPITALCOM_US30_1m_export.csv
results/apm/*.pkl
results/apm/.done
results/trendday/sweep_*.csv
results/trendday/dc_*.csv
results/inst/frontier_grid.parquet
