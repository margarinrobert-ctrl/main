# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# typescript
*.tsbuildinfo

# production
/build

# env (NEVER commit secrets)
.env
.env*.local

# probe output (raw live responses saved by `npm run probe`)
/fixtures/*.live.json
/fixtures/*.raw.json

# static export: fixtures copied into public/ at build time (source of truth is /fixtures)
/public/fixtures/

# misc
*.log
.DS_Store
/coverage

# Research data — large, often licensed, and reproducible from the ingest command
# recorded in each study's header. Never commit raw or canonical bar files.
/data/*.csv
/data/*.json

# Python research layer
__pycache__/
*.pyc

# ML layer artifacts: local experiment store, exported platform data, model caches
research/mlruns.db
research/mlruns/
research/qlib_data/
research/lean_data/
research/**/__pycache__/
catboost_info/
