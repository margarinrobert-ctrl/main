# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# typescript
*.tsbuildinfo

# production
/build

# env (NEVER commit secrets)
.env
.env*.local

# probe output (raw live responses saved by `npm run probe`)
/fixtures/*.live.json
/fixtures/*.raw.json

# static export: fixtures copied into public/ at build time (source of truth is /fixtures)
/public/fixtures/

# misc
*.log
.DS_Store
/coverage

# Python
__pycache__/
*.pyc

# backtest intermediates derived from local market data
backtests/**/grid.npz
