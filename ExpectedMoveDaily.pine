//@version=6
indicator("Expected Move (Daily) - VIX/VXN Sigma Levels", shorttitle="EM-Daily",
     overlay=true, max_bars_back=5000, max_labels_count=500, max_lines_count=500)

// ============================================================
// Inputs
// ============================================================
gVol      = "Volatility Source"
volMode   = input.string("VIX", "Implied Vol Index", options=["VIX", "VXN", "Custom"], group=gVol,
     tooltip="VIX = S&P 500 (SPX/ES/SPY).  VXN = Nasdaq 100 (NDX/NQ/QQQ).  Custom = type any IV index symbol below.")
customSym = input.symbol("CBOE:VIX", "Custom IV Symbol", group=gVol,
     tooltip="Used only when 'Implied Vol Index' is set to Custom.")

gCalc     = "Calculation"
anchorOpen = input.bool(true, "Anchor to Daily Open", group=gCalc,
     tooltip="On = center bands on today's open price. Off = center on previous daily close.")
tradingDays = input.int(252, "Annualization (trading days)", minval=1, maxval=365, group=gCalc,
     tooltip="VIX/VXN are annualized 1-sigma moves. 252 trading days is the standard. Use 365 for calendar days.")
dteDays   = input.float(1.0, "Horizon (days)", minval=0.1, step=0.5, group=gCalc,
     tooltip="Number of days for the expected move. 1 = expected move for today.")

gSig      = "Sigma Deviations"
showS1    = input.bool(true,  "Show 1 sigma",   group=gSig)
mult1     = input.float(1.0,  "1 sigma x",      step=0.25, group=gSig)
showS2    = input.bool(true,  "Show 2 sigma",   group=gSig)
mult2     = input.float(2.0,  "2 sigma x",      step=0.25, group=gSig)
showS3    = input.bool(false, "Show 3 sigma",   group=gSig)
mult3     = input.float(3.0,  "3 sigma x",      step=0.25, group=gSig)

gStyle    = "Style"
colUp     = input.color(color.new(color.teal, 0),   "Upper line color", group=gStyle)
colDn     = input.color(color.new(color.red, 0),    "Lower line color", group=gStyle)
colMid    = input.color(color.new(color.gray, 0),   "Center line color", group=gStyle)
lineWidth = input.int(1, "Line width", minval=1, maxval=4, group=gStyle)
lineStyl  = input.string("Solid", "Line style", options=["Solid", "Dashed", "Dotted"], group=gStyle)
showLbl   = input.bool(true, "Show labels (price + sigma)", group=gStyle)
showFill  = input.bool(true, "Shade 1-sigma zone", group=gStyle)
lblSize   = input.string("Normal", "Label size", options=["Tiny","Small","Normal","Large"], group=gStyle)

// ============================================================
// Helpers
// ============================================================
ivSymbol = volMode == "VIX" ? "CBOE:VIX" : volMode == "VXN" ? "CBOE:VXN" : customSym

// Pull the implied vol index (annualized %, e.g. 14.5)
iv = request.security(ivSymbol, "D", close, ignore_invalid_symbol=true)

f_lineStyle(s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid
ls = f_lineStyle(lineStyl)

f_lblSize(s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : size.normal
lz = f_lblSize(lblSize)

// New trading day detection
newDay = ta.change(time("D")) != 0

// Center price for the day: today's open, or yesterday's close
var float center = na
if newDay
    center := anchorOpen ? open : close[1]

// 1-sigma expected move (price units):
//   EM = Price * (IV/100) * sqrt(horizon / annualization)
sigma = na(iv) or na(center) ? na : center * (iv / 100.0) * math.sqrt(dteDays / tradingDays)

// ============================================================
// Drawing - one set of lines/labels per day, extended across it
// ============================================================
var line   lnMid = na
var line   lnU1  = na, var line lnD1 = na
var line   lnU2  = na, var line lnD2 = na
var line   lnU3  = na, var line lnD3 = na
var label  lbMid = na
var label  lbU1  = na, var label lbD1 = na
var label  lbU2  = na, var label lbD2 = na
var label  lbU3  = na, var label lbD3 = na
var linefill flU = na, var linefill flD = na

f_lbl(_x, _y, _txt, _col, _yloc) =>
    label.new(_x, _y, _txt, xloc=xloc.bar_time, yloc=_yloc, style=label.style_label_left,
         color=color.new(color.black, 100), textcolor=_col, size=lz)

if newDay and not na(sigma)
    u1 = center + sigma * mult1
    d1 = center - sigma * mult1
    u2 = center + sigma * mult2
    d2 = center - sigma * mult2
    u3 = center + sigma * mult3
    d3 = center - sigma * mult3

    t1 = time
    t2 = time + 24 * 60 * 60 * 1000  // extend ~1 day forward

    // Center
    lnMid := line.new(t1, center, t2, center, xloc=xloc.bar_time, color=colMid, width=lineWidth, style=line.style_dotted)

    // 1 sigma
    lnU1 := showS1 ? line.new(t1, u1, t2, u1, xloc=xloc.bar_time, color=colUp, width=lineWidth, style=ls) : na
    lnD1 := showS1 ? line.new(t1, d1, t2, d1, xloc=xloc.bar_time, color=colDn, width=lineWidth, style=ls) : na

    // 2 sigma
    lnU2 := showS2 ? line.new(t1, u2, t2, u2, xloc=xloc.bar_time, color=colUp, width=lineWidth, style=ls) : na
    lnD2 := showS2 ? line.new(t1, d2, t2, d2, xloc=xloc.bar_time, color=colDn, width=lineWidth, style=ls) : na

    // 3 sigma
    lnU3 := showS3 ? line.new(t1, u3, t2, u3, xloc=xloc.bar_time, color=colUp, width=lineWidth, style=ls) : na
    lnD3 := showS3 ? line.new(t1, d3, t2, d3, xloc=xloc.bar_time, color=colDn, width=lineWidth, style=ls) : na

    // Optional shading of the 1-sigma zone
    if showFill and showS1
        flU := linefill.new(lnU1, lnMid, color.new(colUp, 90))
        flD := linefill.new(lnMid, lnD1, color.new(colDn, 90))

    // Labels
    if showLbl
        ivTxt = str.tostring(iv, "#.##")
        lbMid := f_lbl(t2, center, "EM mid (" + volMode + " " + ivTxt + ")  " + str.tostring(center, format.mintick), colMid, yloc.price)
        if showS1
            lbU1 := f_lbl(t2, u1, "+" + str.tostring(mult1, "#.##") + "σ  " + str.tostring(u1, format.mintick), colUp, yloc.price)
            lbD1 := f_lbl(t2, d1, "-" + str.tostring(mult1, "#.##") + "σ  " + str.tostring(d1, format.mintick), colDn, yloc.price)
        if showS2
            lbU2 := f_lbl(t2, u2, "+" + str.tostring(mult2, "#.##") + "σ  " + str.tostring(u2, format.mintick), colUp, yloc.price)
            lbD2 := f_lbl(t2, d2, "-" + str.tostring(mult2, "#.##") + "σ  " + str.tostring(d2, format.mintick), colDn, yloc.price)
        if showS3
            lbU3 := f_lbl(t2, u3, "+" + str.tostring(mult3, "#.##") + "σ  " + str.tostring(u3, format.mintick), colUp, yloc.price)
            lbD3 := f_lbl(t2, d3, "-" + str.tostring(mult3, "#.##") + "σ  " + str.tostring(d3, format.mintick), colDn, yloc.price)

// ============================================================
// Info table
// ============================================================
var table tbl = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(tbl, 0, 0, "IV source", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    table.cell(tbl, 1, 0, volMode + " (" + str.tostring(iv, "#.##") + "%)", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    table.cell(tbl, 0, 1, "Center", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(center, format.mintick), text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    table.cell(tbl, 0, 2, "1σ move", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    table.cell(tbl, 1, 2, "±" + str.tostring(sigma, format.mintick), text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    pct = na(sigma) or na(center) ? na : sigma / center * 100.0
    table.cell(tbl, 0, 3, "1σ %", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    table.cell(tbl, 1, 3, "±" + str.tostring(pct, "#.##") + "%", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
