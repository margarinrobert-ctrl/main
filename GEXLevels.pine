//@version=6
// OptionsFlow — GEX Levels (template)
//
// Canonical TradingView indicator. The website's "Pine" tab generates a FILLED-IN copy per ticker
// (levels baked in) — use the site for ready-to-paste code; this file just documents the structure.
//
// Snapshot of ~15-min delayed CBOE data. Labels are SHORT — hover any label for the full
// OI / Volume / GEX / DEX detail. Levels that sit close together auto-stagger to the right so they
// never overlap. ES/NQ use SPX/NDX cash options as a free proxy (futures trade at a small basis).
//
// APPLY ON THE MATCHING CHART: these are per-symbol price levels — QQQ's ~500 levels do NOT belong
// on an NQ ~30000 chart. The dotted gray "Spot" line marks the underlying when generated; the
// chart's live price may have drifted from it, so re-generate for a fresh snapshot.
//
// Named levels (MenthorQ-style):
//   Call Res / Call Res 0DTE  = strongest call-gamma strike ABOVE spot   — red  (0DTE dashed)
//   Put Sup  / Put Sup 0DTE   = strongest put-gamma strike BELOW spot    — green (0DTE dashed)
//   HVL                       = gamma flip / zero-gamma nearest spot      — blue
//   Max Pain                  = least option value at expiry             — yellow (dotted)
//   Call OI / Put OI          = strikes with the most open interest       — olive / purple (dotted)
//   1D Max/Min                = 1-day ±1σ expected range (ATM IV)         — orange (dotted)
//   GEX 1..N                  = top strikes by |net GEX|                  — teal
indicator("OptionsFlow GEX • Levels", overlay = true, max_lines_count = 200, max_labels_count = 200)

showMeta  = input.bool(true, "Detail on hover (tooltip)")
laneStep  = input.int(14, "Stagger close labels (bars)", minval = 0, maxval = 80)
labelSize = input.string("normal", "Label size", options = ["small", "normal", "large", "huge"])
sz = labelSize == "huge" ? size.huge : labelSize == "large" ? size.large : labelSize == "normal" ? size.normal : size.small
showVwap = input.bool(true, "Show session VWAP")
showOR   = input.bool(true, "Show opening range (intraday)")
orMin    = input.int(30, "Opening-range minutes", minval = 1, maxval = 240)

// ── Baked level snapshot (replace via the site's Pine tab) — example: SPY ──
var float[]  P  = array.from(525.0, 530.0, 536.0, 538.0, 541.0, 542.0, 545.0, 546.0, 550.0, 555.0, 560.0)
var string[] T  = array.from("Put OI 525", "Put Sup 530", "1D Min 536", "HVL 538", "Max Pain 541", "Spot 542", "GEX1 545", "1D Max 546", "Call Res 550", "Call OI 555", "GEX2 560")
var string[] D  = array.from("Put OI wall - OI 33.0k | V 39.0k | GEX -$1.6B | DEX -$0.4B", "Put Support - OI 24.0k | V 30.0k | GEX -$1.5B | DEX -$0.5B", "1-day -1 sigma expected move (ATM IV)", "HVL / gamma flip (zero-gamma nearest spot)", "Max Pain - OI 28.0k | V 35.0k | GEX $0.3B | DEX $0.1B", "Underlying spot when generated (CBOE 2026-06-16 15:45) - levels anchored here", "GEX 1 @545 - OI 18.0k | V 31.0k | $1.2B", "1-day +1 sigma expected move (ATM IV)", "Call Resistance - OI 26.0k | V 35.0k | GEX $1.8B | DEX $0.6B", "Call OI wall - OI 31.0k | V 42.0k | GEX $1.7B | DEX $0.5B", "GEX 2 @560 - OI 7.0k | V 8.0k | $0.4B")
var color[]  C  = array.from(color.purple, color.green, color.orange, color.blue, color.yellow, color.gray, color.teal, color.orange, color.red, color.olive, color.teal)
var string[] LS = array.from(line.style_dotted, line.style_solid, line.style_dotted, line.style_solid, line.style_dotted, line.style_dotted, line.style_solid, line.style_dotted, line.style_solid, line.style_dotted, line.style_solid)
var int[]    W  = array.from(1, 2, 1, 2, 1, 1, 1, 1, 2, 1, 1)

var line[]  _ln = array.new_line()
var label[] _lb = array.new_label()

clearAll() =>
    while array.size(_ln) > 0
        line.delete(array.pop(_ln))
    while array.size(_lb) > 0
        label.delete(array.pop(_lb))

if barstate.islast
    clearAll()
    rng = ta.highest(high, 120) - ta.lowest(low, 120)
    minGap = na(rng) or rng <= 0 ? close * 0.01 : rng * 0.022
    float prevP = na
    int lane = 0
    base = bar_index
    for i = 0 to array.size(P) - 1
        p = array.get(P, i)
        lane := not na(prevP) and (p - prevP) < minGap ? lane + 1 : 0
        x = base + 1 + lane * laneStep
        col = array.get(C, i)
        array.push(_ln, line.new(base, p, x, p, color = col, width = array.get(W, i), extend = extend.left, style = array.get(LS, i)))
        array.push(_lb, label.new(x, p, array.get(T, i), style = label.style_label_left, textcolor = col, color = color.new(color.black, 100), size = sz, tooltip = showMeta ? array.get(D, i) : ""))
        prevP := p

// ── Intraday confluence overlays (computed live by TradingView) ──
// A level that lines up with VWAP or the opening range is higher-conviction.
plot(showVwap ? ta.vwap : na, "VWAP", color = color.new(color.fuchsia, 0), linewidth = 2)
newDay = ta.change(time("D")) != 0
var float orH = na
var float orL = na
var int orStart = na
if newDay
    orH := high
    orL := low
    orStart := time
if not na(orStart) and time - orStart <= orMin * 60 * 1000
    orH := math.max(orH, high)
    orL := math.min(orL, low)
plot(showOR ? orH : na, "OR High", color = color.new(color.aqua, 0), style = plot.style_stepline)
plot(showOR ? orL : na, "OR Low", color = color.new(color.aqua, 0), style = plot.style_stepline)
