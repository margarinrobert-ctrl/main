// © superrobfps
// Combines: "50% level" (kijunkun / milly) + "IFVG Sniper Entry Engine" (trade_w_samet)
//
// STRATEGY IDEA
//   1. Track the daily session range and its 50% midline (the "50% level" indicator, kept as-is).
//   2. Detect IFVG (Inverted Fair Value Gap) formations with the IFVG Sniper engine.
//   3. When an IFVG forms, enter a trade. Risk/stop and target are sized from
//      50% of the daily candle range, and the take profit is placed 1:1 with the stop.
//   4. By default the trade follows the IFVG (continuation): a bullish IFVG+ => LONG,
//      a bearish IFVG- => SHORT. Can be flipped to "fade" (opposite) mode.
//   5. Confluence filters (trend-aware) to keep quality high and cut over-trading:
//        - 50% midline: follow longs in the upper half / shorts in the lower half.
//        - HTF liquidity sweep: longs after a 1H/4H swing-low sweep, shorts after a
//          1H/4H swing-high sweep (stop-hunt confluence).
//@version=6
strategy("IFVG 50% Daily-Range Fade [1:1 RR]", shorttitle="IFVG-50%-1R",
     overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=100,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     pyramiding=0, calc_on_order_fills=false, process_orders_on_close=true,
     initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.0)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📐 00. 50% DAILY-RANGE LEVEL  (from "50% level" by kijunkun / milly)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

group50 = "📐 00. 50% Daily Range"

daily_range = input.session("1600-1500", "Daily Range Session", group=group50)
showMidline = input.bool(true, "Show 50% Midline", group=group50)

t = time(timeframe.period, daily_range + ":1234567")
in_session = not na(t)
is_first = in_session and not in_session[1]

var float daily_high = na
var float daily_low = na

if is_first
    daily_high := high
    daily_low := low
else
    daily_high := daily_high[1]
    daily_low := daily_low[1]

if high > daily_high and in_session
    daily_high := high
if low < daily_low and in_session
    daily_low := low

// Daily range and 50% midline. Computed on every timeframe so the strategy can
// always size a stop / apply the midline filter (the source only *plotted* it on
// intraday <= 60m, which is preserved below via the plot gate).
bool intradayOk = timeframe.isintraday and timeframe.multiplier <= 60
float dailyRange = na(daily_high) or na(daily_low) ? na : daily_high - daily_low
float midline = na(dailyRange) ? na : daily_low + dailyRange / 2.0

plot(showMidline and intradayOk ? midline : na, title="50% midline", style=plot.style_line,
     linestyle=plot.linestyle_dotted, color=color.new(color.black, 25), linewidth=1)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🎯 01. STRATEGY MODEL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupTrade = "🎯 01. Strategy Model"

tradeBias = input.string("Follow IFVG (same)", "Trade Direction",
     options=["Fade IFVG (opposite)", "Follow IFVG (same)"], group=groupTrade,
     tooltip="Follow = bullish IFVG+ goes LONG, bearish IFVG- goes SHORT (continuation, default).\nFade = the opposite direction.")

riskPct = input.float(0.5, "Risk = % of Daily Range", minval=0.05, maxval=2.0, step=0.05,
     group=groupTrade, tooltip="Stop distance = this fraction of the current daily candle range. 0.5 = 50%.")

rrInput = input.float(1.0, "Reward : Risk", minval=0.25, maxval=10.0, step=0.25, group=groupTrade,
     tooltip="1.0 = the 1:1 you asked for. For a Follow (momentum) model, 2-3R is usually the single biggest profitability lever - try it.")

useMidlineFilter = input.bool(true, "Require 50% Midline Confluence", group=groupTrade,
     tooltip="Trend-aware. Follow: longs only in the upper half (above midline), shorts only below. Fade: the opposite. Keeps trades on the right side of the daily range.")

minRangeTicks = input.int(4, "Min Daily Range / Ticks", minval=0, group=groupTrade,
     tooltip="Skip signals when the developing daily range is too small to size a meaningful stop.")

allowReverse = input.bool(true, "Reverse on Opposite Signal", group=groupTrade,
     tooltip="If a new opposite IFVG fires while in a trade, close and flip.")


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 💧 02. HTF LIQUIDITY SWEEP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupSweep = "💧 02. HTF Liquidity Sweep"

useSweepFilter = input.bool(true, "Require HTF Liquidity Sweep", group=groupSweep,
     tooltip="Only allow longs after a swing-LOW sweep and shorts after a swing-HIGH sweep on the higher timeframes.")

sweepMode = input.string("Either 1H or 4H", "Sweep Source",
     options=["Either 1H or 4H", "Both 1H and 4H", "1H only", "4H only"], group=groupSweep)

htf1 = input.timeframe("60", "Swing Timeframe 1", group=groupSweep)
htf2 = input.timeframe("240", "Swing Timeframe 2", group=groupSweep)

pivotLeft = input.int(5, "Swing Pivot Left Bars", minval=1, group=groupSweep)
pivotRight = input.int(5, "Swing Pivot Right Bars", minval=1, group=groupSweep)

sweepValidBars = input.int(10, "Sweep Valid For N Bars", minval=1, group=groupSweep,
     tooltip="A sweep stays valid as confluence for this many chart bars after it prints.")

showSweeps = input.bool(true, "Mark Sweeps & HTF Levels", group=groupSweep)
sweepHighColor = input.color(color.new(color.orange, 30), "Swing High Color", group=groupSweep)
sweepLowColor = input.color(color.new(color.aqua, 30), "Swing Low Color", group=groupSweep)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ⚙️ 03. IFVG ENGINE  (from "IFVG Sniper Entry Engine" by trade_w_samet)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupIFVG = "⚙️ 03. IFVG Engine"

maxHiddenFVG = input.int(120, "Hidden FVG Memory", minval=10, maxval=500, group=groupIFVG)
maxFvgAge = input.int(60, "Max Hidden FVG Age", minval=5, maxval=500, group=groupIFVG)
minGapTicks = input.int(0, "Minimum FVG Size / Ticks", minval=0, group=groupIFVG)

filterMode = input.string("Balanced", "IFVG Filter Mode",
     options=["Off", "Loose", "Balanced", "Strict"], group=groupIFVG)

showIFVG = input.bool(true, "Plot IFVG Markers", group=groupIFVG)
bullIFVGColor = input.color(color.rgb(0, 120, 255), "Bullish IFVG+", group=groupIFVG)
bearIFVGColor = input.color(color.rgb(255, 60, 70), "Bearish IFVG-", group=groupIFVG)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CORE VALUES + FILTER HELPERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

atrValue = ta.atr(14)
safeAtr = na(atrValue) or atrValue <= 0.0 ? syminfo.mintick : atrValue

f_minGapAtr() =>
    filterMode == "Off" ? 0.0 : filterMode == "Loose" ? 0.15 : filterMode == "Strict" ? 0.40 : 0.25

f_minBodyRatio() =>
    filterMode == "Off" ? 0.0 : filterMode == "Loose" ? 0.40 : filterMode == "Strict" ? 0.60 : 0.50

f_minRangeAtr() =>
    filterMode == "Off" ? 0.0 : filterMode == "Loose" ? 0.40 : filterMode == "Strict" ? 0.85 : 0.60

f_breakBufferAtr() =>
    filterMode == "Off" ? 0.0 : filterMode == "Loose" ? 0.00 : filterMode == "Strict" ? 0.10 : 0.05

f_qualityPass(float _gapAtr, float _bodyRatio, float _rangeAtr) =>
    filterMode == "Off" or (_gapAtr >= f_minGapAtr() and _bodyRatio >= f_minBodyRatio() and _rangeAtr >= f_minRangeAtr())


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HIDDEN FVG MEMORY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var array<float> rawTops = array.new_float()
var array<float> rawBots = array.new_float()
var array<int>   rawDirs = array.new_int()
var array<int>   rawAges = array.new_int()
var array<float> rawGapAtr = array.new_float()
var array<float> rawBodyRatio = array.new_float()
var array<float> rawRangeAtr = array.new_float()


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// IFVG DETECTION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool newBullIFVG = false
bool newBearIFVG = false
float newConfirmClose = na
int newDir = 0

if barstate.isconfirmed
    // Age all stored FVGs and drop the expired ones.
    if array.size(rawAges) > 0
        for i = 0 to array.size(rawAges) - 1
            array.set(rawAges, i, array.get(rawAges, i) + 1)

        for j = array.size(rawAges) - 1 to 0
            if array.get(rawAges, j) > maxFvgAge
                array.remove(rawTops, j)
                array.remove(rawBots, j)
                array.remove(rawDirs, j)
                array.remove(rawAges, j)
                array.remove(rawGapAtr, j)
                array.remove(rawBodyRatio, j)
                array.remove(rawRangeAtr, j)

    float minGap = minGapTicks * syminfo.mintick
    float candleRange = math.max(high - low, syminfo.mintick)
    float bodyRatio = math.abs(close - open) / candleRange
    float rangeAtrRatio = candleRange / safeAtr

    bool rawBullFVG = not na(high[2]) and low > high[2] and (low - high[2]) >= minGap
    bool rawBearFVG = not na(low[2]) and high < low[2] and (low[2] - high) >= minGap

    if rawBullFVG
        array.push(rawTops, low)
        array.push(rawBots, high[2])
        array.push(rawDirs, 1)
        array.push(rawAges, 0)
        array.push(rawGapAtr, (low - high[2]) / safeAtr)
        array.push(rawBodyRatio, bodyRatio)
        array.push(rawRangeAtr, rangeAtrRatio)

    if rawBearFVG
        array.push(rawTops, low[2])
        array.push(rawBots, high)
        array.push(rawDirs, -1)
        array.push(rawAges, 0)
        array.push(rawGapAtr, (low[2] - high) / safeAtr)
        array.push(rawBodyRatio, bodyRatio)
        array.push(rawRangeAtr, rangeAtrRatio)

    while array.size(rawTops) > maxHiddenFVG
        array.shift(rawTops)
        array.shift(rawBots)
        array.shift(rawDirs)
        array.shift(rawAges)
        array.shift(rawGapAtr)
        array.shift(rawBodyRatio)
        array.shift(rawRangeAtr)

    // Detect the first valid inversion, newest first.
    if array.size(rawTops) > 0
        for j = array.size(rawTops) - 1 to 0
            float top = array.get(rawTops, j)
            float bot = array.get(rawBots, j)
            int dir = array.get(rawDirs, j)
            float cleanBreakBuffer = safeAtr * f_breakBufferAtr()

            bool bullishInversion = dir == -1 and close > top + cleanBreakBuffer
            bool bearishInversion = dir == 1 and close < bot - cleanBreakBuffer

            if bullishInversion or bearishInversion
                if f_qualityPass(array.get(rawGapAtr, j), array.get(rawBodyRatio, j), array.get(rawRangeAtr, j))
                    newBullIFVG := bullishInversion
                    newBearIFVG := bearishInversion
                    newConfirmClose := close
                    newDir := bullishInversion ? 1 : -1

                array.remove(rawTops, j)
                array.remove(rawBots, j)
                array.remove(rawDirs, j)
                array.remove(rawAges, j)
                array.remove(rawGapAtr, j)
                array.remove(rawBodyRatio, j)
                array.remove(rawRangeAtr, j)
                break


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 💧 HTF LIQUIDITY SWEEP DETECTION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Most recent confirmed swing high/low on each higher timeframe (no lookahead).
ph1 = request.security(syminfo.tickerid, htf1, ta.pivothigh(pivotLeft, pivotRight), lookahead=barmerge.lookahead_off)
pl1 = request.security(syminfo.tickerid, htf1, ta.pivotlow(pivotLeft, pivotRight), lookahead=barmerge.lookahead_off)
ph2 = request.security(syminfo.tickerid, htf2, ta.pivothigh(pivotLeft, pivotRight), lookahead=barmerge.lookahead_off)
pl2 = request.security(syminfo.tickerid, htf2, ta.pivotlow(pivotLeft, pivotRight), lookahead=barmerge.lookahead_off)

var float h1High = na
var float h1Low = na
var float h4High = na
var float h4Low = na

h1High := not na(ph1) ? ph1 : h1High
h1Low := not na(pl1) ? pl1 : h1Low
h4High := not na(ph2) ? ph2 : h4High
h4Low := not na(pl2) ? pl2 : h4Low

// A sweep = price wicks beyond the swing level and closes back on the other side.
f_bullSweep(float _lvl) => not na(_lvl) and low < _lvl and close > _lvl   // swept a swing LOW
f_bearSweep(float _lvl) => not na(_lvl) and high > _lvl and close < _lvl  // swept a swing HIGH

bool bull1 = f_bullSweep(h1Low)
bool bear1 = f_bearSweep(h1High)
bool bull4 = f_bullSweep(h4Low)
bool bear4 = f_bearSweep(h4High)

// A sweep stays valid as confluence for sweepValidBars chart bars.
f_active(bool _ev) =>
    int bs = ta.barssince(_ev)
    not na(bs) and bs <= sweepValidBars

bool bull1A = f_active(bull1)
bool bear1A = f_active(bear1)
bool bull4A = f_active(bull4)
bool bear4A = f_active(bear4)

bool bullSwept =
     sweepMode == "1H only" ? bull1A :
     sweepMode == "4H only" ? bull4A :
     sweepMode == "Both 1H and 4H" ? (bull1A and bull4A) :
     (bull1A or bull4A)

bool bearSwept =
     sweepMode == "1H only" ? bear1A :
     sweepMode == "4H only" ? bear4A :
     sweepMode == "Both 1H and 4H" ? (bear1A and bear4A) :
     (bear1A or bear4A)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🚀 04. SIGNAL -> ORDER LOGIC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool fade = tradeBias == "Fade IFVG (opposite)"
bool ifvgFired = newBullIFVG or newBearIFVG

// Trade direction: +1 long, -1 short. Fade inverts the IFVG direction.
int tradeDir = ifvgFired ? (fade ? -newDir : newDir) : 0

float entryPrice = newConfirmClose

// Stop distance: 50% of the daily candle range. Requires a valid developing daily
// range (intraday); no trade is taken until the range is established.
float rangeRisk = na(dailyRange) ? na : riskPct * dailyRange
bool rangeValid = not na(rangeRisk) and dailyRange > minRangeTicks * syminfo.mintick
float risk = rangeValid ? rangeRisk : na

// Validity guards.
bool rangeOk = not na(risk) and risk > 0

// Midline confluence (trend-aware). Follow: long in the upper half / short in the
// lower half. Fade: the opposite. Strict - a missing midline blocks the trade.
bool midlineSideOk = tradeDir == 1 ? (fade ? entryPrice < midline : entryPrice > midline) :
     (fade ? entryPrice > midline : entryPrice < midline)
bool midlineOk = not useMidlineFilter ? true : (not na(midline) and midlineSideOk)

// Sweep confluence: longs need a swing-low sweep, shorts need a swing-high sweep.
bool sweepOk = not useSweepFilter ? true : (tradeDir == 1 ? bullSwept : bearSwept)

bool takeLong = ifvgFired and tradeDir == 1 and rangeOk and midlineOk and sweepOk
bool takeShort = ifvgFired and tradeDir == -1 and rangeOk and midlineOk and sweepOk

float longSL = entryPrice - risk
float longTP = entryPrice + risk * rrInput
float shortSL = entryPrice + risk
float shortTP = entryPrice - risk * rrInput

if takeLong
    if allowReverse or strategy.position_size <= 0
        strategy.entry("Long", strategy.long)
        strategy.exit("Long-X", from_entry="Long", stop=longSL, limit=longTP)

if takeShort
    if allowReverse or strategy.position_size >= 0
        strategy.entry("Short", strategy.short)
        strategy.exit("Short-X", from_entry="Short", stop=shortSL, limit=shortTP)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🎨 05. VISUALS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// HTF swing levels (drawn only where defined).
plot(showSweeps ? h1High : na, "1H Swing High", color=sweepHighColor, style=plot.style_linebr, linewidth=1)
plot(showSweeps ? h1Low : na, "1H Swing Low", color=sweepLowColor, style=plot.style_linebr, linewidth=1)
plot(showSweeps ? h4High : na, "4H Swing High", color=sweepHighColor, style=plot.style_linebr, linewidth=2)
plot(showSweeps ? h4Low : na, "4H Swing Low", color=sweepLowColor, style=plot.style_linebr, linewidth=2)

// Sweep events.
plotshape(showSweeps and (bull1 or bull4), title="Bullish Sweep", style=shape.xcross,
     location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny)
plotshape(showSweeps and (bear1 or bear4), title="Bearish Sweep", style=shape.xcross,
     location=location.abovebar, color=color.new(color.fuchsia, 0), size=size.tiny)

plotshape(showIFVG and newBullIFVG, title="IFVG+", style=shape.triangleup,
     location=location.belowbar, color=bullIFVGColor, size=size.tiny, text="IFVG+")
plotshape(showIFVG and newBearIFVG, title="IFVG-", style=shape.triangledown,
     location=location.abovebar, color=bearIFVGColor, size=size.tiny, text="IFVG-")

plotshape(takeLong, title="Long Entry", style=shape.labelup, location=location.belowbar,
     color=color.new(color.green, 0), textcolor=color.white, text="L", size=size.small)
plotshape(takeShort, title="Short Entry", style=shape.labeldown, location=location.abovebar,
     color=color.new(color.red, 0), textcolor=color.white, text="S", size=size.small)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🔔 06. ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(takeLong, "Long Entry", "IFVG 50% Strategy | LONG on {{ticker}} {{interval}}")
alertcondition(takeShort, "Short Entry", "IFVG 50% Strategy | SHORT on {{ticker}} {{interval}}")
