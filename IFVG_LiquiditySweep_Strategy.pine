//@version=6
// =====================================================================================
//  IFVG + Liquidity Sweep Model (Dodgy DD / ICT) — STRATEGY (backtest)
//  Nasdaq-100 futures (NQ/MNQ) oriented, 1-minute execution timeframe.
//
//  Pure ICT / Smart-Money workflow from "Dodgy's Ultimate Trading Course" + the IFVG
//  guide (no moving-average filter):
//    1. Liquidity sweep  : purge a key level — Equal Highs/Lows (EQH/EQL), PDH/PDL or a
//                          swing high/low — and reject back through it (manipulation leg).
//    2. Displacement     : aggressive reversal candle (body >= ATR multiple).
//    3. FVG inversion    : an opposing FVG is closed through by a candle BODY -> IFVG
//                          (bullish FVG -> bearish IFVG, and vice-versa).
//    4. Entry            : at the inverted gap edge (retrace) or market on the close.
//
//  ICT context filters (replacing the EMA):
//    - Market-Structure Bias (BOS / MSS, body close)   -> directional context.
//    - SMT Divergence (NQ vs ES)                        -> genuine reversal confirmation.
//    - Killzones (NY AM / Lunch / PM, London) + Macros  -> ICT delivery windows.
//    - Singular-FVG (reject consecutive "double" FVGs).
//
//  Risk (per the course):
//    - Stop: swing high/low, OR preferred "close back through the IFVG" invalidation.
//    - Take-profit: fixed R:R to the opposing liquidity draw.
//    - Break-even: moved when the nearest Internal Trading High/Low (ITH/ITL) is taken.
//
//  Backtest results depend on the symbol, date range, session and fills you load.
//  The author himself notes inversions are best FORWARD-tested live; treat this as an
//  educational mechanical approximation. Not financial advice.
// =====================================================================================

strategy("IFVG + Liquidity Sweep Strategy | ICT", shorttitle="IFVG-ICT-Strat",
     overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500,
     max_bars_back=5000, pyramiding=0, calc_on_every_tick=false,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=100000, margin_long=5, margin_short=5,
     commission_type=strategy.commission.cash_per_order,
     commission_value=2.04, slippage=2)
// NOTE on futures: a strategy will NOT enter a position it cannot afford. Futures have a
// Point Value / contract multiplier (NQ = $20/pt, so 1 NQ at ~20000 ≈ $400k notional).
// With full margin that would need ~$400k of capital, so the tester would place ZERO
// trades ("This report requires trade data"). margin_long/short = 5 simulates ~5% futures
// leverage, giving 100000 / 0.05 = $2,000,000 of buying power so 1 NQ/MNQ contract is
// always affordable. Raise initial_capital or lower margin further if you size up.

// -------------------------------------------------------------------------------------
// Inputs — Model
// -------------------------------------------------------------------------------------
gFVG = "Fair Value Gap"
minGapTicks  = input.float(8.0,  "Min FVG size (ticks)", minval=0.0, step=1.0, group=gFVG)
fvgMaxAge    = input.int(60,     "Max FVG age (bars)", minval=5, group=gFVG)
showFVG      = input.bool(true,  "Draw FVG / IFVG boxes", group=gFVG)

gSweep = "Liquidity Sweep (ERL)"
useSweep     = input.bool(true,  "Require liquidity sweep before inversion", group=gSweep)
sweepLookback= input.int(20,     "Sweep look-back (bars)", minval=1, group=gSweep)
pivotLen     = input.int(8,      "Swing pivot strength", minval=1, group=gSweep)
usePDLevels  = input.bool(true,  "Use Previous Day High/Low as sweep levels", group=gSweep)
useEQ        = input.bool(true,  "Use Equal Highs/Lows (EQH/EQL) as sweep levels", group=gSweep)
eqTicks      = input.float(8.0,  "Equal H/L tolerance (ticks)", minval=0.0, step=1.0, group=gSweep)

gStruct = "Market Structure (ICT bias)"
useMSS       = input.bool(true,  "Use market-structure bias (BOS / MSS)", group=gStruct,
     tooltip="Only long while structure is bullish (close broke last swing high), only short while bearish. Replaces the moving-average filter.")

gSMT = "SMT Divergence"
useSMT       = input.bool(false, "Require SMT divergence with correlated asset", group=gSMT)
smtSym       = input.symbol("CME_MINI:ES1!", "Correlated symbol", group=gSMT)
smtLen       = input.int(10,     "SMT swing length", minval=2, group=gSMT)
smtLookback  = input.int(20,     "SMT validity (bars)", minval=1, group=gSMT)

gDisp = "Displacement"
useDisp      = input.bool(true,  "Require displacement on inversion candle", group=gDisp)
atrLen       = input.int(14,     "ATR length", minval=1, group=gDisp)
dispMult     = input.float(1.0,  "Min body size (x ATR)", minval=0.0, step=0.1, group=gDisp)

gTime = "Time — Killzones & Macros"
useTime      = input.bool(true,  "Restrict entries to killzones", group=gTime)
useNYam      = input.bool(true,  "NY AM 08:30-11:00", group=gTime)
useNYlunch   = input.bool(false, "NY Lunch 12:00-13:00", group=gTime)
useNYpm      = input.bool(true,  "NY PM 13:30-16:00", group=gTime)
useLondon    = input.bool(false, "London 02:00-05:00", group=gTime)
useMacro     = input.bool(false, "Also require an ICT macro window", group=gTime)
tzInfo       = input.string("America/New_York", "Killzone/Macro timezone", group=gTime,
     options=["America/New_York","Europe/London","Exchange","UTC"])

gFilt = "Quality Filters"
useDoubleFvg = input.bool(true,  "Reject consecutive (double) FVGs", group=gFilt)

// -------------------------------------------------------------------------------------
// Inputs — Execution & risk
// -------------------------------------------------------------------------------------
gExec = "Execution"
entryMode    = input.string("Market on close", "Entry mode", options=["Limit Retest","Market on close"], group=gExec,
     tooltip="Dodgy usually market-buys the close; switch to Limit Retest for better R:R when the close is far from the gap edge.")
limitExpiry  = input.int(6,      "Cancel unfilled limit after (bars)", minval=1, group=gExec)

gRisk = "Risk Management"
stopMode     = input.string("IFVG close", "Stop method", options=["IFVG close","Swing high/low"], group=gRisk,
     tooltip="IFVG close = preferred: invalidate if a candle closes back through the inverted gap. Swing = hard stop beyond the swept swing.")
rr           = input.float(2.0,  "Reward:Risk (TP)", minval=0.5, step=0.1, group=gRisk)
slLookback   = input.int(10,     "Swing look-back (bars)", minval=1, group=gRisk)
slBufTicks   = input.float(4.0,  "Stop buffer (ticks)", minval=0.0, step=1.0, group=gRisk)
useBE        = input.bool(true,  "Move stop to break-even on ITH/ITL", group=gRisk,
     tooltip="Per the course: move stop to BE once price takes the nearest internal trading high/low.")
flatEOD      = input.bool(true,  "Flatten at session end", group=gRisk)
eodSession   = input.session("0830-1600", "Trading session (flatten outside)", group=gRisk)

// -------------------------------------------------------------------------------------
// Core series
// -------------------------------------------------------------------------------------
minGap = minGapTicks * syminfo.mintick
atr    = ta.atr(atrLen)
tz     = tzInfo == "Exchange" ? syminfo.timezone : tzInfo

// Killzones
inNYam    = useNYam    and not na(time(timeframe.period, "0830-1100", tz))
inNYlunch = useNYlunch and not na(time(timeframe.period, "1200-1300", tz))
inNYpm    = useNYpm    and not na(time(timeframe.period, "1330-1600", tz))
inLondon  = useLondon  and not na(time(timeframe.period, "0200-0500", tz))
inKZ = inNYam or inNYlunch or inNYpm or inLondon

// ICT macro windows
mc1 = time(timeframe.period, "0830-0910", tz)
mc2 = time(timeframe.period, "0950-1010", tz)
mc3 = time(timeframe.period, "1050-1110", tz)
mc4 = time(timeframe.period, "1150-1210", tz)
mc5 = time(timeframe.period, "1310-1340", tz)
mc6 = time(timeframe.period, "1515-1545", tz)
inMacro = not na(mc1) or not na(mc2) or not na(mc3) or not na(mc4) or not na(mc5) or not na(mc6)
inTime  = (not useTime or inKZ) and (not useMacro or inMacro)
inEOD   = not na(time(timeframe.period, eodSession, tz))

// Swing pivots
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)
var float lastPH = na
var float lastPL = na
var float prevPH = na
var float prevPL = na
if not na(ph)
    prevPH := lastPH
    lastPH := ph
if not na(pl)
    prevPL := lastPL
    lastPL := pl

// Equal Highs / Equal Lows
eqTol = eqTicks * syminfo.mintick
eqhLevel = useEQ and not na(lastPH) and not na(prevPH) and math.abs(lastPH - prevPH) <= eqTol ? math.max(lastPH, prevPH) : na
eqlLevel = useEQ and not na(lastPL) and not na(prevPL) and math.abs(lastPL - prevPL) <= eqTol ? math.min(lastPL, prevPL) : na

// -------------------------------------------------------------------------------------
// Market structure bias (BOS / MSS, body close)
// -------------------------------------------------------------------------------------
var int bias = 0
if not na(lastPH) and close > lastPH
    bias := 1
if not na(lastPL) and close < lastPL
    bias := -1
biasLongOK  = not useMSS or bias >= 0
biasShortOK = not useMSS or bias <= 0

// Previous Day High / Low
pdh = usePDLevels ? request.security(syminfo.tickerid, "1D", high[1], lookahead=barmerge.lookahead_off) : na
pdl = usePDLevels ? request.security(syminfo.tickerid, "1D", low[1],  lookahead=barmerge.lookahead_off) : na

// -------------------------------------------------------------------------------------
// SMT divergence vs correlated asset
// -------------------------------------------------------------------------------------
corrHigh = request.security(smtSym, timeframe.period, high, lookahead=barmerge.lookahead_off)
corrLow  = request.security(smtSym, timeframe.period, low,  lookahead=barmerge.lookahead_off)
madeHH = high > ta.highest(high, smtLen)[1]
madeLL = low  < ta.lowest(low,  smtLen)[1]
corrHH = corrHigh > ta.highest(corrHigh, smtLen)[1]
corrLL = corrLow  < ta.lowest(corrLow,  smtLen)[1]
bearSMT = madeHH and not corrHH
bullSMT = madeLL and not corrLL
var int lastBearSMTBar = na
var int lastBullSMTBar = na
if bearSMT
    lastBearSMTBar := bar_index
if bullSMT
    lastBullSMTBar := bar_index
smtShortOK = not useSMT or (not na(lastBearSMTBar) and (bar_index - lastBearSMTBar) <= smtLookback)
smtLongOK  = not useSMT or (not na(lastBullSMTBar) and (bar_index - lastBullSMTBar) <= smtLookback)

// -------------------------------------------------------------------------------------
// Liquidity sweeps
// -------------------------------------------------------------------------------------
sweptHigh = (not na(lastPH)   and high > lastPH   and close < lastPH) or
             (not na(pdh)      and high > pdh      and close < pdh)    or
             (not na(eqhLevel) and high > eqhLevel and close < eqhLevel)
sweptLow  = (not na(lastPL)   and low  < lastPL   and close > lastPL) or
             (not na(pdl)      and low  < pdl      and close > pdl)    or
             (not na(eqlLevel) and low  < eqlLevel and close > eqlLevel)

// Track only the MOST RECENT sweep and its direction. A bullish inversion (long) must be
// preceded by a fresh, unconsumed sweep of a LOW; a bearish inversion (short) by a sweep
// of a HIGH. Using a single most-recent event (not two independent flags) prevents an
// unrelated opposite-side sweep from also validating the trade.
var int  lastSweepDir = 0    // +1 = swept a high (short context), -1 = swept a low (long context)
var int  lastSweepBar = na
var bool sweepUsed    = false
if sweptHigh
    lastSweepDir := 1
    lastSweepBar := bar_index
    sweepUsed := false
if sweptLow
    lastSweepDir := -1
    lastSweepBar := bar_index
    sweepUsed := false

sweepFresh   = not na(lastSweepBar) and (bar_index - lastSweepBar) <= sweepLookback and not sweepUsed
recentSweepHigh = sweepFresh and lastSweepDir == 1
recentSweepLow  = sweepFresh and lastSweepDir == -1

// -------------------------------------------------------------------------------------
// FVG detection
// -------------------------------------------------------------------------------------
isBullFVG = low > high[2] and (low - high[2]) >= minGap
isBearFVG = high < low[2] and (low[2] - high) >= minGap
bullTop = low
bullBot = high[2]
bearTop = low[2]
bearBot = high

var int lastBullFvgBar = na
var int lastBearFvgBar = na
blockBull = useDoubleFvg and not na(lastBullFvgBar) and (bar_index - lastBullFvgBar) <= 5
blockBear = useDoubleFvg and not na(lastBearFvgBar) and (bar_index - lastBearFvgBar) <= 5
if isBullFVG
    lastBullFvgBar := bar_index
if isBearFVG
    lastBearFvgBar := bar_index

// -------------------------------------------------------------------------------------
// FVG store
// -------------------------------------------------------------------------------------
var array<float> fTop  = array.new_float()
var array<float> fBot  = array.new_float()
var array<int>   fDir  = array.new_int()
var array<int>   fBar  = array.new_int()
var array<bool>  fInv  = array.new_bool()
var array<box>   fBoxA = array.new_box()

newFVG(float t, float b, int d) =>
    array.push(fTop, t)
    array.push(fBot, b)
    array.push(fDir, d)
    array.push(fBar, bar_index)
    array.push(fInv, false)
    box bx = na
    if showFVG
        bx := box.new(bar_index - 2, t, bar_index, b,
             border_color=color.new(color.gray, 70),
             bgcolor = d == 1 ? color.new(color.teal, 80) : color.new(color.red, 80))
    array.push(fBoxA, bx)

if isBullFVG and not blockBull
    newFVG(bullTop, bullBot, 1)
if isBearFVG and not blockBear
    newFVG(bearTop, bearBot, -1)

// -------------------------------------------------------------------------------------
// Inversion check + cleanup. We also capture the inverted gap edges for the IFVG-close stop.
// -------------------------------------------------------------------------------------
bullInversion = false
bearInversion = false
var float longEdge   = na   // top of inverted bearish gap (long entry / invalidation edge)
var float longGapBot = na
var float shortEdge  = na   // bottom of inverted bullish gap (short entry / invalidation edge)
var float shortGapTop = na

if array.size(fTop) > 0
    for i = array.size(fTop) - 1 to 0
        bx   = array.get(fBoxA, i)
        invd = array.get(fInv, i)
        d    = array.get(fDir, i)
        t    = array.get(fTop, i)
        b    = array.get(fBot, i)
        if not invd
            if d == 1 and close < b and not bearInversion
                array.set(fInv, i, true)
                bearInversion := true
                shortEdge := b
                shortGapTop := t
                if not na(bx)
                    box.set_bgcolor(bx, color.new(color.fuchsia, 60))
            else if d == -1 and close > t and not bullInversion
                array.set(fInv, i, true)
                bullInversion := true
                longEdge := t
                longGapBot := b
                if not na(bx)
                    box.set_bgcolor(bx, color.new(color.lime, 60))

if array.size(fTop) > 0
    for i = array.size(fTop) - 1 to 0
        if (bar_index - array.get(fBar, i)) > fvgMaxAge and not array.get(fInv, i)
            bx = array.get(fBoxA, i)
            if not na(bx)
                box.delete(bx)
            array.remove(fTop, i)
            array.remove(fBot, i)
            array.remove(fDir, i)
            array.remove(fBar, i)
            array.remove(fInv, i)
            array.remove(fBoxA, i)

// -------------------------------------------------------------------------------------
// Confluence gating -> signals
// -------------------------------------------------------------------------------------
strongBody = math.abs(close - open) >= dispMult * atr
dispOK     = not useDisp or strongBody
sweepLongOK  = not useSweep or recentSweepLow
sweepShortOK = not useSweep or recentSweepHigh

longSignal  = bullInversion and inTime and dispOK and biasLongOK  and sweepLongOK  and smtLongOK  and inEOD
shortSignal = bearInversion and inTime and dispOK and biasShortOK and sweepShortOK and smtShortOK and inEOD

// -------------------------------------------------------------------------------------
// Order management
// -------------------------------------------------------------------------------------
buf = slBufTicks * syminfo.mintick

var float pendStop  = na   // hard protective stop (always present as a safety net)
var float pendTP    = na
var float invEdge   = na   // the IFVG edge used for the "close back through" invalidation
var int   pendDir   = 0
var int   pendBar   = na
var bool  beDone    = false
var float ithLevel  = na   // internal high/low used for the BE trigger

flat = strategy.position_size == 0

// ---- Entries ----
if flat and (longSignal or shortSignal)
    isMarket = entryMode == "Market on close"
    if longSignal
        ref      = isMarket ? close : longEdge
        swingSL  = math.min(ta.lowest(low, slLookback), longGapBot) - buf
        hardSL   = stopMode == "Swing high/low" ? swingSL : longGapBot - buf
        risk     = ref - hardSL
        if risk > 0
            pendStop := hardSL
            pendTP   := ref + risk * rr
            invEdge  := longGapBot
            pendDir  := 1
            pendBar  := bar_index
            beDone   := false
            ithLevel := ta.highest(high, slLookback)
            sweepUsed := true
            if isMarket
                strategy.entry("Long", strategy.long)
            else
                strategy.entry("Long", strategy.long, limit=ref)
    else if shortSignal
        ref      = isMarket ? close : shortEdge
        swingSL  = math.max(ta.highest(high, slLookback), shortGapTop) + buf
        hardSL   = stopMode == "Swing high/low" ? swingSL : shortGapTop + buf
        risk     = hardSL - ref
        if risk > 0
            pendStop := hardSL
            pendTP   := ref - risk * rr
            invEdge  := shortGapTop
            pendDir  := -1
            pendBar  := bar_index
            beDone   := false
            ithLevel := ta.lowest(low, slLookback)
            sweepUsed := true
            if isMarket
                strategy.entry("Short", strategy.short)
            else
                strategy.entry("Short", strategy.short, limit=ref)

// ---- Cancel stale / pre-empted limit orders (premature liquidity take) ----
if flat and not na(pendBar)
    expired   = (bar_index - pendBar) >= limitExpiry
    preTakenL = pendDir == 1  and high >= pendTP   // target hit before fill -> objective met
    preTakenS = pendDir == -1 and low  <= pendTP
    if expired or preTakenL or preTakenS
        strategy.cancel("Long")
        strategy.cancel("Short")
        pendBar := na

// ---- Manage open position ----
if strategy.position_size > 0
    entryP = strategy.position_avg_price
    // BE when the internal high is taken
    if useBE and not beDone and not na(ithLevel) and high > ithLevel
        beDone := true
    stopL = beDone ? math.max(pendStop, entryP) : pendStop
    strategy.exit("L-exit", from_entry="Long", stop=stopL, limit=pendTP)
    // Preferred invalidation: candle closes back below the inverted gap
    if stopMode == "IFVG close" and not na(invEdge) and close < invEdge
        strategy.close("Long", comment="IFVG invalidated")

if strategy.position_size < 0
    entryP = strategy.position_avg_price
    if useBE and not beDone and not na(ithLevel) and low < ithLevel
        beDone := true
    stopL = beDone ? math.min(pendStop, entryP) : pendStop
    strategy.exit("S-exit", from_entry="Short", stop=stopL, limit=pendTP)
    if stopMode == "IFVG close" and not na(invEdge) and close > invEdge
        strategy.close("Short", comment="IFVG invalidated")

// ---- End-of-session flatten ----
if flatEOD and not inEOD and strategy.position_size != 0
    strategy.close_all(comment="EOD flat")
    strategy.cancel_all()

// -------------------------------------------------------------------------------------
// Visuals
// -------------------------------------------------------------------------------------
plot(usePDLevels ? pdh : na, "PDH", color=color.new(color.gray, 40), style=plot.style_stepline)
plot(usePDLevels ? pdl : na, "PDL", color=color.new(color.gray, 40), style=plot.style_stepline)
plot(eqhLevel, "EQH", color=color.new(color.orange, 20), style=plot.style_circles, linewidth=1)
plot(eqlLevel, "EQL", color=color.new(color.aqua, 20),   style=plot.style_circles, linewidth=1)
plotshape(longSignal,  title="Long sig",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0),    size=size.tiny)
plotshape(shortSignal, title="Short sig", style=shape.triangledown, location=location.abovebar, color=color.new(color.fuchsia, 0), size=size.tiny)
bgcolor(useMSS and bias == 1 ? color.new(color.green, 94) : useMSS and bias == -1 ? color.new(color.red, 94) : na, title="Structure bias tint")
