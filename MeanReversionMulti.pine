//@version=6
indicator("Mean Reversion Pro (VWAP+Profile+RSI+ADX+ATR+CVD)", shorttitle="MR-Pro",
     overlay=true, max_bars_back=5000, max_labels_count=500, max_lines_count=500)

// ============================================================
// Inputs
// ============================================================
gSes   = "Session"
sessStr = input.session("0930-1600", "RTH Session (exchange time)", group=gSes)
useSess = input.bool(true, "Restrict VWAP/Profile to Session", group=gSes)

gMean  = "VWAP + Std Dev Bands"
showVWAP = input.bool(true,  "Show VWAP", group=gMean)
showSD1  = input.bool(false, "Show +/-1sd",  group=gMean)
showSD2  = input.bool(true,  "Show +/-2sd",  group=gMean)
showSD3  = input.bool(false, "Show +/-3sd",  group=gMean)

gBB    = "Bollinger Bands"
showBB = input.bool(false, "Show Bollinger Bands", group=gBB)
bbLen  = input.int(20,    "BB Length",  minval=2, group=gBB)
bbMult = input.float(2.0, "BB StDev",   step=0.1, group=gBB)

gZ     = "Z-Score"
zLen   = input.int(20,   "Z-Score Length", minval=2, group=gZ)
zEntry = input.float(2.0,"Z Entry Threshold", step=0.1, group=gZ)

gProf  = "Session Volume Profile"
showProf = input.bool(true, "Plot POC / VAH / VAL", group=gProf)
profBins = input.int(50,    "Profile Bins", minval=10, maxval=200, group=gProf)
vaPct    = input.float(0.70,"Value Area %", minval=0.50, maxval=0.95, step=0.05, group=gProf)

gRSI   = "RSI / Stoch RSI"
rsiLen = input.int(14, "RSI Length",   minval=2, group=gRSI)
rsiOB  = input.int(70, "RSI Overbought",         group=gRSI)
rsiOS  = input.int(30, "RSI Oversold",           group=gRSI)
stLen  = input.int(14, "Stoch RSI Length",       group=gRSI)
stK    = input.int(3,  "%K Smoothing",  minval=1,group=gRSI)
stD    = input.int(3,  "%D Smoothing",  minval=1,group=gRSI)
stOB   = input.int(80, "Stoch OB",               group=gRSI)
stOS   = input.int(20, "Stoch OS",               group=gRSI)

gADX   = "ADX"
adxLen = input.int(14,   "ADX Length", minval=2, group=gADX)
adxLow = input.float(20, "ADX Range Threshold (<=)", group=gADX)
adxHi  = input.float(25, "ADX Trend Threshold (>=)", group=gADX)

gATR   = "ATR / Risk"
atrLen = input.int(14,    "ATR Length", minval=2, group=gATR)
atrBuf = input.float(0.5, "Stop Buffer (x ATR)", step=0.1, group=gATR)
minR   = input.float(1.2, "Min Reward:Risk", step=0.1, group=gATR)

gCVD   = "CVD Divergence"
cvdPiv = input.int(5, "CVD/RSI Pivot Length", minval=2, group=gCVD)
divHold= input.int(5, "Divergence Hold Bars",  minval=1, group=gCVD)

gSig   = "Signals"
minGrade = input.string("A", "Minimum Grade to Signal", options=["A++","A+","A","B"], group=gSig)
showLabels = input.bool(true, "Show Trade Labels (entry/stop/target)", group=gSig)

// ============================================================
// Session detection
// ============================================================
inSess  = not na(time(timeframe.period, sessStr))
newSess = inSess and not inSess[1]

// ============================================================
// Anchored VWAP + std dev bands
// ============================================================
var float cumPV  = 0.0
var float cumPPV = 0.0
var float cumV   = 0.0

resetCum = useSess ? newSess : false
if resetCum
    cumPV  := 0.0
    cumPPV := 0.0
    cumV   := 0.0

src = hlc3
accum = useSess ? inSess : true
if accum
    cumPV  += src * volume
    cumPPV += src * src * volume
    cumV   += volume

vwap = cumV > 0 ? cumPV / cumV : na
variance = cumV > 0 ? math.max(cumPPV / cumV - vwap * vwap, 0.0) : 0.0
sd = math.sqrt(variance)

vwUp1 = vwap + sd
vwDn1 = vwap - sd
vwUp2 = vwap + 2 * sd
vwDn2 = vwap - 2 * sd
vwUp3 = vwap + 3 * sd
vwDn3 = vwap - 3 * sd

vwapSlope    = vwap - vwap[5]
vwapSlopeATR = ta.atr(atrLen) != 0 ? vwapSlope / ta.atr(atrLen) : 0.0

// ============================================================
// Bollinger Bands
// ============================================================
bbBasis = ta.sma(close, bbLen)
bbDev   = ta.stdev(close, bbLen)
bbUp    = bbBasis + bbMult * bbDev
bbDn    = bbBasis - bbMult * bbDev

// ============================================================
// Z-Score
// ============================================================
zMean   = ta.sma(close, zLen)
zSD     = ta.stdev(close, zLen)
zScore  = zSD != 0 ? (close - zMean) / zSD : 0.0

// ============================================================
// RSI + Stoch RSI
// ============================================================
rsi    = ta.rsi(close, rsiLen)
stRsi  = ta.stoch(rsi, rsi, rsi, stLen)
stochK = ta.sma(stRsi, stK)
stochD = ta.sma(stochK, stD)

// ============================================================
// ADX
// ============================================================
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

// ============================================================
// ATR
// ============================================================
atrVal = ta.atr(atrLen)

// ============================================================
// Session Volume Profile (developing)
// ============================================================
var float[] vp  = array.new_float(profBins, 0.0)
var float   sHi = na
var float   sLo = na

if newSess
    array.fill(vp, 0.0)
    sHi := high
    sLo := low
else if inSess
    sHi := math.max(nz(sHi, high), high)
    sLo := math.min(nz(sLo, low),  low)

if inSess and not na(sHi) and not na(sLo) and sHi > sLo
    binSize0 = (sHi - sLo) / profBins
    if binSize0 > 0
        idx0 = math.floor((hlc3 - sLo) / binSize0)
        idx0 := math.max(0, math.min(profBins - 1, idx0))
        array.set(vp, idx0, array.get(vp, idx0) + volume)

var float poc = na
var float vah = na
var float val = na

if inSess and not na(sHi) and not na(sLo) and sHi > sLo
    binSize = (sHi - sLo) / profBins
    maxVol  = 0.0
    pocIdx  = 0
    total   = 0.0
    for i = 0 to profBins - 1
        v = array.get(vp, i)
        total += v
        if v > maxVol
            maxVol := v
            pocIdx := i
    poc := sLo + (pocIdx + 0.5) * binSize

    target = total * vaPct
    accumV = array.get(vp, pocIdx)
    up = pocIdx
    dn = pocIdx
    while accumV < target and (up < profBins - 1 or dn > 0)
        upV = up < profBins - 1 ? array.get(vp, up + 1) : -1.0
        dnV = dn > 0             ? array.get(vp, dn - 1) : -1.0
        if upV >= dnV and up < profBins - 1
            up := up + 1
            accumV += array.get(vp, up)
        else if dn > 0
            dn := dn - 1
            accumV += array.get(vp, dn)
        else
            break
    vah := sLo + (up + 1) * binSize
    val := sLo + dn * binSize

// ============================================================
// CVD (intrabar delta approximation) with session reset
// ============================================================
rng   = high - low
delta = rng > 0 ? volume * ((close - low) - (high - close)) / rng : 0.0
var float cvd = 0.0
cvd := newSess ? delta : nz(cvd[1]) + delta

// ============================================================
// Divergences (price vs RSI and CVD)
// ============================================================
ph = ta.pivothigh(high, cvdPiv, cvdPiv)
pl = ta.pivotlow(low,  cvdPiv, cvdPiv)

var float lastPH = na
var float lastPHrsi = na
var float lastPHcvd = na
var float lastPL = na
var float lastPLrsi = na
var float lastPLcvd = na

bullDivRSI = false
bullDivCVD = false
bearDivRSI = false
bearDivCVD = false

if not na(pl)
    plRsi = rsi[cvdPiv]
    plCvd = cvd[cvdPiv]
    if not na(lastPL)
        if pl < lastPL and plRsi > lastPLrsi
            bullDivRSI := true
        if pl < lastPL and plCvd > lastPLcvd
            bullDivCVD := true
    lastPL    := pl
    lastPLrsi := plRsi
    lastPLcvd := plCvd

if not na(ph)
    phRsi = rsi[cvdPiv]
    phCvd = cvd[cvdPiv]
    if not na(lastPH)
        if ph > lastPH and phRsi < lastPHrsi
            bearDivRSI := true
        if ph > lastPH and phCvd < lastPHcvd
            bearDivCVD := true
    lastPH    := ph
    lastPHrsi := phRsi
    lastPHcvd := phCvd

bullDiv = bullDivRSI or bullDivCVD
bearDiv = bearDivRSI or bearDivCVD

var int bullDivBar = na
var int bearDivBar = na
if bullDiv
    bullDivBar := bar_index
if bearDiv
    bearDivBar := bar_index

bullDivActive = not na(bullDivBar) and (bar_index - bullDivBar) <= divHold
bearDivActive = not na(bearDivBar) and (bar_index - bearDivBar) <= divHold

// ============================================================
// Rejection wicks
// ============================================================
bodyAbs   = math.abs(close - open)
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
bullRej   = bodyAbs > 0 and lowerWick > bodyAbs * 1.5 and close > open
bearRej   = bodyAbs > 0 and upperWick > bodyAbs * 1.5 and close < open

// ============================================================
// Scoring model (0-100)  per PDF section 5.4
// ============================================================

// --- Location (0-25) ---
longLoc  = 0.0
shortLoc = 0.0
if not na(vwDn2) and close <= vwDn2
    longLoc += 10
if close <= bbDn
    longLoc += 8
if not na(val) and close < val
    longLoc += 7
if math.abs(zScore) >= zEntry and zScore <= 0
    longLoc += 3
longLoc := math.min(25.0, longLoc)

if not na(vwUp2) and close >= vwUp2
    shortLoc += 10
if close >= bbUp
    shortLoc += 8
if not na(vah) and close > vah
    shortLoc += 7
if math.abs(zScore) >= zEntry and zScore >= 0
    shortLoc += 3
shortLoc := math.min(25.0, shortLoc)

// --- Regime (0-25) ---
regimeBase = adx <= adxLow ? 25.0 : adx <= adxHi ? 18.0 : adx <= adxHi + 5 ? 8.0 : 0.0
if math.abs(vwapSlopeATR) > 0.5
    regimeBase := regimeBase * 0.5
regimeScore = math.max(0.0, math.min(25.0, regimeBase))

// --- Exhaustion (0-20) ---
longExh  = 0.0
shortExh = 0.0
if rsi <= rsiOS
    longExh += 8
if stochK <= stOS and ta.crossover(stochK, stochD)
    longExh += 4
if bullDivActive
    longExh += 6
if bullRej
    longExh += 4
longExh := math.min(20.0, longExh)

if rsi >= rsiOB
    shortExh += 8
if stochK >= stOB and ta.crossunder(stochK, stochD)
    shortExh += 4
if bearDivActive
    shortExh += 6
if bearRej
    shortExh += 4
shortExh := math.min(20.0, shortExh)

// --- Reclaim / failure (0-20) ---
longRec  = 0.0
shortRec = 0.0

belowBBnow  = low  < bbDn
belowBBprev = low[1] < bbDn[1]
reclaimBB_L = (belowBBprev or belowBBnow) and close > bbDn
if reclaimBB_L
    longRec += 8

belowVALnow  = not na(val) and low  < val
belowVALprev = not na(val[1]) and low[1] < val[1]
reclaimVAL = (belowVALprev or belowVALnow) and not na(val) and close > val
if reclaimVAL
    longRec += 8

belowSD2 = not na(vwDn2) and low < vwDn2
reclaimSD2_L = belowSD2 and not na(vwDn2) and close > vwDn2
if reclaimSD2_L
    longRec += 4

longRec := math.min(20.0, longRec)

aboveBBnow  = high  > bbUp
aboveBBprev = high[1] > bbUp[1]
reclaimBB_S = (aboveBBprev or aboveBBnow) and close < bbUp
if reclaimBB_S
    shortRec += 8

aboveVAHnow  = not na(vah) and high  > vah
aboveVAHprev = not na(vah[1]) and high[1] > vah[1]
reclaimVAH = (aboveVAHprev or aboveVAHnow) and not na(vah) and close < vah
if reclaimVAH
    shortRec += 8

aboveSD2 = not na(vwUp2) and high > vwUp2
reclaimSD2_S = aboveSD2 and not na(vwUp2) and close < vwUp2
if reclaimSD2_S
    shortRec += 4

shortRec := math.min(20.0, shortRec)

// --- Risk-to-target (0-10) ---
longStop   = low  - atrVal * atrBuf
shortStop  = high + atrVal * atrBuf
longTarget = not na(vwap) ? vwap : bbBasis
shortTarget= not na(vwap) ? vwap : bbBasis

longRisk    = close - longStop
longReward  = longTarget - close
longR       = longRisk > 0 ? longReward / longRisk : 0.0
shortRisk   = shortStop - close
shortReward = close - shortTarget
shortR      = shortRisk > 0 ? shortReward / shortRisk : 0.0

longRT  = longR  >= 1.5 ? 10.0 : longR  >= minR ? 7.0 : longR  >= 1.0 ? 4.0 : 0.0
shortRT = shortR >= 1.5 ? 10.0 : shortR >= minR ? 7.0 : shortR >= 1.0 ? 4.0 : 0.0

// --- Totals & Grade ---
longScore  = longLoc  + regimeScore + longExh  + longRec  + longRT
shortScore = shortLoc + regimeScore + shortExh + shortRec + shortRT

f_grade(s) =>
    s >= 90 ? "A++" : s >= 80 ? "A+" : s >= 70 ? "A" : s >= 60 ? "B" : ""
f_rank(g) =>
    g == "A++" ? 4 : g == "A+" ? 3 : g == "A" ? 2 : g == "B" ? 1 : 0

gradeLong  = f_grade(longScore)
gradeShort = f_grade(shortScore)
minRank    = f_rank(minGrade)

longSignal  = f_rank(gradeLong)  >= minRank and longRec  > 0 and longR  >= minR and bullDivActive
shortSignal = f_rank(gradeShort) >= minRank and shortRec > 0 and shortR >= minR and bearDivActive

// ============================================================
// Plots
// ============================================================
plot(showVWAP ? vwap  : na, "VWAP", color=color.new(color.orange, 20), linewidth=2)
plot(showSD1  ? vwUp1 : na, "+1sd", color=color.new(color.aqua,    80))
plot(showSD1  ? vwDn1 : na, "-1sd", color=color.new(color.aqua,    80))
p2u = plot(showSD2 ? vwUp2 : na, "+2sd", color=color.new(color.yellow, 60))
p2d = plot(showSD2 ? vwDn2 : na, "-2sd", color=color.new(color.yellow, 60))
fill(p2u, p2d, color=color.new(color.yellow, 96), title="VWAP +/-2sd Range")
plot(showSD3 ? vwUp3 : na, "+3sd", color=color.new(color.red, 70))
plot(showSD3 ? vwDn3 : na, "-3sd", color=color.new(color.red, 70))

plot(showBB ? bbBasis : na, "BB Basis", color=color.new(color.gray, 70))
plot(showBB ? bbUp    : na, "BB Upper", color=color.new(color.gray, 50))
plot(showBB ? bbDn    : na, "BB Lower", color=color.new(color.gray, 50))

plot(showProf ? poc : na, "POC", color=color.new(color.fuchsia, 20), style=plot.style_linebr, linewidth=2)
plot(showProf ? vah : na, "VAH", color=color.new(color.lime,    50), style=plot.style_linebr)
plot(showProf ? val : na, "VAL", color=color.new(color.red,     50), style=plot.style_linebr)

bgcolor(close > vwUp2 ? color.new(color.red, 96) : close < vwDn2 ? color.new(color.lime, 96) : na, title="Stretch Zone")

plotshape(bullDivRSI or bullDivCVD, "Bull Div", style=shape.circle, location=location.belowbar, color=color.new(color.aqua,    0), size=size.tiny, offset=-cvdPiv)
plotshape(bearDivRSI or bearDivCVD, "Bear Div", style=shape.circle, location=location.abovebar, color=color.new(color.fuchsia, 0), size=size.tiny, offset=-cvdPiv)

if showLabels and longSignal and gradeLong != ""
    label.new(bar_index - cvdPiv, low[cvdPiv], gradeLong, color=color.new(color.lime, 20), textcolor=color.black, style=label.style_label_up, size=size.small)
if showLabels and shortSignal and gradeShort != ""
    label.new(bar_index - cvdPiv, high[cvdPiv], gradeShort, color=color.new(color.red, 20), textcolor=color.white, style=label.style_label_down, size=size.small)

// ============================================================
// Dashboard
// ============================================================
var table dash = table.new(position.top_right, 2, 12, border_width=1, frame_color=color.gray, frame_width=1)
if barstate.islast
    table.cell(dash, 0, 0,  "MR-Pro",       bgcolor=color.new(color.navy, 0), text_color=color.white)
    table.cell(dash, 1, 0,  "Value",        bgcolor=color.new(color.navy, 0), text_color=color.white)
    table.cell(dash, 0, 1,  "VWAP")
    table.cell(dash, 1, 1,  na(vwap) ? "-" : str.tostring(vwap, format.mintick))
    table.cell(dash, 0, 2,  "Z-Score")
    table.cell(dash, 1, 2,  str.tostring(zScore, "#.##"),
         text_color = math.abs(zScore) >= zEntry ? color.yellow : color.white)
    table.cell(dash, 0, 3,  "RSI")
    table.cell(dash, 1, 3,  str.tostring(rsi, "#.#"),
         text_color = rsi >= rsiOB ? color.red : rsi <= rsiOS ? color.lime : color.white)
    table.cell(dash, 0, 4,  "Stoch %K")
    table.cell(dash, 1, 4,  str.tostring(stochK, "#.#"),
         text_color = stochK >= stOB ? color.red : stochK <= stOS ? color.lime : color.white)
    table.cell(dash, 0, 5,  "ADX")
    table.cell(dash, 1, 5,  str.tostring(adx, "#.#"),
         text_color = adx >= adxHi ? color.red : adx <= adxLow ? color.lime : color.white)
    table.cell(dash, 0, 6,  "ATR")
    table.cell(dash, 1, 6,  str.tostring(atrVal, format.mintick))
    table.cell(dash, 0, 7,  "VWAP slope")
    table.cell(dash, 1, 7,  str.tostring(vwapSlopeATR, "#.##") + " ATR/5",
         text_color = math.abs(vwapSlopeATR) > 0.5 ? color.red : color.white)
    table.cell(dash, 0, 8,  "POC / VAH / VAL")
    pocStr = na(poc) ? "-" : str.tostring(poc, format.mintick)
    vahStr = na(vah) ? "-" : str.tostring(vah, format.mintick)
    valStr = na(val) ? "-" : str.tostring(val, format.mintick)
    table.cell(dash, 1, 8, pocStr + " / " + vahStr + " / " + valStr)
    table.cell(dash, 0, 9,  "CVD")
    table.cell(dash, 1, 9,  str.tostring(cvd, "#"),
         text_color = cvd >= 0 ? color.lime : color.red)
    table.cell(dash, 0, 10, "Long Score")
    table.cell(dash, 1, 10, str.tostring(longScore, "#") + (gradeLong  == "" ? "" : "  " + gradeLong),
         text_color = f_rank(gradeLong) >= 2 ? color.lime : color.white)
    table.cell(dash, 0, 11, "Short Score")
    table.cell(dash, 1, 11, str.tostring(shortScore, "#") + (gradeShort == "" ? "" : "  " + gradeShort),
         text_color = f_rank(gradeShort) >= 2 ? color.red : color.white)

// ============================================================
// Alerts (global scope)
// ============================================================
alertcondition(longSignal,  title="MR-Pro LONG",  message="MR-Pro LONG signal -see chart for grade/stop/target")
alertcondition(shortSignal, title="MR-Pro SHORT", message="MR-Pro SHORT signal -see chart for grade/stop/target")
alertcondition(bullDivRSI,  title="RSI Bullish Divergence", message="RSI bullish divergence")
alertcondition(bearDivRSI,  title="RSI Bearish Divergence", message="RSI bearish divergence")
alertcondition(bullDivCVD,  title="CVD Bullish Divergence", message="CVD bullish divergence")
alertcondition(bearDivCVD,  title="CVD Bearish Divergence", message="CVD bearish divergence")
alertcondition(close < vwDn2, title="Below VWAP -2sd", message="Price below VWAP -2sd (long watch zone)")
alertcondition(close > vwUp2, title="Above VWAP +2sd", message="Price above VWAP +2sd (short watch zone)")
