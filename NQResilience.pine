//@version=6
// NQ100 Resilience — a stress / recovery oscillator for the Nasdaq-100 (or any symbol)
//
// WHAT IT MEASURES
// "Resilience" = how well price is holding up and how fast it repairs, scored on a -100…+100 scale:
//      +100  pinned at range highs, no drawdown, riding well above its baseline  → fully resilient
//         0  neutral / mid-range
//      -100  pinned at range lows, deep drawdown from the recent peak, far below baseline → broken
// Calm, grinding-up tape sits near or above 0; a selloff drags it sharply negative and it climbs back
// as price repairs — so the line PLUNGES in stress and RECOVERS as the market heals.
//
// THREE HORIZONS (the three plotted lines / the three numbers in the readout)
//      Fast  – short window: first to break, first to recover                (white)
//      Med   – swing window                                                  (orange)
//      Slow  – regime window: the slow "is this still healthy?" gauge        (cyan)
// Fast turning up while Slow is still deep = an early repair is underway (the classic V-bottom tell).
//
// COMPONENTS (each normalized to -100…+100, then blended by weight)
//      • Range position  – where price sits inside its N-bar high/low range
//      • Drawdown        – % below the rolling N-bar peak vs a "full-stress" reference depth
//      • Trend hold      – distance above / below the N-bar baseline, measured in volatility units
//
// RELATIVE MODE (optional) scores resilience of price / benchmark (e.g. NQ vs SPX) — i.e. "is the
// Nasdaq holding up BETTER than the broad market?" — instead of on absolute price.
//
// Self-contained (no external feed), non-repainting (confirmed series), runs on any symbol/timeframe.
indicator(title = "NQ100 Resilience", shorttitle = "NQ Resil", overlay = false, max_bars_back = 1000)

// ============================================================
// Inputs
// ============================================================
gH = "Horizons (lookback in bars)"
fastLen = input.int(20,  "Fast",            minval = 2, group = gH)
medLen  = input.int(50,  "Medium",          minval = 2, group = gH)
slowLen = input.int(100, "Slow",            minval = 2, group = gH)
smooth  = input.int(3,   "Smoothing (EMA)", minval = 1, maxval = 50, group = gH)

gM = "Model"
refDD   = input.float(10.0, "Full-stress drawdown (%)",  minval = 1.0, step = 0.5, group = gM,
     tooltip = "Drawdown from the rolling peak that scores as fully 'broken' (-100 on the drawdown term).")
volMult = input.float(2.0,  "Trend band (x volatility)", minval = 0.5, step = 0.5, group = gM,
     tooltip = "Std-devs above/below baseline that score as fully resilient/broken on the trend term.")
wPos    = input.float(0.40, "Weight · range position", minval = 0, step = 0.05, group = gM)
wDD     = input.float(0.35, "Weight · drawdown",       minval = 0, step = 0.05, group = gM)
wTrend  = input.float(0.25, "Weight · trend hold",     minval = 0, step = 0.05, group = gM)

gR = "Relative mode"
useRel   = input.bool(false,    "Score vs benchmark (relative resilience)", group = gR)
benchSym = input.symbol("SP:SPX", "Benchmark", group = gR)

gB = "Bands & levels"
strongLvl  = input.float( 50, "Strong level",  group = gB)
fragileLvl = input.float(-50, "Fragile level", group = gB)
brokenLvl  = input.float(-80, "Broken level",  group = gB)
stressBg   = input.bool(true, "Shade background in stress (Slow < Fragile)", group = gB)
showFill   = input.bool(true, "Shade Fast↔Slow term-structure gap",          group = gB)

gC = "Colors"
colFast = input.color(color.white, "Fast", group = gC)
colMed  = input.color(#ffa726,     "Med",  group = gC)
colSlow = input.color(#26c6da,     "Slow", group = gC)

gT = "Readout table"
showTable = input.bool(true, "Show table", group = gT)
tblPos    = input.string("Top Right", "Position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = gT)

// ============================================================
// Source — absolute price, or price / benchmark in relative mode
// ============================================================
benchClose = request.security(benchSym, timeframe.period, close)
src = useRel and not na(benchClose) and benchClose > 0 ? close / benchClose : close

// ============================================================
// Resilience model  →  -100 … +100
// ============================================================
wSum = math.max(wPos + wDD + wTrend, 1e-9)

f_resilience(float _src, simple int _len) =>
    hi  = ta.highest(_src, _len)
    lo  = ta.lowest(_src, _len)
    rng = hi - lo
    // 1) range position: bottom of range → -100, top → +100
    stoch   = rng > 0 ? (_src - lo) / rng : 0.5
    posTerm = (stoch * 2 - 1) * 100
    // 2) drawdown from the rolling peak, vs the full-stress reference depth
    ddPct   = hi > 0 ? (_src / hi - 1) * 100 : 0.0
    ddTerm  = math.max(math.min(1 + 2 * ddPct / refDD, 1.0), -1.0) * 100
    // 3) trend hold: distance above/below the baseline, in volatility units
    vol     = ta.stdev(_src, _len)
    dev     = vol > 0 ? (_src - ta.sma(_src, _len)) / (vol * volMult) : 0.0
    trTerm  = math.max(math.min(dev, 1.0), -1.0) * 100
    // weighted blend (weights normalized → result stays within ±100)
    (wPos * posTerm + wDD * ddTerm + wTrend * trTerm) / wSum

rFast = ta.ema(f_resilience(src, fastLen), smooth)
rMed  = ta.ema(f_resilience(src, medLen),  smooth)
rSlow = ta.ema(f_resilience(src, slowLen), smooth)

// ============================================================
// Regime classification (driven by the slow line)
// ============================================================
f_regime(float v) =>
    v >= strongLvl  ? "RESILIENT" :
     v >= 0          ? "Steady"     :
     v >  fragileLvl ? "Soft"       :
     v >  brokenLvl  ? "FRAGILE"    : "BROKEN"

f_regimeCol(float v) =>
    v >= strongLvl  ? color.lime  :
     v >= 0          ? color.green :
     v >  fragileLvl ? color.gray  :
     v >  brokenLvl  ? color.orange : color.red

// ============================================================
// Plots, bands & shading
// ============================================================
hline(0,         "Zero",   color = color.new(color.gray, 40),  linestyle = hline.style_solid)
hline(strongLvl, "Strong", color = color.new(color.green, 70), linestyle = hline.style_dashed)
hFragile = hline(fragileLvl, "Fragile", color = color.new(color.orange, 55), linestyle = hline.style_dashed)
hBroken  = hline(brokenLvl,  "Broken",  color = color.new(color.red, 55),    linestyle = hline.style_dashed)
fill(hFragile, hBroken, color = color.new(color.red, 92), title = "Stress zone")

pFast = plot(rFast, "Fast", color = colFast, linewidth = 2)
pMed  = plot(rMed,  "Med",  color = colMed,  linewidth = 2)
pSlow = plot(rSlow, "Slow", color = colSlow, linewidth = 2)
fill(pFast, pSlow, color = showFill ? color.new(colSlow, 88) : na, title = "Term-structure gap")

bgcolor(stressBg and rSlow < fragileLvl ? color.new(color.red, 90) : na, title = "Stress background")

// ============================================================
// Readout table
// ============================================================
f_val(float v) => str.tostring(math.round(v * 10) / 10)
tblPosV = tblPos == "Top Left" ? position.top_left :
   tblPos == "Bottom Right" ? position.bottom_right :
   tblPos == "Bottom Left"  ? position.bottom_left  : position.top_right

var table t = table.new(tblPosV, 2, 5, border_width = 1)
if showTable and barstate.islast
    table.cell(t, 0, 0, useRel ? "Resilience · REL" : "Resilience",
         text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 0))
    table.cell(t, 1, 0, f_regime(rSlow),
         text_color = color.white, text_size = size.small, bgcolor = color.new(f_regimeCol(rSlow), 0))
    table.cell(t, 0, 1, "Fast",       text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, f_val(rFast), text_color = colFast,    text_size = size.small)
    table.cell(t, 0, 2, "Med",        text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 2, f_val(rMed),  text_color = colMed,     text_size = size.small)
    table.cell(t, 0, 3, "Slow",       text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, f_val(rSlow), text_color = colSlow,    text_size = size.small)
    table.cell(t, 0, 4, "Trend",      text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 4, rFast > rSlow ? "Repairing" : "Eroding",
         text_color = rFast > rSlow ? color.lime : color.red, text_size = size.small)

// ============================================================
// Alerts
// ============================================================
alertcondition(ta.crossunder(rSlow, fragileLvl), "Resilience → Fragile", "Slow resilience broke below the Fragile level")
alertcondition(ta.crossover(rSlow, 0),           "Resilience recovered",  "Slow resilience reclaimed zero")
alertcondition(ta.crossover(rFast, rSlow),       "Early repair",          "Fast crossed above Slow — early recovery")
alertcondition(ta.crossunder(rFast, rSlow),      "Early erosion",         "Fast crossed below Slow — early breakdown")
