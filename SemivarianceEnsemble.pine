//@version=6
strategy("Semivariance Plateau Ensemble (SSRN 2815151)", shorttitle="SAM-Ens",
     overlay=true,
     initial_capital=100000,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     margin_long=10,
     margin_short=10,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     max_bars_back=500)

// ============================================================
// The walk-forward-certified version of the SAM strategy
// ============================================================
// Signal (Barunik, Kocenda & Vacha, SSRN 2815151): daily realized
// variance from 30m returns is split into bad volatility RS- (down
// moves) and good volatility RS+ (up moves); SAM_W = rolling W-day
// sum of (RS+ - RS-).
//
// Instead of betting on one window W, this version asks EVERY window
// W = 2..30 and holds a graded LONG position equal to the fraction
// that say bad volatility dominates (SAM_W < 0). Fully long when all
// horizons agree, scaled down when evidence is mixed, flat when none.
//
// Why ensemble instead of one W (backtests/nas100_semivariance/):
//   - all 29 windows are individually profitable (param stability)
//   - walk-forward: greedy re-picking of the best W collapses to OOS
//     Sharpe 0.19 (efficiency 0.16); this ensemble scores OOS Sharpe
//     0.79 with efficiency 0.94 — nothing in it is fitted, so there
//     is nothing to overfit
//   - full sample 2016-2025: Sharpe 0.82, CAGR 14.8%, maxDD -24.9%,
//     t-stat 2.47, avg position 0.58x
//   - Monte Carlo: P(edge < 0) = 0.12%, median maxDD -23%, P(-50%) 0.1%
//
// USE ON A 30-MINUTE NAS100 CHART. Rebalances once per day at the
// close of the first bar of the new session.

// ============================================================
// Inputs
// ============================================================
gSig = "Signal"
wMin    = input.int(2,  "Smallest SAM window (days)", minval=1,  maxval=10, group=gSig)
wMax    = input.int(30, "Largest SAM window (days)",  minval=10, maxval=60, group=gSig,
     tooltip="The ensemble votes over every window between smallest and"
       + " largest. Defaults (2-30) are the researched set — resist tuning"
       + " them; the whole point of this version is that nothing is fitted.")
minBars = input.int(20, "Min 30m bars for a valid day", minval=1, group=gSig)

gPos = "Position"
fullPct   = input.float(100, "Size when all windows agree (% of equity)",
     minval=1, maxval=200, step=5, group=gPos)
rebalPct  = input.float(10, "Min rebalance step (% of full size)",
     minval=1, maxval=50, step=1, group=gPos,
     tooltip="Daily position changes smaller than this are skipped to"
       + " avoid churning commissions on tiny vote changes.")

gViz = "Display"
showTint = input.bool(true, "Tint background by ensemble vote", group=gViz)

// ============================================================
// Daily semivariance accumulation on 30m bars
// ============================================================
var float rsPosDay = 0.0
var float rsNegDay = 0.0
var int   dayBars  = 0

// history of completed days, newest last, capped at wMax
var array<float> rsPosHist = array.new_float()
var array<float> rsNegHist = array.new_float()

newDay = ta.change(time("D")) != 0

// first bar of a day is open->close so the overnight gap never enters RS
r = newDay ? math.log(close / open) : math.log(close / close[1])

var float strength = na    // ensemble vote 0..1, refreshed once per day

if newDay
    if dayBars >= minBars
        array.push(rsPosHist, rsPosDay)
        array.push(rsNegHist, rsNegDay)
        if array.size(rsPosHist) > wMax
            array.shift(rsPosHist)
            array.shift(rsNegHist)
    // vote: for each W, is the W-day SAM negative (bad vol dominates)?
    if array.size(rsPosHist) == wMax
        votes = 0
        sumPos = 0.0
        sumNeg = 0.0
        last = array.size(rsPosHist) - 1
        for w = 1 to wMax
            sumPos += array.get(rsPosHist, last - w + 1)
            sumNeg += array.get(rsNegHist, last - w + 1)
            if w >= wMin and sumPos - sumNeg < 0
                votes += 1
        strength := votes / float(wMax - wMin + 1)
    rsPosDay := 0.0
    rsNegDay := 0.0
    dayBars  := 0

if not na(r)
    rsPosDay += r > 0 ? r * r : 0.0
    rsNegDay += r < 0 ? r * r : 0.0
    dayBars  += 1

// ============================================================
// Daily rebalance to the graded target
// ============================================================
if newDay and not na(strength)
    fullQty   = strategy.equity * (fullPct / 100) / close
    targetQty = fullQty * strength
    deltaQty  = targetQty - strategy.position_size
    if strength < 0.001 and strategy.position_size > 0
        strategy.close_all("flat")
    else if math.abs(deltaQty) >= fullQty * rebalPct / 100
        if deltaQty > 0
            strategy.order("Add", strategy.long, qty=deltaQty)
        else
            strategy.order("Trim", strategy.short, qty=-deltaQty)

// ============================================================
// Display
// ============================================================
tintAlpha = showTint and not na(strength) ?
     int(97 - 27 * strength) : na   // 97 (faint) .. 70 (strong vote)
bgcolor(na(tintAlpha) or strength <= 0 ? na : color.new(color.teal, tintAlpha),
     title="Ensemble vote (darker teal = more windows say bad vol dominates)")

plotchar(newDay and strength > 0.99, "All windows agree", "▲",
     location.belowbar, color.new(color.teal, 0), size=size.tiny)
plotchar(newDay and strength < 0.001 and strength[1] >= 0.001, "Gone flat", "•",
     location.abovebar, color.new(color.orange, 0), size=size.tiny)
