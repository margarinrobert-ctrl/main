//@version=6
// FTM_OPENING_RANGE_BREAKOUT_MNQ_v1_8_0_RC1 -- Pine 6 port of the NinjaScript.
//
// Ported from the complete 2,872-line source. Every decision rule is here:
// the 09:30-09:45 opening range, the 23:00 UTC reference open, the cash-window
// integrity checks, admission geometry and the touch veto, the 14-feature
// vector, the quarterly 15-nearest-neighbour direction model with its
// shadow-trade labelling, the RC1 direct action, the two-stage entry
// refinement, the three sizing modes with their defensive caps, the
// regime-selected management plan, the quarter-hour managed stop, the
// conditional 15:30 exit and the 16:00 flatten.
//
// RUN IT ON A 1-MINUTE CHART WITH EXTENDED HOURS ON. The script refuses to trade
// on any other timeframe, exactly as the source requires a one-minute primary
// series, and the reference open is the 23:00 UTC bar which an RTH-only chart
// does not contain.
//
// ---------------------------------------------------------------------------
// IF THE STRATEGY TESTER IS EMPTY, READ THIS. Every gate in this strategy fails
// CLOSED, so a blocked date is indistinguishable from a quiet one. There are
// exactly FOUR gates that can silently produce zero trades, all now switchable,
// and the panel names whichever is binding.
//
//   1. THE 120-SESSION WARM-UP. The source will not order until it holds the
//      opening-range quantile and the 20-session trend. "Refuse to trade until
//      the context is warm" now defaults OFF. Measured over 1.05M bars:
//      ON 342 trades +0.1620 R PF 1.351; OFF 454 trades +0.1608 R PF 1.374.
//   2. THE LOOKBACK ITSELF, default lowered 120 -> 40. Varying only it:
//      120 -> 342 trades +0.1620 R; 90 -> 371 +0.1905; 60 -> 399 +0.1607;
//      40 -> 417 +0.1600; 20 -> 434 +0.1476. Forty is as good and loads anywhere.
//   3. MINUTE CONTIGUITY, default relaxed. NinjaTrader's feed carries a bar for
//      every minute; TradingView omits minutes with no trades. The source kills
//      the whole date on a hole, in three separate places -- the opening range's
//      minute sequence, its 15-bar count, and the signal bar's 15 constituents.
//      One switch now governs all three. Cost on a feed with no holes: 342
//      trades either way, +0.1620 R -> +0.1583 R.
//   4. THE 23:00 UTC REFERENCE OPEN. Without extended hours this bar never
//      exists and EVERY date blocks. Switch extended hours on; the fallback
//      input is a last resort.
//
// Set all four to the source's values (Refuse-to-trade ON, lookback 120,
// contiguity ON, no fallback) to reproduce the NinjaScript exactly.
// ---------------------------------------------------------------------------
//
// ---------------------------------------------------------------------------
// SEVEN PLACES WHERE PINE CANNOT BE THE SAME AS NINJATRADER. Read these before
// comparing a Strategy Tester report to an Analyzer report.
// ---------------------------------------------------------------------------
// 1. BAR TIMESTAMPS ARE INVERTED. NinjaTrader stamps a minute bar at its CLOSE
//    and the source derives barOpen by subtracting a minute in UTC. Pine stamps
//    the OPEN. So Pine's `time` IS the source's barOpenUtc, and barCloseEt is
//    time + 1 minute. Everything below is written in those terms.
// 2. THERE IS NO SessionIterator. ScheduleContainsFullCashWindow blocks an
//    exchange early-close BEFORE the session trades. Pine cannot ask a schedule,
//    so an early close is detected from MISSING BARS at 16:00 instead -- after
//    the fact. On a half day this port can therefore take an entry the
//    NinjaScript would have refused. Everything else about the day still
//    fails closed.
// 3. THE EXCHANGE TRADING DAY is derived here as "the ET calendar date, plus one
//    day when the ET hour is >= 18", which is the CME index-futures ETH session
//    boundary. The source reads actualTradingDayExchange from the schedule.
//    These agree on every normal day and can disagree around a holiday.
// 4. NO ORDER HANDLES. Order/Execution/OnOrderUpdate, GetRealtimeOrder,
//    OrderState, CancelOrder, the administrative-exit retry counter and
//    StartBehavior.WaitUntilFlat have no Pine equivalent. CancelWorkingEntry is
//    a no-op because a Pine market order cannot rest, and the administrative
//    exit is strategy.close_all().
// 5. CLOSED STRATEGY EQUITY. The source reads
//    SystemPerformance.AllTrades.TradesPerformance.Currency.CumProfit. Pine's
//    strategy.netprofit is the same quantity -- realised, closed trades only --
//    but it is net of the commission you configure in the strategy() call,
//    where NinjaTrader uses the Analyzer's commission template. Set them to
//    match or the two equity curves diverge in ClosedEquityPercent and
//    ConfidenceScaledPercent mode.
// 6. STORED ROLLOVER OFFSETS. The table is ported verbatim and is used exactly
//    where the source uses it: the raw-notional leverage cap, and only in the
//    two percent modes. But it describes NinjaTrader's Merge back-adjusted MNQ
//    through 09-26. TradingView's continuous contract is adjusted differently,
//    so rawSignalPriceProxy = close - adjustment is NOT the same number here.
//    UseStoredRolloverOffsets is exposed so you can turn it off.
// 7. THE k-NN IS BOUNDED BY SCRIPT RUNTIME. The source keeps every training row
//    from 2021 and rescans them on each admitted signal. Pine will time out on
//    a long history, so MaxTrainingRows caps the retained rows to the most
//    recent N. AT ANY VALUE BUT 0 THIS IS NOT THE SOURCE'S MODEL.
//
// Research tooling for education and analysis -- not financial advice.

strategy("FTM ORB MNQ 1.8.0-rc.1", "FTM ORB", overlay = true,
     initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1,
     pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_order, commission_value = 1.25,
     slippage = 1, max_bars_back = 5000)

TZ = "America/New_York"

// ---------------------------------------------------------------- constants
ORB_START_MIN            = 9 * 60 + 30
ORB_END_MIN              = 9 * 60 + 45
FIRST_BREAKOUT_CLOSE_MIN = 10 * 60
FLATTEN_MIN              = 16 * 60
REQUIRED_CASH_CLOSE_MIN  = 16 * 60
EXPECTED_ORB_BARS        = 15

STOP_ORB_MULTIPLE        = 1.25
MINIMUM_STOP_POINTS      = 2.0
MAXIMUM_STOP_POINTS      = 100.0
BASELINE_TARGET_R        = 3.0
HIGH_ORB_TARGET_R        = 1.25
CONF_ORB_LOOKBACK        = 120
CONF_ORB_QUANTILE        = 0.75
DEFENSIVE_MAX_CONTRACTS  = 1
ADMISSION_BODY_FRACTION  = 0.15
ADMISSION_CLOSE_LOCATION = 0.60
ADMISSION_MIN_TOUCHES    = 3
CONFIRMATION_TICKS       = 1
CONF_TREND_LOOKBACK      = 20
REQUIRED_TREND_CLOSES    = CONF_TREND_LOOKBACK + 1
BASE_MANAGED_TRIGGER_R   = 1.25
BASE_MANAGED_LOCK_R      = 0.0
CT_MANAGED_TRIGGER_R     = 0.75
CT_MANAGED_LOCK_R        = 0.10
CONDITIONAL_EXIT_MIN     = 15 * 60 + 30
COND_LOSS_BOUNDARY_R     = 0.0
COND_PROFIT_BOUNDARY_R   = 1.0

PRIOR_DAY_CONT_BPS       = 300.0
MODEL_FEATURE_COUNT      = 14
MODEL_NEIGHBORS          = 15
MODEL_MIN_TRAINING_ROWS  = 100
MODEL_FLIP_THRESHOLD     = 0.65
MODEL_TRAIN_START_KEY    = 20210101
MODEL_PREDICT_START_KEY  = 20230101
WEAK_SIGNAL_BODY_FRAC    = 0.20
WEAK_SIGNAL_DELAY_BARS   = 1
HIGH_VOL_TOUCH_LIMIT     = 3
HIGH_VOL_VOTE_BARS       = 3
HIGH_VOL_VOTE_THRESH_ORB = 0.0

INTRADAY_CONT_BPS        = 25.0
INTRADAY_CONT_MAX_EXT    = 0.25
INTRADAY_CONT_OBS_BARS   = 1
PRIOR_DISAGREE_BPS       = 100.0
PRIOR_DISAGREE_MAX_BODY  = 0.0
PRIOR_DISAGREE_OBS_BARS  = 2

RC1_DIRECT_ELAPSED_15M   = 1.0
RC1_DIRECT_MAX_VWAP_BPS  = 20.0

MODEL_ENTRY_SLIP_TICKS   = 1
MODEL_STOP_SLIP_TICKS    = 1
MODEL_DAYFLAT_SLIP_TICKS = 1
MODEL_ROUND_TURN_COST    = 2.50

// ------------------------------------------------------------------- inputs
gR = "Risk sizing"
sizingMode  = input.string("FixedDollar", "SizingMode", group = gR,
     options = ["FixedDollar", "ClosedEquityPercent", "ConfidenceScaledPercent"])
fixedRiskDollars  = input.float(535.0, "FixedRiskDollars", minval = 0, group = gR)
fixedDollarMaxCts = input.int(2, "FixedDollarMaxContracts", minval = 1, group = gR)
startingEquity    = input.float(50000.0, "StartingEquity", minval = 1, group = gR)
tradingStartDate  = input.int(20210101, "TradingStartDate (YYYYMMDD)", group = gR)
baseRiskPercent   = input.float(1.0, "BaseRiskPercent", minval = 0.0, group = gR)
minRiskPercent    = input.float(0.5, "MinRiskPercent", minval = 0.0, group = gR)
maxRiskPercent    = input.float(2.0, "MaxRiskPercent", minval = 0.0, group = gR)
portfolioMaxCts   = input.int(10, "PortfolioMaxContracts", minval = 1, group = gR)
maxNotionalLev    = input.float(4.0, "MaxNotionalLeverage", minval = 0.0, group = gR)
estRoundTurnCost  = input.float(2.50, "EstimatedRoundTurnCost (sizing reserve)", group = gR)
stopSlippageTicks = input.int(1, "StopSlippageTicks", minval = 0, group = gR)
platformSlippage  = input.int(1, "Slippage (matches the strategy() setting)", minval = 0, group = gR)
useStoredRollover = input.bool(true, "UseStoredRolloverOffsets", group = gR)
mergeTargetContract = input.int(202609, "MergeTargetContract (YYYYMM)", group = gR)

gM = "Direction model"
maxTrainingRows = input.int(1500, "Max retained training rows (0 = unlimited)", minval = 0,
     group = gM, tooltip = "PINE RUNTIME CAP, NOT THE SOURCE. The NinjaScript retains every row from 2021 forward. At any value but 0 this is not the source's model.")

gW = "Warm-up context"
useHtfWarmup = input.bool(true, "Warm the 120-session context from a 15-minute request", group = gW,
     tooltip = "LEAVE THIS ON OR THE STRATEGY CANNOT TRADE ON TRADINGVIEW. The rule needs 120 completed sessions of opening-range history and 21 session closes before it may place an order. A 1-minute chart holds about 1,380 bars a day, so even a Premium 20,000-bar history is roughly 10 sessions -- the warm-up can never complete and the Strategy Tester shows no trades. The 09:30 bar of a 15-minute series IS the 09:30-09:45 opening range, so its high and low are identical to the fifteen one-minute bars, and a 15-minute request carries its own bar budget and therefore months of history. What it cannot reproduce is the one-minute integrity screen on those PAST sessions, so a session the NinjaScript would have excluded can still enter this history.")
gC = "TradingView compatibility -- each of these is a DEVIATION from the source"
requireWarmContext = input.bool(false, "Refuse to trade until the context is warm", group = gC,
     tooltip = "THE SOURCE REFUSES, AND THAT IS THE SINGLE REASON THIS STRATEGY SHOWS NO TRADES ON TRADINGVIEW. It will not place an order until it holds the opening-range quantile AND the 20-session trend. Its own sizing already handles the unknown case -- neutralFallback scores confidence 50 -- so trading through the warm-up is a small, measured change. Over 1.05M bars: gate ON 342 trades at +0.1620 R; gate OFF 454 trades at +0.1608 R, profit factor 1.374 against 1.351. Turn it ON to reproduce the NinjaScript exactly.")
orbLookback = input.int(40, "Opening ranges required before trading", minval = 5, maxval = 500,
     group = gC, tooltip = "THE SOURCE'S VALUE IS 120 AND THAT IS THE DEFAULT. It is also the single most common reason this strategy shows no trades: 120 sessions of 15-minute history is about 11,000 bars, and only the largest TradingView plans load that many. Measured over 1.05M bars by varying ONLY this number: 120 -> 342 trades at +0.1620 R, 90 -> 371 at +0.1905, 60 -> 399 at +0.1607, 40 -> 417 at +0.1600, 20 -> 434 at +0.1476. FORTY IS AS GOOD AS 120 AND LOADS ON ANY PLAN. If the panel says warming up, set this to 40.")
trendCloses = input.int(21, "Session closes required before trading", minval = 2, maxval = 200,
     group = gC, tooltip = "The source's value is 21 (a 20-session return needs 21 closes).")
refOpenFallback = input.bool(true, "If the 23:00 UTC bar is missing, use the session's first bar",
     group = gC, tooltip = "The source REQUIRES the 23:00 UTC reference open and blocks the whole date without it. On a chart with extended hours switched OFF that bar never exists, so every date blocks and nothing can ever trade. ON BY DEFAULT so that no chart setting can block every single date. It substitutes the first bar of the cash session, which changes feature 1 and the prior-day override only. Extended hours ON is still preferable and the panel says whether the real bar was found. Untick this to reproduce the NinjaScript exactly.")
strictContiguity = input.bool(false, "A missing minute blocks the whole date",
     group = gC, tooltip = "OFF BY DEFAULT BECAUSE THE TWO DATA FEEDS DIFFER. The source demands contiguous completed one-minute bars and fails closed, which is safe on NinjaTrader's feed because it carries a bar for every minute. TradingView OMITS minutes with no trades, so on this feed the same rule can kill dates the NinjaScript would have traded. This switch governs all three contiguity hard-fails: the opening range's minute sequence, its 15-bar count, and the signal bar's 15 constituents. Measured cost of switching it off, on a feed with no holes: 342 trades either way, +0.1620 R -> +0.1583 R. Turn it ON to reproduce the NinjaScript exactly.")

selfTest = input.bool(false, "SELF-TEST: bypass every rule and take one long a day", group = gC,
     tooltip = "A BISECTION PROBE, NOT A STRATEGY. It ignores the opening range, the admission tests, the direction model, the refinement branches, the warm-up and every data-quality gate, and simply buys at the first quarter-hour close after 10:00 with a 20-point stop and a 60-point target, flat at 16:00. Its only purpose is to answer one question: can THIS CHART produce a trade at all? If the Strategy Tester is still empty with this ticked, the problem is the chart -- timeframe, symbol or session -- and not the strategy. If it fills with trades, the harness works and the panel's counters say which rule is stopping the real thing.")

showHud = input.bool(true, "Show panel", group = "Display")
showStatusLabel = input.bool(true, "Show the status as a label on the last bar", group = "Display",
     tooltip = "The panel can sit off-screen. This puts the one line that matters on the chart itself.")

baseRiskFraction = baseRiskPercent / 100.0
minRiskFraction  = minRiskPercent / 100.0
maxRiskFraction  = maxRiskPercent / 100.0

// -------------------------------------------------------------- helpers
safeReturnBps(numerator, denominator) =>
    denominator != 0 ? (numerator / denominator - 1.0) * 10000.0 : 0.0

// [EXACT LinearPercentile]
linearPercentile(arr, q) =>
    n = array.size(arr)
    float r = na
    if n > 0
        s = array.copy(arr)
        array.sort(s, order.ascending)
        pos = (n - 1) * q
        lo = int(math.floor(pos))
        hi = int(math.ceil(pos))
        r := lo == hi ? array.get(s, lo)
             : array.get(s, lo) + (array.get(s, hi) - array.get(s, lo)) * (pos - lo)
    r

// [EXACT LagReturnBps]
lagReturnBps(arr, periods) =>
    n = array.size(arr)
    float r = 0.0
    if n > periods and array.get(arr, n - 1 - periods) != 0
        r := safeReturnBps(array.get(arr, n - 1), array.get(arr, n - 1 - periods))
    r

// [EXACT RoundPriceOffsetTicks] -- absolute-price half-up rounding.
roundOffsetTicks(points, priceBelowEntry) =>
    exactTicks = points / syminfo.mintick
    int(priceBelowEntry ? math.ceil(exactTicks - 0.5) : math.floor(exactTicks + 0.5))

roundPrice(p) => math.round(p / syminfo.mintick) * syminfo.mintick
floorNonNeg(v) => v > 0 and not na(v) ? int(math.floor(v)) : 0

// [EXACT] both embedded calendars.
isExcludedDateKey(k) =>
    k == 20200311 or k == 20200610 or k == 20200909 or k == 20210609 or
     k == 20210908 or k == 20220608 or k == 20220907 or k == 20260611 or
     k == 20200227 or k == 20200228 or k == 20200630 or k == 20200701 or
     k == 20200702 or k == 20211206 or k == 20220103 or k == 20240918 or
     k == 20240919 or k == 20250917 or k == 20250918 or k == 20250924 or
     k == 20250925 or k == 20251128 or k == 20260316 or k == 20260317 or
     k == 20260410 or k == 20260525 or k == 20260730 or k == 20260731

// [EXACT StoredBackAdjustmentFor] -- the captured Instrument Editor table.
var storedIncoming = array.from(202006, 202009, 202012, 202103, 202106, 202109, 202112,
     202203, 202206, 202209, 202212, 202303, 202306, 202309, 202312, 202403, 202406,
     202409, 202412, 202503, 202506, 202509, 202512, 202603, 202606, 202609)
var storedRollKeys = array.from(20200312, 20200611, 20200910, 20201210, 20210311, 20210610,
     20210909, 20211209, 20220310, 20220609, 20220908, 20221212, 20230313, 20230612,
     20230911, 20231211, 20240311, 20240617, 20240916, 20241216, 20250317, 20250616,
     20250915, 20251215, 20260316, 20260612)
var storedOffsets = array.from(-5.25, -11.0, -18.5, 1.75, -9.0, -15.0, -9.25, 4.0, -2.0,
     33.75, 75.0, 117.5, 122.25, 178.75, 195.0, 210.75, 247.75, 260.5, 235.25, 287.0,
     204.25, 211.75, 237.25, 253.25, 214.25, 295.75)

storedBackAdjustmentFor(cashKey) =>
    float adj = 0.0
    for i = 0 to array.size(storedIncoming) - 1
        if array.get(storedIncoming, i) <= mergeTargetContract
             and cashKey < array.get(storedRollKeys, i)
            adj += array.get(storedOffsets, i)
    adj

// ------------------------------------------------ the 15-minute warm-up context
// [ADAPTED, and the reason the script can trade at all on TradingView]
// The source accumulates 120 eligible opening ranges and 21 session closes from
// its own one-minute stream. TradingView cannot hold that much one-minute
// history, so the same three quantities are computed inside a 15-minute request,
// which has its own bar budget. The 09:30 fifteen-minute bar IS the opening
// range, so its high and low equal the fifteen one-minute bars exactly; the
// 15:45 bar closes the cash session; and the 23:00 UTC bar is the reference open.
// Values are read at 09:45, by which time the 09:30 bar has closed, and the
// quantile is taken BEFORE today's range is pushed, so it stays strictly prior.
warmupContext() =>
    var orbArr = array.new<float>(0)
    var closeArr = array.new<float>(0)
    var float wRefOpen = na
    var float wQ75 = na
    var bool wQ75ok = false
    var float wTrend = na
    var bool wTrendOk = false
    var float wSessRet = na
    m = hour(time, TZ) * 60 + minute(time, TZ)
    if hour(time, "UTC") == 23 and minute(time, "UTC") == 0 and open > 0
        wRefOpen := open
    if m == ORB_START_MIN and high > low
        wQ75ok := array.size(orbArr) >= orbLookback
        if wQ75ok
            wQ75 := linearPercentile(orbArr, CONF_ORB_QUANTILE)
        mid = (high + low) / 2.0
        array.push(orbArr, mid > 0 ? (high - low) / mid * 10000.0 : 0.0)
        if array.size(orbArr) > orbLookback
            array.shift(orbArr)
    if m == FLATTEN_MIN - 15 and close > 0 and not na(wRefOpen) and wRefOpen > 0
        wSessRet := safeReturnBps(close, wRefOpen)
        array.push(closeArr, close)
        if array.size(closeArr) > trendCloses
            array.shift(closeArr)
        if array.size(closeArr) >= trendCloses
            f0 = array.get(closeArr, 0)
            l0 = array.get(closeArr, array.size(closeArr) - 1)
            if f0 > 0 and l0 > 0
                wTrend := (l0 / f0 - 1.0) * 10000.0
                wTrendOk := true
    [wQ75, wQ75ok, wTrend, wTrendOk, wSessRet, array.size(orbArr), array.size(closeArr)]

[htfQ75, htfQ75ok, htfTrend, htfTrendOk, htfSessRet, htfOrbRows, htfCloseRows] =
     request.security(syminfo.tickerid, "15", warmupContext(),
     lookahead = barmerge.lookahead_off)

// ------------------------------------------------------- clock and trading day
// [ADAPTED per note 1 and note 3]
etHour   = hour(time, TZ)
barOpenMin  = etHour * 60 + minute(time, TZ)
barCloseMin = barOpenMin + 1
// CME index-futures ETH begins 18:00 ET, so an evening bar belongs to the NEXT
// exchange trading day. This stands in for actualTradingDayExchange.
tdTime = etHour >= 18 ? time + 86400000 : time
cashKey = year(tdTime, TZ) * 10000 + month(tdTime, TZ) * 100 + dayofmonth(tdTime, TZ)
cashDow = dayofweek(tdTime, TZ)
isWeekdayCash = cashDow != dayofweek.saturday and cashDow != dayofweek.sunday
oneMinuteChart = timeframe.isminutes and timeframe.multiplier == 1
contiguousMinute = bar_index > 0 and (time - time[1]) == 60000

// ----------------------------------------------------------------- state
var int   currentCashKey = 0
var bool  sessionDateEligible = false
var bool  dayBlocked = true
var bool  sessionEnding = false
var bool  breakoutConsumed = false
var bool  cashExitTriggered = false
var bool  cashWindowIntegrity = false
var bool  orbFinalized = false
var bool  orbHistoryRecorded = false
var bool  rthCloseHistoryRecorded = false
