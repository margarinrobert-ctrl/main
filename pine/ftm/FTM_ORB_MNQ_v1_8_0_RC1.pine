var spSide   = array.new<int>(2, 0)
var spEntry  = array.new<float>(2, 0.0)
var spStop   = array.new<float>(2, 0.0)
var spTarget = array.new<float>(2, 0.0)
var spRisk   = array.new<float>(2, 0.0)
var spTrigR  = array.new<float>(2, 0.0)
var spLockR  = array.new<float>(2, 0.0)
var spPendCond = array.new<bool>(2, false)
var spComplete = array.new<bool>(2, false)
var spExit   = array.new<float>(2, 0.0)

// training store
var featureStore = array.new<float>(0)
var rowDateKey   = array.new<int>(0)
var rowFlipWins  = array.new<int>(0)
var modelMeanArr  = array.new<float>(MODEL_FEATURE_COUNT, 0.0)
var modelScaleArr = array.new<float>(MODEL_FEATURE_COUNT, 1.0)
var bool modelReady = false
var int  modelRowsUsed = 0
var int  activeQuarterKey = -1

var int cntEligibleSessions = 0
var int cntAdmitted = 0
var int cntGeometryReject = 0
var int cntTouchVeto = 0
var int cntPriorOverride = 0
var int cntKnnOverride = 0
var int cntRc1Direct = 0
var int cntRc1Parent = 0
var int cntWeakDelay = 0
var int cntHighVolVote = 0
var int cntHighVolFlip = 0
var int cntPriorReversal = 0
var int cntIntradayKeep = 0
var int cntIntradayReverse = 0
var int cntLabels = 0
var int cntSizingSkip = 0
var int cntFailClosed = 0
var int cntContextWarmup = 0
var int blkGap = 0
var int blkNoRef = 0
var int blkOrb = 0
var int blkExcluded = 0
var int daysSeen = 0
var bool sawRefEver = false

// NOTE ON STRUCTURE. A Pine user-defined function may mutate an ARRAY it is
// handed, but it may NOT assign to a global variable, and strategy.* calls are
// kept out of functions here so their placement is never in doubt. So every
// helper below is PURE -- it reads state and returns values -- and every
// mutation, every order and every counter increment happens in the main scope.
// InvalidatePendingSessionState, BlockCashDate, SubmitEntry,
// ApplyFinalEntryRefinementOrSubmit, ProcessShadowTradeBar, CompleteShadowTrade
// and TryRecordCompletedModelLabel are therefore inlined at their call sites
// rather than written as functions.

// [EXACT TryGetPriorTrendReturn] -- first and last of the retained 21 closes.
tryPriorTrend() =>
    n = array.size(rthCloseHistory)
    float v = 0.0
    bool ok = false
    if n >= trendCloses
        f = array.get(rthCloseHistory, 0)
        l = array.get(rthCloseHistory, n - 1)
        if f > 0 and l > 0
            v := (l / f - 1.0) * 10000.0
            ok := true
    [ok, v]

// [EXACT SelectManagementPlan] -- high volatility outranks countertrend.
selectManagementPlan(side) =>
    highVol = priorOrbQ75Available and currentOrbBps > priorOrbQ75Bps
    countertrend = priorTrendAvailable and side * priorTrendBps < 0
    float tR = BASELINE_TARGET_R
    float trg = BASE_MANAGED_TRIGGER_R
    float lck = BASE_MANAGED_LOCK_R
    string rg = "baseline"
    if highVol
        tR := HIGH_ORB_TARGET_R
        rg := "high_orb_short_target"
    else if countertrend
        trg := CT_MANAGED_TRIGGER_R
        lck := CT_MANAGED_LOCK_R
        rg := "countertrend_early_guard"
    [tR, trg, lck, rg]

// =========================================================== the shadow pair
// [EXACT ProcessShadowTradeBar / CompleteShadowTrade] -- these only ever mutate
// the shadow ARRAYS, which a function is allowed to do.
completeShadow(i, px) =>
    array.set(spExit, i, px)
    array.set(spComplete, i, true)
    array.set(spPendCond, i, false)

processShadowTradeBar(i, closeMin) =>
    if not array.get(spComplete, i)
        sd = array.get(spSide, i)
        if array.get(spPendCond, i)
            completeShadow(i, open - sd * MODEL_DAYFLAT_SLIP_TICKS * syminfo.mintick)
        else
            stp = array.get(spStop, i)
            tgt = array.get(spTarget, i)
            stopHit = sd == 1 ? low <= stp : high >= stp
            targetHit = sd == 1 ? high >= tgt : low <= tgt
            if stopHit
                basePrice = sd == 1 ? math.min(stp, open) : math.max(stp, open)
                completeShadow(i, basePrice - sd * MODEL_STOP_SLIP_TICKS * syminfo.mintick)
            else if targetHit
                px = sd == 1 ? math.max(tgt, open) : math.min(tgt, open)
                completeShadow(i, px)
            else if closeMin < FLATTEN_MIN and closeMin % 15 == 0
                rp = array.get(spRisk, i)
                closeR = sd * (close - array.get(spEntry, i)) / rp
                if closeR >= array.get(spTrigR, i)
                    proposed = roundPrice(array.get(spEntry, i)
                         + sd * rp * array.get(spLockR, i))
                    array.set(spStop, i, sd == 1 ? math.max(stp, proposed)
                         : math.min(stp, proposed))
                if closeMin == CONDITIONAL_EXIT_MIN
                     and (closeR < COND_LOSS_BOUNDARY_R or closeR >= COND_PROFIT_BOUNDARY_R)
                    array.set(spPendCond, i, true)

// [EXACT TryRecordCompletedModelLabel] -- pushes into the training ARRAYS, which
// is permitted, and returns whether the pair resolved so the main scope can
// clear the scalar flags. `included` is true only when exactly one side of the
// pair was profitable, which is the source's exclusivity test.
tryRecordLabel() =>
    bool resolved = false
    bool included = false
    if spActive and not spInvalid and not spLabelRecorded and spInitialized
         and array.get(spComplete, 0) and array.get(spComplete, 1)
        resolved := true
        pv = syminfo.pointvalue
        bNet = array.get(spSide, 0) * (array.get(spExit, 0) - array.get(spEntry, 0)) * pv
             - MODEL_ROUND_TURN_COST
        fNet = array.get(spSide, 1) * (array.get(spExit, 1) - array.get(spEntry, 1)) * pv
             - MODEL_ROUND_TURN_COST
        bProf = bNet > 0
        fProf = fNet > 0
        if bProf != fProf
            included := true
            for f = 0 to MODEL_FEATURE_COUNT - 1
                array.push(featureStore, array.get(spFeatures, f))
            array.push(rowDateKey, currentCashKey)
            array.push(rowFlipWins, fProf ? 1 : 0)
            if maxTrainingRows > 0 and array.size(rowDateKey) > maxTrainingRows
                array.shift(rowDateKey)
                array.shift(rowFlipWins)
                for f = 0 to MODEL_FEATURE_COUNT - 1
                    array.shift(featureStore)
    [resolved, included]

// [EXACT CreateShadowTrade]
createShadowTrade(i, sd, parentFillOpen) =>
    entry = parentFillOpen + sd * MODEL_ENTRY_SLIP_TICKS * syminfo.mintick
    rawStop = math.max(MINIMUM_STOP_POINTS,
         math.min(MAXIMUM_STOP_POINTS, (orbHigh - orbLow) * STOP_ORB_MULTIPLE))
    stop = roundPrice(entry - sd * rawStop)
    risk = sd * (entry - stop)
    [tR, trg, lck, rg] = selectManagementPlan(sd)
    array.set(spSide, i, sd)
    array.set(spEntry, i, entry)
    array.set(spStop, i, stop)
    array.set(spTarget, i, roundPrice(entry + sd * rawStop * tR))
    array.set(spRisk, i, risk)
    array.set(spTrigR, i, trg)
    array.set(spLockR, i, lck)
    array.set(spPendCond, i, false)
    array.set(spComplete, i, risk <= 0)
    array.set(spExit, i, entry)

// ==================================================== quarterly model refit
quarterKeyOf(t) => year(t, TZ) * 10 + ((month(t, TZ) - 1) / 3 + 1)
quarterStartKey(qk) => (qk / 10) * 10000 + (((qk % 10) - 1) * 3 + 1) * 100 + 1

// [EXACT FitQuarterModel] -- rows with session <= quarterStart - 1 day, which is
// the same as session date key < quarterStart key.
fitQuarterModel(cutoffKey) =>
    n = array.size(rowDateKey)
    int used = 0
    if n > 0
        for r = 0 to n - 1
            k = array.get(rowDateKey, r)
            if k >= MODEL_TRAIN_START_KEY and k < cutoffKey
                used += 1
    ok = used >= math.max(MODEL_MIN_TRAINING_ROWS, MODEL_NEIGHBORS)
    if ok
        for f = 0 to MODEL_FEATURE_COUNT - 1
            float s = 0.0
            for r = 0 to n - 1
                k = array.get(rowDateKey, r)
                if k >= MODEL_TRAIN_START_KEY and k < cutoffKey
                    s += array.get(featureStore, r * MODEL_FEATURE_COUNT + f)
            mean = s / used
            float sq = 0.0
            for r = 0 to n - 1
                k = array.get(rowDateKey, r)
                if k >= MODEL_TRAIN_START_KEY and k < cutoffKey
                    d = array.get(featureStore, r * MODEL_FEATURE_COUNT + f) - mean
                    sq += d * d
            sc = math.sqrt(sq / used)
            array.set(modelMeanArr, f, mean)
            array.set(modelScaleArr, f, sc > 0 ? sc : 1.0)
    [ok, used]

// [EXACT TryPredictDirection] -- 15 nearest neighbours, (flip + 2) / (k + 4).
predictFlip(qf, cutoffKey) =>
    n = array.size(rowDateKey)
    dist = array.new<float>(0)
    flips = array.new<int>(0)
    if n > 0
        for r = 0 to n - 1
            k = array.get(rowDateKey, r)
            if k >= MODEL_TRAIN_START_KEY and k < cutoffKey
                float sq = 0.0
                for f = 0 to MODEL_FEATURE_COUNT - 1
                    mu = array.get(modelMeanArr, f)
                    sc = array.get(modelScaleArr, f)
                    zr = (array.get(featureStore, r * MODEL_FEATURE_COUNT + f) - mu) / sc
                    zq = (array.get(qf, f) - mu) / sc
                    dv = zr - zq
                    sq += dv * dv
                array.push(dist, math.sqrt(sq))
                array.push(flips, array.get(rowFlipWins, r))
    m = array.size(dist)
    int flipNeighbors = 0
    bool avail = m >= MODEL_NEIGHBORS
    if avail
        used = array.new<bool>(m, false)
        for kk = 1 to MODEL_NEIGHBORS
            int best = -1
            float bestd = 1e18
            for i = 0 to m - 1
                if not array.get(used, i) and array.get(dist, i) < bestd
                    bestd := array.get(dist, i)
                    best := i
            if best >= 0
                array.set(used, best, true)
                flipNeighbors += array.get(flips, best)
    [avail, (flipNeighbors + 2.0) / (MODEL_NEIGHBORS + 4.0)]

// ============================================= SubmitEntry, split into a PURE
// plan and an inline submission. Everything here is exactly CalculateQuantity
// and the sizing block of SubmitEntry; only the mutation and the order itself
// were moved out, because a Pine function may not assign to a global.
computeEntryPlan(side) =>
    isLong = side == 1
    rawStop = math.max(MINIMUM_STOP_POINTS,
         math.min(MAXIMUM_STOP_POINTS, (orbHigh - orbLow) * STOP_ORB_MULTIPLE))
    stopTicks = roundOffsetTicks(rawStop, isLong)
    [tR, trg, lck, rg] = selectManagementPlan(side)
    targetTicks = roundOffsetTicks(rawStop * tR, not isLong)

    trendAligned = priorTrendAvailable and side * priorTrendBps >= 0
    countertrend = priorTrendAvailable and not trendAligned
    lowVol  = priorOrbQ75Available and currentOrbBps <= priorOrbQ75Bps
    highVol = priorOrbQ75Available and not lowVol
    neutralFallback = not priorTrendAvailable or not priorOrbQ75Available
    confidenceScore = neutralFallback ? 50
         : 50 * ((trendAligned ? 1 : 0) + (lowVol ? 1 : 0))

    float targetRiskFraction = baseRiskFraction
    if sizingMode == "ConfidenceScaledPercent"
        targetRiskFraction := confidenceScore == 0 ? minRiskFraction
             : confidenceScore == 50 ? baseRiskFraction : maxRiskFraction
    else if sizingMode == "FixedDollar"
        targetRiskFraction := 0.0

    useDefensiveCaps = sizingMode != "ConfidenceScaledPercent"
    int contractCap = sizingMode == "FixedDollar" ? fixedDollarMaxCts : portfolioMaxCts
    if useDefensiveCaps and (highVol or countertrend)
        contractCap := math.min(contractCap, DEFENSIVE_MAX_CONTRACTS)

    equityBefore = sizingMode == "FixedDollar" ? startingEquity
         : startingEquity + strategy.netprofit
    pv = syminfo.pointvalue
    plannedEntry = close
    plannedStop = roundPrice(plannedEntry - side * stopTicks * syminfo.mintick)
    signedStopDistance = side * (plannedEntry - plannedStop)
    reservedSlipTicks = math.max(stopSlippageTicks, platformSlippage)
    perContractRisk = signedStopDistance * pv
         + reservedSlipTicks * syminfo.mintick * pv + estRoundTurnCost
    int qty = 0
    if stopTicks >= 1 and contractCap >= 1 and signedStopDistance > 0 and perContractRisk > 0
        if sizingMode == "FixedDollar"
            qty := math.min(contractCap, floorNonNeg(fixedRiskDollars / perContractRisk))
        else if targetRiskFraction > 0 and not na(equityBefore)
            positiveEquity = math.max(equityBefore, 0.0)
            riskBudget = positiveEquity * targetRiskFraction
            adj = useStoredRollover ? storedBackAdjustmentFor(currentCashKey) : 0.0
            rawProxy = plannedEntry - adj
            if rawProxy > 0
                rawNotional = rawProxy * pv
                qRisk = floorNonNeg(riskBudget / perContractRisk)
                qLev = floorNonNeg(positiveEquity * maxNotionalLev / rawNotional)
                qty := math.min(contractCap, math.min(qRisk, qLev))
    [qty, stopTicks, targetTicks, trg, lck]

// ====================================== ApplyFinalEntryRefinementOrSubmit, as a
// PURE branch classifier. 0 = no condition (submit now), 1 = prior-session
// disagreement, 2 = intraday continuation, -1 = the day must be blocked. The
// priority is the source's: prior session first, then intraday.
refinementBranch(refinedSide, baselineSide, signalClose, feats) =>
    orbRange = orbHigh - orbLow
    int b = -1
    if orbRange > 0
        orientation = refinedSide * baselineSide
        alignedPriorSessionBps = orientation * array.get(feats, 1)
        alignedRet30Bps = orientation * array.get(feats, 5)
        directionalOrbBodyFraction = refinedSide * (orbClose - orbOpen) / orbRange
        edge = refinedSide == 1 ? orbHigh : orbLow
        signalExtensionOrb = refinedSide * (signalClose - edge) / orbRange
        priorSessionCondition = alignedPriorSessionBps > PRIOR_DISAGREE_BPS
             and directionalOrbBodyFraction <= PRIOR_DISAGREE_MAX_BODY
        intradayCondition = alignedRet30Bps > INTRADAY_CONT_BPS
             and signalExtensionOrb <= INTRADAY_CONT_MAX_EXT
        b := priorSessionCondition ? 1 : intradayCondition ? 2 : 0
    b

// [EXACT CountSignalTouches]
countTouches(side, level) =>
    int c = 0
    for i = 0 to 14
        if (side == 1 and high[i] >= level) or (side == -1 and low[i] <= level)
            c += 1
    c


// ---------------------------------------------- per-bar signal state
confirmation = CONFIRMATION_TICKS * syminfo.mintick
// sameCashDate is the source's `barOpenEt.Date == currentCashDate`. It is NOT
// decoration: an 18:01 ET bar belongs to the NEXT exchange trading day, and its
// closeMinuteEt of 1082 is >= the 960 flatten, so without this guard the 16:00
// cash-close branch fires at the START of every session and blocks the day
// before it can trade. Measured on real bars: 0 eligible sessions instead of 51.
sameCashDate = etHour < 18
inCashWindow = barOpenMin >= ORB_START_MIN and barCloseMin <= REQUIRED_CASH_CLOSE_MIN
     and isWeekdayCash and sameCashDate
isQuarterHourClose = barCloseMin >= FIRST_BREAKOUT_CLOSE_MIN and barCloseMin < FLATTEN_MIN
     and barCloseMin % 15 == 0 and isWeekdayCash and sameCashDate
// [EXACT TryGetExactSignalState] -- 15 exact contiguous one-minute constituents.
sigHigh = ta.highest(high, 15)
sigLow  = ta.lowest(low, 15)
sigOpen = open[14]
sigExact = bar_index >= 15 and sigHigh > sigLow
     and (strictContiguity ? (time - time[14]) == 14 * 60000 : true)

// ############################################################################
// MAIN SCOPE. Every mutation, every counter and every strategy.* call lives
// here, in the source's OnBarUpdate order: session reset, reference open,
// cash-window integrity, shadow pair, pending decisions, cash close,
// in-position management, then the breakout evaluation.
// ############################################################################

// ============================================================ BeginCashDate
if oneMinuteChart and cashKey != currentCashKey
    inherited = strategy.position_size != 0
    if ped or pfd or spActive
        cntFailClosed += 1
    ped := false
    pfd := false
    spActive := false
    currentCashKey := cashKey
    sessionDateEligible := true
    referenceOpenCaptured := false
    referenceSessionOpen := 0.0
    dayBlocked := inherited
    sessionEnding := inherited
    breakoutConsumed := inherited
    cashExitTriggered := false
    cashWindowIntegrity := false
    orbFinalized := false
    orbHistoryRecorded := false
    rthCloseHistoryRecorded := false
    activeInitialStopTicks := 0
    managedStopActivated := false
    conditionalExitRequested := false
    orbBarCount := 0
    expectedNextOrbOpenMinute := ORB_START_MIN
    orbHigh := na
    orbLow := na
    orbOpen := 0.0
    orbClose := 0.0
    currentOrbBps := 0.0
    priorOrbQ75Bps := 0.0
    priorOrbQ75Available := false
    [ptOk, ptV] = tryPriorTrend()
    priorTrendAvailable := useHtfWarmup ? htfTrendOk : ptOk
    priorTrendBps := useHtfWarmup ? nz(htfTrend) : ptV
    array.clear(rthMinuteCloses)
    rthTypicalVolumeSum := 0.0
    rthVolumeSum := 0.0
    lastCashBarCloseMin := -1
    activeManagedTriggerR := 0.0
    activeManagedLockR := 0.0
    daysSeen += 1
    if not isWeekdayCash or isExcludedDateKey(cashKey)
        if isWeekdayCash
            blkExcluded += 1
        sessionDateEligible := false
        dayBlocked := true
    else if not inherited
        // Note 2: ScheduleContainsFullCashWindow cannot be evaluated in advance.
        cashWindowIntegrity := true

// ================================================ CaptureReferenceSessionOpen
// [EXACT] the 23:00 UTC bar on the calendar day immediately before the cash date.
if oneMinuteChart and sessionDateEligible and not referenceOpenCaptured
     and hour(time, "UTC") == 23 and minute(time, "UTC") == 0
    utcDayKey = year(time, "UTC") * 10000 + month(time, "UTC") * 100 + dayofmonth(time, "UTC")
    prevT = tdTime - 86400000
    prevCashKey = year(prevT, TZ) * 10000 + month(prevT, TZ) * 100 + dayofmonth(prevT, TZ)
    if utcDayKey == prevCashKey
        sawRefEver := true
        if na(open) or open <= 0
            cashWindowIntegrity := false
            dayBlocked := true
            breakoutConsumed := true
        else
            referenceSessionOpen := open
            referenceOpenCaptured := true

// =============================================== cash-window integrity tracking
if oneMinuteChart and sessionEnding
    if ped or pfd or spActive
        cntFailClosed += 1
    ped := false
    pfd := false
    spActive := false
    if strategy.position_size != 0
        strategy.close_all(comment = "SessionEnding")

if oneMinuteChart and not sessionEnding and inCashWindow
    // [EXACT] a cash bar must be one exact completed minute, contiguous with the last.
    gap = strictContiguity and lastCashBarCloseMin != -1
         and (barOpenMin != lastCashBarCloseMin or not contiguousMinute)
    if gap
        blkGap += 1
        cashWindowIntegrity := false
        dayBlocked := true
        breakoutConsumed := true
        if ped or pfd or spActive
            cntFailClosed += 1
        ped := false
        pfd := false
        spActive := false
        sessionEnding := true
    else
        lastCashBarCloseMin := barCloseMin
        if barOpenMin == ORB_START_MIN and not referenceOpenCaptured
            if refOpenFallback and open > 0
                // DEVIATION, opt-in: substitute the session's first bar so a chart
                // without extended hours is not blocked on every single date.
                referenceSessionOpen := open
                referenceOpenCaptured := true
            else
                blkNoRef += 1
                cashWindowIntegrity := false
                dayBlocked := true
                breakoutConsumed := true
                if ped or pfd or spActive
                    cntFailClosed += 1
                ped := false
                pfd := false
                spActive := false
        else if not dayBlocked
            v = nz(volume)
            if v < 0
                cashWindowIntegrity := false
                dayBlocked := true
                breakoutConsumed := true
                ped := false
                pfd := false
                spActive := false
            else
                array.push(rthMinuteCloses, close)
                rthTypicalVolumeSum += ((high + low + close) / 3.0) * v
                rthVolumeSum += v

// =============================================== the shadow pair, per bar
// [EXACT ProcessShadowPair] -- initialise on the exact parent next-minute open,
// then walk both trades. The label check is a single point below, after the
// cash-close finalisation, which is equivalent to the source's two call sites
// because both occur on the same bar and in that order.
if oneMinuteChart and sameCashDate and spActive and not spInvalid and not spLabelRecorded
    if not spInitialized and spPendingInit
        createShadowTrade(0, spBaselineSide, open)
        createShadowTrade(1, -spBaselineSide, open)
        spInitialized := true
        spPendingInit := false
    if spInitialized
        processShadowTradeBar(0, barCloseMin)
        processShadowTradeBar(1, barCloseMin)

// ========================================================= opening range
// [EXACT CaptureOpeningRange]
if oneMinuteChart and sameCashDate and not dayBlocked and not orbFinalized
     and barOpenMin >= ORB_START_MIN and barOpenMin < ORB_END_MIN and isWeekdayCash
    if strictContiguity and barOpenMin != expectedNextOrbOpenMinute
        blkOrb += 1
        cashWindowIntegrity := false
        dayBlocked := true
        breakoutConsumed := true
    else
        if orbBarCount == 0
            orbOpen := open
            orbHigh := high
            orbLow := low
        else
            orbHigh := math.max(orbHigh, high)
            orbLow := math.min(orbLow, low)
        orbClose := close
        orbBarCount += 1
        expectedNextOrbOpenMinute += 1
        if barCloseMin == ORB_END_MIN
            orbBad = strictContiguity ? orbBarCount != EXPECTED_ORB_BARS : orbBarCount < 1
            if orbBad or orbHigh < orbLow
                blkOrb += 1
                cashWindowIntegrity := false
                dayBlocked := true
                breakoutConsumed := true
            else
                orbFinalized := true
                mid = (orbHigh + orbLow) / 2.0
                currentOrbBps := mid > 0 ? (orbHigh - orbLow) / mid * 10000.0 : 0.0
                if useHtfWarmup
                    priorOrbQ75Available := htfQ75ok
                    priorOrbQ75Bps := nz(htfQ75)
                else
                    priorOrbQ75Available := array.size(orbHistoryBps) >= orbLookback
                    if priorOrbQ75Available
                        priorOrbQ75Bps := linearPercentile(orbHistoryBps, CONF_ORB_QUANTILE)

if oneMinuteChart and inCashWindow and barCloseMin > ORB_END_MIN and not orbFinalized
     and not dayBlocked
    cashWindowIntegrity := false
    dayBlocked := true
    breakoutConsumed := true

// ================================================ pending decision processing
// [EXACT ProcessPendingEntryDecision] -- contiguous completed one-minute bars are
// required; a gap blocks the date and forbids a late substitute order.
var int  submitSide = 0
var bool submitNow = false
submitNow := false

if oneMinuteChart and sameCashDate and ped and not dayBlocked
    if not contiguousMinute
        cntFailClosed += 1
        ped := false
        dayBlocked := true
    else
        if pedObserved == 0
            pedFirstOpen := open
        pedObserved += 1
        if pedObserved >= pedRequired
            int finalSide = pedSide
            if pedBranch == "high_vol_touch_vote"
                move = finalSide * (close - pedFirstOpen)
                fraction = (orbHigh - orbLow) > 0 ? move / (orbHigh - orbLow) : 0.0
                if fraction <= HIGH_VOL_VOTE_THRESH_ORB
                    finalSide := -finalSide
                    cntHighVolFlip += 1
            ped := false
            b = refinementBranch(finalSide, pedBaselineSide, pedSignalClose, pedFeatures)
            if b < 0
                cntFailClosed += 1
                dayBlocked := true
            else if b == 0
                if pedSubmit
                    submitSide := finalSide
                    submitNow := true
            else
                pfd := true
                pfdSide := finalSide
                pfdRequired := b == 1 ? PRIOR_DISAGREE_OBS_BARS : INTRADAY_CONT_OBS_BARS
                pfdObserved := 0
                pfdFirstOpen := 0.0
                pfdSubmit := pedSubmit
                pfdBranch := b == 1 ? "prior_session_disagreement" : "intraday_continuation"

// [EXACT ProcessPendingFinalEntryDecision]
if oneMinuteChart and sameCashDate and pfd and not dayBlocked
    if not contiguousMinute
        cntFailClosed += 1
        pfd := false
        dayBlocked := true
    else
        if pfdObserved == 0
            pfdFirstOpen := open
        pfdObserved += 1
        if pfdObserved >= pfdRequired
            refinedSide = pfdSide
            move = refinedSide * (close - pfdFirstOpen)
            int finalSide = refinedSide
            if pfdBranch == "prior_session_disagreement"
                finalSide := -refinedSide
                cntPriorReversal += 1
            else if move > 0.0
                finalSide := -refinedSide
                cntIntradayReverse += 1
            else
                cntIntradayKeep += 1
            submit = pfdSubmit
            pfd := false
            if submit
                submitSide := finalSide
                submitNow := true

// ================================================== cash close and flatten
if oneMinuteChart and sameCashDate and barCloseMin >= REQUIRED_CASH_CLOSE_MIN
     and isWeekdayCash and not cashExitTriggered
    // [EXACT FinalizeShadowPairAtCashClose]
    if spActive and spInitialized and not spInvalid
        for i = 0 to 1
            if not array.get(spComplete, i)
                completeShadow(i, close - array.get(spSide, i)
                     * MODEL_DAYFLAT_SLIP_TICKS * syminfo.mintick)
    else if spActive
        spActive := false
    // [EXACT RecordCompletedSessionHistory] -- eligible, complete sessions only.
    if not rthCloseHistoryRecorded and sessionDateEligible and cashWindowIntegrity
         and orbFinalized and referenceOpenCaptured
         and (lastCashBarCloseMin == REQUIRED_CASH_CLOSE_MIN or not strictContiguity)
        if not orbHistoryRecorded
            array.push(orbHistoryBps, currentOrbBps)
            if array.size(orbHistoryBps) > orbLookback
                array.shift(orbHistoryBps)
            orbHistoryRecorded := true
        if close > 0
            array.push(rthCloseHistory, close)
            if array.size(rthCloseHistory) > trendCloses
                array.shift(rthCloseHistory)
            array.push(sessionReturnHistBps, safeReturnBps(close, referenceSessionOpen))
            if array.size(sessionReturnHistBps) > 1
                array.shift(sessionReturnHistBps)
            rthCloseHistoryRecorded := true
            cntEligibleSessions += 1
    cashExitTriggered := true
    dayBlocked := true
    if strategy.position_size != 0
        strategy.close_all(comment = "CashClose1600ET")

// [EXACT TryRecordCompletedModelLabel] -- one evaluation point per bar, after
// both the per-bar walk and the cash-close finalisation.
if oneMinuteChart and spActive
    [resolved, included] = tryRecordLabel()
    if resolved
        if included
            cntLabels += 1
        spLabelRecorded := true
        spActive := false

// =============================================== in-position management
if oneMinuteChart and sameCashDate and strategy.position_size != 0
     and activeInitialStopTicks >= 1
    riskPts = activeInitialStopTicks * syminfo.mintick
    avg = strategy.position_avg_price
    sd = strategy.position_size > 0 ? 1 : -1
    // [EXACT ManageProtectiveStopAtQuarterHour]
    if isQuarterHourClose and not managedStopActivated and avg > 0
        closeR = sd * (close - avg) / riskPts
        if closeR >= activeManagedTriggerR
            managedStopPrice := roundPrice(avg + sd * riskPts * activeManagedLockR)
            managedStopActivated := true
    // [EXACT ManageConditionalExit1530]
    if barCloseMin == CONDITIONAL_EXIT_MIN and not conditionalExitRequested and avg > 0
        closeR = sd * (close - avg) / riskPts
        if not (closeR >= COND_LOSS_BOUNDARY_R and closeR < COND_PROFIT_BOUNDARY_R)
            conditionalExitRequested := true
            strategy.close_all(comment = "Conditional1530ET")

// SetStopLoss/SetProfitTarget in TICKS map to strategy.exit loss/profit; the
// managed stop switches the same order to an absolute price, which is what
// SetStopLoss(CalculationMode.Price, ...) does.
if strategy.position_size != 0 and activeInitialStopTicks >= 1 and activeTargetTicks >= 1
    if managedStopActivated
        strategy.exit("FTMx", from_entry = "FTM", stop = managedStopPrice,
             profit = activeTargetTicks)
    else
        strategy.exit("FTMx", from_entry = "FTM", loss = activeInitialStopTicks,
             profit = activeTargetTicks)

// ============================================================== SELF-TEST
// Bypasses every rule and every gate. See the input's tooltip: this exists only
// to separate "the chart cannot produce a trade" from "a rule is refusing".
var float stStop = na
var float stTgt = na
if selfTest and oneMinuteChart and isQuarterHourClose and strategy.position_size == 0
     and not breakoutConsumed and not cashExitTriggered
    breakoutConsumed := true
    stStop := 20.0
    stTgt := 60.0
    strategy.entry("FTM", strategy.long, qty = 1)
    strategy.exit("FTMx", from_entry = "FTM",
         loss = math.round(stStop / syminfo.mintick),
         profit = math.round(stTgt / syminfo.mintick))
if selfTest and oneMinuteChart and sameCashDate and barCloseMin >= FLATTEN_MIN
     and strategy.position_size != 0
    strategy.close_all(comment = "SelfTestFlat")

// ======================================== EvaluateAdmissionAndDirection
if not selfTest and oneMinuteChart and isQuarterHourClose and strategy.position_size == 0
     and not dayBlocked and orbFinalized and not breakoutConsumed and not cashExitTriggered
     and not sessionEnding
    longBreak  = close >= roundPrice(orbHigh + confirmation)
    shortBreak = close <= roundPrice(orbLow - confirmation)
    if longBreak or shortBreak
        baselineSide = longBreak ? 1 : -1
        if not sigExact
            breakoutConsumed := true
            cashWindowIntegrity := false
            dayBlocked := true
            if ped or pfd or spActive
                cntFailClosed += 1
            ped := false
            pfd := false
            spActive := false
        else
            signalRange = sigHigh - sigLow
            bodyFraction = signalRange > 0 ? baselineSide * (close - sigOpen) / signalRange : 0.0
            closeLocation = signalRange > 0
                 ? (baselineSide == 1 ? (close - sigLow) / signalRange
                                      : (sigHigh - close) / signalRange) : 0.0
            if bodyFraction < ADMISSION_BODY_FRACTION or closeLocation < ADMISSION_CLOSE_LOCATION
                cntGeometryReject += 1                     // scanning continues
            else
                baseLevel = baselineSide == 1 ? orbHigh + confirmation : orbLow - confirmation
                touches = countTouches(baselineSide, baseLevel)
                if touches < ADMISSION_MIN_TOUCHES
                    breakoutConsumed := true
                    cntTouchVeto += 1
                else if orbOpen <= 0 or orbClose <= 0 or rthVolumeSum <= 0
                     or array.size(rthMinuteCloses) == 0
                    breakoutConsumed := true
                    cashWindowIntegrity := false
                    dayBlocked := true
                    ped := false
                    pfd := false
                    spActive := false
                else
                    // [EXACT TryBuildDirectionFeatures]
                    priorClose = array.size(rthCloseHistory) > 0
                         ? array.get(rthCloseHistory, array.size(rthCloseHistory) - 1) : orbOpen
                    localSessRet = array.size(sessionReturnHistBps) > 0
                         ? array.get(sessionReturnHistBps, array.size(sessionReturnHistBps) - 1)
                         : 0.0
                    priorSessionRet = useHtfWarmup ? nz(htfSessRet) : localSessRet
                    vwap = rthTypicalVolumeSum / rthVolumeSum
                    nCl = array.size(rthMinuteCloses)
                    trailingBase = nCl > 30 ? array.get(rthMinuteCloses, nCl - 31) : orbClose
                    elapsed15 = (barCloseMin - ORB_END_MIN) / 15.0
                    wd = (dayofweek(tdTime, TZ) + 5) % 7
                    mo = month(tdTime, TZ)
                    qf = array.new<float>(0)
                    array.push(qf, baselineSide * safeReturnBps(orbOpen, priorClose))
                    array.push(qf, baselineSide * priorSessionRet)
                    array.push(qf, baselineSide * lagReturnBps(rthCloseHistory, 5))
                    array.push(qf, baselineSide * lagReturnBps(rthCloseHistory, 20))
                    array.push(qf, baselineSide * safeReturnBps(close, vwap))
                    array.push(qf, baselineSide * safeReturnBps(close, trailingBase))
                    array.push(qf, baselineSide)
                    array.push(qf, elapsed15)
                    array.push(qf, currentOrbBps)
                    array.push(qf, touches)
                    array.push(qf, math.sin(2.0 * math.pi * wd / 5.0))
                    array.push(qf, math.cos(2.0 * math.pi * wd / 5.0))
                    array.push(qf, math.sin(2.0 * math.pi * (mo - 1) / 12.0))
                    array.push(qf, math.cos(2.0 * math.pi * (mo - 1) / 12.0))

                    breakoutConsumed := true
                    cntAdmitted += 1
                    priorOverride = baselineSide * priorSessionRet < -PRIOR_DAY_CONT_BPS
                    if priorOverride
                        cntPriorOverride += 1

                    // [EXACT TryPredictDirection] -- the quarter key is latched even
                    // when the refit fails, so the model is not retried that quarter.
                    bool knnOverride = false
                    if currentCashKey >= MODEL_PREDICT_START_KEY
                        qk = quarterKeyOf(tdTime)
                        if qk != activeQuarterKey
                            activeQuarterKey := qk
                            [okFit, usedRows] = fitQuarterModel(quarterStartKey(qk))
                            modelReady := okFit
                            modelRowsUsed := usedRows
                        if modelReady
                            [avail, prob] = predictFlip(qf, quarterStartKey(activeQuarterKey))
                            if avail and prob > MODEL_FLIP_THRESHOLD
                                knnOverride := true
                                cntKnnOverride += 1

                    directionSide = (priorOverride or knnOverride) ? -baselineSide : baselineSide

                    // [EXACT StartShadowPair]
                    if currentCashKey >= MODEL_TRAIN_START_KEY
                        if spActive
                            cntFailClosed += 1
                            ped := false
                            pfd := false
                            spActive := false
                            dayBlocked := true
                        else
                            spActive := true
                            spInitialized := false
                            spInvalid := false
                            spLabelRecorded := false
                            spPendingInit := true
                            spBaselineSide := baselineSide
                            for f = 0 to MODEL_FEATURE_COUNT - 1
                                array.set(spFeatures, f, array.get(qf, f))

                    if not dayBlocked
                        tradingDateReached = currentCashKey >= tradingStartDate
                        contextReady = priorOrbQ75Available and priorTrendAvailable
                        submitActual = tradingDateReached
                             and (contextReady or not requireWarmContext)
                        if tradingDateReached and not contextReady
                            cntContextWarmup += 1

                        // [EXACT] the RC1 direct action, evaluated BEFORE the parent
                        // refinement and submitted on the BASELINE side.
                        alignedVwapBps = array.get(qf, 4)
                        directCondition = elapsed15 == RC1_DIRECT_ELAPSED_15M
                             and alignedVwapBps <= RC1_DIRECT_MAX_VWAP_BPS
                        if directCondition
                            cntRc1Direct += 1
                            if submitActual
                                submitSide := baselineSide
                                submitNow := true
                        else
                            cntRc1Parent += 1
                            directionalBody = directionSide * (close - sigOpen) / signalRange
                            weakSignal = directionalBody <= WEAK_SIGNAL_BODY_FRAC
                            highVol = priorOrbQ75Available and currentOrbBps > priorOrbQ75Bps
                            dirLevel = directionSide == 1 ? orbHigh + confirmation
                                 : orbLow - confirmation
                            dirTouches = countTouches(directionSide, dirLevel)
                            highVolTouchVote = highVol and dirTouches <= HIGH_VOL_TOUCH_LIMIT
                            if weakSignal or highVolTouchVote
                                ped := true
                                pedSide := directionSide
                                pedRequired := weakSignal ? WEAK_SIGNAL_DELAY_BARS
                                     : HIGH_VOL_VOTE_BARS
                                pedObserved := 0
                                pedFirstOpen := 0.0
                                pedSubmit := submitActual
                                pedBranch := weakSignal ? "weak_signal_delay_keep"
                                     : "high_vol_touch_vote"
                                pedBaselineSide := baselineSide
                                pedSignalClose := close
                                for f = 0 to MODEL_FEATURE_COUNT - 1
                                    array.set(pedFeatures, f, array.get(qf, f))
                                if weakSignal
                                    cntWeakDelay += 1
                                else
                                    cntHighVolVote += 1
                            else
                                b2 = refinementBranch(directionSide, baselineSide, close, qf)
                                if b2 < 0
                                    cntFailClosed += 1
                                    dayBlocked := true
                                else if b2 == 0
                                    if submitActual
                                        submitSide := directionSide
                                        submitNow := true
                                else
                                    pfd := true
                                    pfdSide := directionSide
                                    pfdRequired := b2 == 1 ? PRIOR_DISAGREE_OBS_BARS
                                         : INTRADAY_CONT_OBS_BARS
                                    pfdObserved := 0
                                    pfdFirstOpen := 0.0
                                    pfdSubmit := submitActual
                                    pfdBranch := b2 == 1 ? "prior_session_disagreement"
                                         : "intraday_continuation"

// =================================================== the single order gateway
// [EXACT SubmitEntry] -- the plan is computed by a pure function and the order,
// the state mutation and the two skip counters happen here.
if submitNow and not selfTest and strategy.position_size == 0
    [qty, stopTicks, targetTicks, trg, lck] = computeEntryPlan(submitSide)
    if stopTicks < 1 or targetTicks < 1
        cntFailClosed += 1
    else if qty < 1
        cntSizingSkip += 1
    else
        activeInitialStopTicks := stopTicks
        activeTargetTicks := targetTicks
        activeManagedTriggerR := trg
        activeManagedLockR := lck
        activeSide := submitSide
        managedStopActivated := false
        managedStopPrice := na
        conditionalExitRequested := false
        if submitSide == 1
            strategy.entry("FTM", strategy.long, qty = qty)
        else
            strategy.entry("FTM", strategy.short, qty = qty)
        // The source calls SetStopLoss and SetProfitTarget BEFORE EnterLong, so the
        // bracket is live on the fill bar. Placing it here rather than waiting for
        // the next bar's maintenance block reproduces that; a bracket that only
        // becomes live one bar later is the parity defect STUDY_V56 measured.
        strategy.exit("FTMx", from_entry = "FTM", loss = stopTicks, profit = targetTicks)

// ------------------------------------------------------------------- display
plot(orbFinalized ? orbHigh : na, "ORB high", color.new(color.teal, 0), 2, plot.style_linebr)
plot(orbFinalized ? orbLow : na,  "ORB low",  color.new(color.teal, 0), 2, plot.style_linebr)
plot(strategy.position_size != 0 and managedStopActivated ? managedStopPrice : na,
     "Managed stop", color.new(color.red, 0), 2, plot.style_linebr)
bgcolor(barOpenMin >= ORB_START_MIN and barOpenMin < ORB_END_MIN and isWeekdayCash
     ? color.new(color.teal, 92) : na, title = "opening range")
bgcolor(dayBlocked and inCashWindow ? color.new(color.red, 95) : na, title = "blocked date")

// The panel exists to answer one question -- "why did nothing trade" -- because
// every gate in this strategy fails CLOSED and a blocked date looks exactly like
// a date with no signal. Every gate is counted and the binding one is named.
orbRows = useHtfWarmup ? htfOrbRows : array.size(orbHistoryBps)
closeRows = useHtfWarmup ? htfCloseRows : array.size(rthCloseHistory)
warmOk = orbRows >= orbLookback and closeRows >= trendCloses

var table hud = table.new(position.top_right, 2, 13, border_width = 1)
if showHud and barstate.islast
    st = not oneMinuteChart ? "chart is not 1 minute -- nothing can run"
         : not sawRefEver and not refOpenFallback
             ? "no 23:00 UTC bar EVER -- switch EXTENDED HOURS on"
         : requireWarmContext and orbRows < orbLookback
             ? "BLOCKED warming up: " + str.tostring(orbRows) + "/"
               + str.tostring(orbLookback) + " opening ranges -- untick 'Refuse to trade'"
         : requireWarmContext and closeRows < trendCloses
             ? "BLOCKED warming up: " + str.tostring(closeRows) + "/"
               + str.tostring(trendCloses) + " session closes"
         : cntAdmitted == 0 and daysSeen > 3
             ? "no signal admitted yet -- blocked " + str.tostring(blkGap + blkNoRef + blkOrb)
               + " dates, see the Blocked row"
         : cntAdmitted == 0 ? "no signal admitted yet"
         : strategy.closedtrades + strategy.opentrades == 0
             ? "signals admitted, none sized -- see sizing skips"
         : "trading"
    okNow = st == "trading"
    table.cell(hud, 0, 0, "FTM ORB 1.8.0-rc.1", text_color = color.white,
         bgcolor = color.new(color.teal, 20), text_size = size.small)
    table.cell(hud, 1, 0, timeframe.period, text_color = color.white,
         bgcolor = color.new(color.teal, 20), text_size = size.small)
    table.cell(hud, 0, 1, "STATUS", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 1, st, text_size = size.small,
         text_color = okNow ? color.new(color.green, 0) : color.new(color.red, 0))
    table.cell(hud, 0, 2, "Extended hours", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 2, sawRefEver ? "23:00 UTC bar seen -- ok"
         : refOpenFallback ? "not seen, using the fallback" : "NOT SEEN -- every date blocks",
         text_size = size.small,
         text_color = sawRefEver ? color.new(color.green, 0) : color.new(color.orange, 0))
    table.cell(hud, 0, 3, "Opening ranges held", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 3, str.tostring(orbRows) + " / " + str.tostring(orbLookback)
         + (useHtfWarmup ? "  (15m request)" : "  (1m only)"), text_size = size.small,
         text_color = orbRows >= orbLookback ? color.new(color.green, 0) : color.new(color.orange, 0))
    table.cell(hud, 0, 4, "Session closes held", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 4, str.tostring(closeRows) + " / " + str.tostring(trendCloses),
         text_size = size.small,
         text_color = closeRows >= trendCloses ? color.new(color.green, 0) : color.new(color.orange, 0))
    table.cell(hud, 0, 5, "Dates seen / excluded", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 5, str.tostring(daysSeen) + " / " + str.tostring(blkExcluded),
         text_size = size.small)
    table.cell(hud, 0, 6, "Blocked: gap / noRef / ORB", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 6, str.tostring(blkGap) + " / " + str.tostring(blkNoRef) + " / "
         + str.tostring(blkOrb), text_size = size.small,
         text_color = (blkGap + blkNoRef + blkOrb) > 0 ? color.new(color.orange, 0) : color.gray)
    table.cell(hud, 0, 7, "Eligible sessions", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 7, str.tostring(cntEligibleSessions), text_size = size.small)
    table.cell(hud, 0, 8, "Admitted / geom / touch", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 8, str.tostring(cntAdmitted) + " / " + str.tostring(cntGeometryReject)
         + " / " + str.tostring(cntTouchVeto), text_size = size.small)
    table.cell(hud, 0, 9, "RC1 direct / parent", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 9, str.tostring(cntRc1Direct) + " / " + str.tostring(cntRc1Parent),
         text_size = size.small)
    table.cell(hud, 0, 10, "Warm-up skips", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 10, str.tostring(cntContextWarmup)
         + " signals refused for warm-up", text_size = size.small,
         text_color = cntContextWarmup > 0 ? color.new(color.orange, 0) : color.gray)
    table.cell(hud, 0, 11, "Sizing skips / fail-closed", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 11, str.tostring(cntSizingSkip) + " / " + str.tostring(cntFailClosed),
         text_size = size.small)
    table.cell(hud, 0, 12, "Trades", text_size = size.small, text_color = color.gray)
    table.cell(hud, 1, 12, str.tostring(strategy.closedtrades) + " closed, "
         + str.tostring(strategy.opentrades) + " open", text_size = size.small,
         text_color = strategy.closedtrades > 0 ? color.new(color.green, 0) : color.new(color.red, 0))

// The same line again, on the chart, where it cannot be missed.
var label statusLabel = na
if showStatusLabel and barstate.islast
    stx = not oneMinuteChart ? "FTM: CHART IS NOT 1 MINUTE -- switch to a 1-minute chart"
         : selfTest ? "FTM SELF-TEST: " + str.tostring(strategy.closedtrades)
           + " trades. If this is 0 the CHART cannot produce a trade, not the strategy."
         : strategy.closedtrades > 0
             ? "FTM: trading -- " + str.tostring(strategy.closedtrades) + " closed trades"
         : not sawRefEver and not refOpenFallback
             ? "FTM: no 23:00 UTC bar -- turn EXTENDED HOURS on, or tick the fallback"
         : requireWarmContext and (orbRows < orbLookback or closeRows < trendCloses)
             ? "FTM: blocked warming up " + str.tostring(orbRows) + "/"
               + str.tostring(orbLookback) + " -- untick 'Refuse to trade until warm'"
         : cntAdmitted == 0
             ? "FTM: no signal admitted. dates " + str.tostring(daysSeen) + ", blocked gap "
               + str.tostring(blkGap) + " / noRef " + str.tostring(blkNoRef) + " / ORB "
               + str.tostring(blkOrb) + " / excluded " + str.tostring(blkExcluded)
         : "FTM: " + str.tostring(cntAdmitted) + " signals admitted, "
           + str.tostring(cntSizingSkip) + " sizing skips, "
           + str.tostring(cntContextWarmup) + " warm-up refusals"
    label.delete(statusLabel)
    statusLabel := label.new(bar_index, high, stx, style = label.style_label_down,
         color = strategy.closedtrades > 0 ? color.new(color.green, 20)
             : color.new(color.red, 10),
         textcolor = color.white, size = size.normal)
