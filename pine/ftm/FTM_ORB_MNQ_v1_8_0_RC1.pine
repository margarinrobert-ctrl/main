var float referenceSessionOpen = 0.0
var int   lastCashBarCloseMin = -1
var int   orbBarCount = 0
var int   expectedNextOrbOpenMinute = ORB_START_MIN
var float orbHigh = na
var float orbLow = na
var float orbOpen = 0.0
var float orbClose = 0.0
var float currentOrbBps = 0.0
