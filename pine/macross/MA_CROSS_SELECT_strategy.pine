// SPDX-License-Identifier: MIT
// Fast MA x slow MA crossover, each average with its own TYPE and LENGTH -- linear regression
// ("LinReg", ta.linreg) is one of the types on both sides, so LinReg-over-EMA, EMA-over-LinReg,
// LinReg-over-LinReg and every other pair are all one dropdown away.
//
// NO EDGE IS CLAIMED. What this branch has measured about the idea, so it is read against that:
//   * A LinReg line fits a straight line through the window, so its ramp lag is ZERO at every
//     length -- it behaves like DEMA/TEMA, not like SMA/EMA (STUDY_MA_LAG, STUDY_V25).
//   * LinReg 9/21 VALUE cross on NQ 30m: research PF 1.309 -> locked 0.853 (control p 0.880),
//     15m 1.293 -> 0.858 -- the literal "linreg cross" was the WORST reading of five (STUDY_V25).
//   * 7 MA types x 9 pairs as a crossover: type spread 0.093 PF, pair spread 0.135, and the type
//     effect vanished at matched lag -- change the LENGTH, not the letter (STUDY_V24).
//   * EMA 16/64 cross with a 4h cap: no edge on three markets, gross edge smaller than the
//     commission (STUDY_V59).
//   * On the 09:00-range breakout, 1.15M MA-type x length combinations found nothing better than
//     EMA 13/48 (STUDY_NINE_AM_RANGE section 31).
// Use it to look, not as a finished system.
//
// ORDER MODEL. Signals are read on the CLOSED bar (barstate.isconfirmed) and fill at the next
// bar's open. The stop/target bracket is fill-relative (ticks) and is placed on the SAME bar as
// the entry, so the fill bar is never unprotected (STUDY_PINE_PARITY / STUDY_V56). The ATR is
// ta.ema(ta.tr(true), n), this branch's convention. The session clock is New York WITH seconds,
// so a 30-second chart flattens correctly (STUDY_NINE_AM_RANGE section 28).
//
// COSTS ARE ON BY DEFAULT: $0.72 per contract per side (a real MNQ round turn is ~$1.44) and one
// tick of slippage. A Strategy Tester report with zero costs is gross, not net.
//@version=5
strategy("MA cross -- selectable fast/slow type (incl. LinReg)", shorttitle = "MA-X select",
     overlay = true, pyramiding = 0, initial_capital = 50000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.72,
     slippage = 1, process_orders_on_close = false)

// ----------------------------------------------------------------------------- inputs
grpM = "Moving averages"
fType = input.string("LinReg", "Fast MA type", options = ["SMA", "EMA", "WMA", "RMA", "HMA", "VWMA", "LinReg", "DEMA", "TEMA"], group = grpM)
fLen  = input.int(13, "Fast MA length", minval = 2, group = grpM)
sType = input.string("EMA", "Slow MA type", options = ["SMA", "EMA", "WMA", "RMA", "HMA", "VWMA", "LinReg", "DEMA", "TEMA"], group = grpM)
sLen  = input.int(48, "Slow MA length", minval = 2, group = grpM)
src   = input.source(close, "Source", group = grpM)
lrOff = input.int(0, "LinReg offset (0 = value at the current bar)", minval = 0, group = grpM, tooltip = "Applies to whichever side is LinReg. 0 is the fitted line's value at the current bar, which is what ta.linreg(src, len, 0) returns.")

grpE = "Entries and exits"
sideIn = input.string("Both", "Side", options = ["Long", "Short", "Both"], group = grpE)
xMode  = input.string("Opposite cross", "Exit on", options = ["Opposite cross", "Stop / target only"], group = grpE, tooltip = "Opposite cross: close (or reverse, when Side = Both) on the opposite crossover. Stop / target only: the cross opens trades and only the bracket closes them.")
atrLen = input.int(14, "ATR length", minval = 1, group = grpE)
stopMode = input.string("ATR", "Stop", options = ["Off", "ATR", "Points"], group = grpE)
stopAtr  = input.float(2.0, "Stop, x ATR", minval = 0.1, step = 0.1, group = grpE)
stopPts  = input.float(100.0, "Stop, points", minval = 0.0, step = 1.0, group = grpE)
tgtMode  = input.string("Off", "Target", options = ["Off", "ATR", "Points"], group = grpE, tooltip = "No target has beaten every target tested on this branch more than twenty times; it stays optional.")
tgtAtr   = input.float(3.0, "Target, x ATR", minval = 0.1, step = 0.1, group = grpE)
tgtPts   = input.float(150.0, "Target, points", minval = 0.0, step = 1.0, group = grpE)

grpS = "Session (New York time)"
useWin   = input.bool(false, "Only open trades inside a window", group = grpS)
winStart = input.int(570, "Window start, minutes after midnight NY (570 = 09:30)", minval = 0, maxval = 1439, group = grpS)
winEnd   = input.int(960, "Window end, minutes after midnight NY (960 = 16:00)", minval = 1, maxval = 1440, group = grpS)
useFlat  = input.bool(false, "Flatten at a fixed time", group = grpS, tooltip = "A hard flatten has cost a trend rule most of its edge in every study on this branch that measured it. Off by default.")
flatMin  = input.int(960, "Flatten at, minutes after midnight NY", minval = 1, maxval = 1440, group = grpS)

// ----------------------------------------------------------------------------- the averages
// Every type is computed on every bar and only the result is selected, so each ta.* call keeps a
// continuous history whichever type is chosen.
f_ma(series float x, simple int len, simple string typ, simple int off) =>
    e1 = ta.ema(x, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    vSma = ta.sma(x, len)
    vEma = e1
    vWma = ta.wma(x, len)
    vRma = ta.rma(x, len)
    vHma = ta.hma(x, len)
    vVwm = ta.vwma(x, len)
    vLin = ta.linreg(x, len, off)
    vDem = 2.0 * e1 - e2
    vTem = 3.0 * e1 - 3.0 * e2 + e3
    typ == "SMA" ? vSma : typ == "EMA" ? vEma : typ == "WMA" ? vWma : typ == "RMA" ? vRma :
      typ == "HMA" ? vHma : typ == "VWMA" ? vVwm : typ == "LinReg" ? vLin :
      typ == "DEMA" ? vDem : vTem

maF = f_ma(src, fLen, fType, lrOff)
maS = f_ma(src, sLen, sType, lrOff)
crossUp = ta.crossover(maF, maS)
crossDn = ta.crossunder(maF, maS)

atrv = ta.ema(ta.tr(true), atrLen)

// ----------------------------------------------------------------------------- the clock
nyH = hour(time, "America/New_York")
nyM = minute(time, "America/New_York")
nyS = second(time, "America/New_York")
nyMin = nyH * 60 + nyM + nyS / 60.0
tfMin = timeframe.in_seconds(timeframe.period) / 60.0
// an order written at this bar's close fills at the next bar's open, which is nyMin + tfMin
fillMin = nyMin + tfMin
inWin = not useWin or (fillMin >= winStart and fillMin < winEnd)
// from the bar whose close is the last chance to be flat by flatMin until midnight, nothing opens
// and anything still open is closed (this also catches a position carried over a missing bar)
pastFlat = useFlat and fillMin >= flatMin

// ----------------------------------------------------------------------------- bracket distances
stopDist = stopMode == "ATR" ? stopAtr * atrv : stopMode == "Points" ? stopPts : na
tgtDist  = tgtMode == "ATR" ? tgtAtr * atrv : tgtMode == "Points" ? tgtPts : na
lossT = na(stopDist) or stopDist <= 0 ? na : math.max(1.0, math.round(stopDist / syminfo.mintick))
profT = na(tgtDist) or tgtDist <= 0 ? na : math.max(1.0, math.round(tgtDist / syminfo.mintick))

canLong  = sideIn == "Long" or sideIn == "Both"
canShort = sideIn == "Short" or sideIn == "Both"
okBar = barstate.isconfirmed and not na(maF) and not na(maS) and not na(atrv)

// ----------------------------------------------------------------------------- orders
hasBracket = not na(lossT) or not na(profT)

if okBar and pastFlat and strategy.position_size != 0
    strategy.close_all(comment = "flatten")

if okBar and not pastFlat
    pos = strategy.position_size
    // exits on the opposite cross (a reversal is handled by the entry below)
    if xMode == "Opposite cross"
        if pos > 0 and crossDn and not (canShort and inWin)
            strategy.close("L", comment = "opp cross")
        if pos < 0 and crossUp and not (canLong and inWin)
            strategy.close("S", comment = "opp cross")
    // entries: from flat, or a reversal when the opposite side is allowed and exits are on the cross
    flatOrRev = pos == 0 or xMode == "Opposite cross"
    if crossUp and canLong and inWin and pos <= 0 and flatOrRev
        strategy.entry("L", strategy.long)
        if hasBracket
            strategy.exit("Lx", "L", loss = lossT, profit = profT)
    else if crossDn and canShort and inWin and pos >= 0 and flatOrRev
        strategy.entry("S", strategy.short)
        if hasBracket
            strategy.exit("Sx", "S", loss = lossT, profit = profT)

// ----------------------------------------------------------------------------- plots
plot(maF, "fast MA", color = color.new(color.blue, 0), linewidth = 2)
plot(maS, "slow MA", color = color.new(color.orange, 0), linewidth = 2)
plotshape(okBar and crossUp, "cross up", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.tiny)
plotshape(okBar and crossDn, "cross down", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.tiny)

var table hud = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(hud, 0, 0, "fast", text_size = size.tiny)
    table.cell(hud, 1, 0, fType + " " + str.tostring(fLen), text_size = size.tiny)
    table.cell(hud, 0, 1, "slow", text_size = size.tiny)
    table.cell(hud, 1, 1, sType + " " + str.tostring(sLen), text_size = size.tiny)
    table.cell(hud, 0, 2, "stop", text_size = size.tiny)
    table.cell(hud, 1, 2, na(stopDist) ? "off" : str.tostring(stopDist, "#.##") + " pts = " + str.tostring(stopDist / atrv, "#.##") + " ATR", text_size = size.tiny)
    table.cell(hud, 0, 3, "edge claimed", text_size = size.tiny)
    table.cell(hud, 1, 3, "none", text_size = size.tiny, text_color = color.red)
