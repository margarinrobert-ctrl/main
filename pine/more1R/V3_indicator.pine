//@version=6
// =============================================================================================
// close>5-bar high AND outside bar AND 09:30-12:30 New York
//   long only, stop 4.0 x ATR, target 1.0 x that risk, flat at 16:00, 15-minute bars.
//   Stop and target are measured from the FILL -- the open of the bar after the signal --
//   using the ATR of the signal bar.
//
// MEASURED ON MNQ, 2022-12 to 2025-12, 1 contract, under the LIVE cost model:
//   itemised fees $1.44/round turn (broker $0.35 + CME exchange $0.35 + NFA $0.02, per side),
//   bar-dependent slippage, plus overnight / open-close / high-volatility spread widening.
//     trades                      158  (105 research / 53 locked)
//     win rate                    65.8%
//     net                         $10,626
//     research block              $3,384   ($32.2/trade)
//     locked block                $7,242   ($136.6/trade)
//     chosen on                   the research block only; the locked figures were read once
//
//   READ THIS BEFORE THE NUMBERS ABOVE. The locked block earns MORE per trade than research. That is the WRONG SHAPE --
//     an edge decays out of sample, it does not grow. Read the RESEARCH figure as the
//     forward expectation; the later period was simply kinder to this strategy.
//
//   Earlier versions of this header quoted a $1.00 flat-cost model. Those figures were about
//   4% optimistic and are superseded.
//
// THREE THINGS THAT ARE EASY TO GET WRONG, AND WERE, HERE:
//   * ATR is ta.ema(ta.tr(true), 14), alpha 2/15. Pine's ta.atr is Wilder's RMA at 1/14.
//   * Clock conditions go through an explicit timezone. Pine's bare hour/minute are EXCHANGE
//     time -- Chicago for CME -- and the research is New York.
//   * CCI is on hlc3, not close.
//
// Pine built-ins are used for RSI, Stochastic, CCI, Williams %R, MFI, DMI/ADX, OBV, linreg and
// Bollinger. They were checked against the research definitions, not executed side by side.
//
// TICK-SETTING IMMUNE: entries require barstate.isconfirmed, so the Strategy Tester's
// "On order fill" / "On history bar tick" / "On realtime bar tick" boxes cannot change
// the result. Leave them on or off; the numbers are the same.
//
// NOT COMPILED BY TRADINGVIEW. A compiler error is a typo, not a changed strategy.
// Research tooling for education and analysis. Not financial advice.
// =============================================================================================

indicator("V3 1R | close>5-bar high + outside bar + 09:30-12:30 New York | signal (signal)", overlay = true)
// ---- primitives, defined to match the research exactly -------------------------------------------
tzIn   = input.string("America/New_York", "Timezone for clock conditions",
     options = ["America/New_York", "America/Chicago", "Europe/London", "exchange"],
     group = "Setup", tooltip = "Pine's bare hour/minute are in the EXCHANGE timezone, which is " +
     "Chicago for CME. The research is New York time. Getting this wrong runs the strategy an " +
     "hour late -- it has happened here before.")
barMin = tzIn == "exchange" ? hour * 60 + minute : hour(time, tzIn) * 60 + minute(time, tzIn)

// ---- session: when signals are allowed ------------------------------------------------------
// Times are HHMM in the timezone selected above -- 930 is 09:30, 1230 is 12:30. The defaults are
// the window the strategy was MEASURED on; every statistic in the header belongs to that window
// and to no other. Widening it is a different strategy whose numbers are unknown, not a
// better-tested version of this one.
hhmmToMin(x) =>
    math.floor(x / 100) * 60 + x % 100

sigFromIn = input.int(930, "Signals start (HHMM)", minval = 0, maxval = 2359, group = "Session")
sigToIn   = input.int(1230, "Signals stop (HHMM)", minval = 0, maxval = 2400, group = "Session",
     tooltip = "Half-open: a bar exactly at this time does NOT signal. Set it BEFORE the start to " +
     "wrap past midnight, e.g. 2000 to 0400.")
sigFrom   = hhmmToMin(sigFromIn)
sigTo     = hhmmToMin(sigToIn)
inSession = sigFrom <= sigTo ? (barMin >= sigFrom and barMin < sigTo) : (barMin >= sigFrom or barMin < sigTo)
atrV   = ta.ema(ta.tr(true), 14)          // NOT ta.atr -- see the header

// ---- the rule -------------------------------------------------------------------
c0 = close > ta.highest(high, 5)[1]    // close>5-bar high
c1 = high > high[1] and low < low[1]    // outside bar
c2 = inSession    // signal window, set in the Session group
trig = c0 and c1 and c2
ready = not na(atrV) and atrV > 0 and bar_index > 300

risk = 4.0 * atrV
// drawn on the bar AFTER the signal and measured from its open, because that open is
// where the strategy fills -- the same anchor the engine uses.
fired = trig[1] and ready[1]
plot(fired ? open - risk[1] : na, "stop, long side",
     color = color.new(color.red, 0), style = plot.style_circles)
plot(fired ? open + 1.0 * risk[1] : na, "target, long side",
     color = color.new(color.teal, 0), style = plot.style_circles)
plotshape(trig and ready, "signal", shape.diamond, location.belowbar,
     color.new(color.teal, 0), size = size.tiny)
bgcolor(trig and ready ? color.new(color.teal, 88) : na)

alertcondition(trig, "Rule fires", "close>5-bar high AND outside bar AND 09:30-12:30 New York")

var table t = table.new(position.bottom_right, 2, 3, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "close>5-bar high", text_size = size.small, text_color = color.gray)
    table.cell(t, 1, 0, c0 ? "yes" : "no", text_size = size.small,
         text_color = c0 ? color.teal : color.gray)
    table.cell(t, 0, 1, "outside bar", text_size = size.small, text_color = color.gray)
    table.cell(t, 1, 1, c1 ? "yes" : "no", text_size = size.small,
         text_color = c1 ? color.teal : color.gray)
    table.cell(t, 0, 2, "09:30-12:30 New York", text_size = size.small, text_color = color.gray)
    table.cell(t, 1, 2, c2 ? "yes" : "no", text_size = size.small,
         text_color = c2 ? color.teal : color.gray)
