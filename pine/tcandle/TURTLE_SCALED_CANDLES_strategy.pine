//@version=5
// Turtle Long-Only -- CHART-SCALED LENGTHS, with a measured candlestick section.
//
// This is the "measured presets" Turtle with two things added and nothing removed. Both were
// measured in research/tcandle/ and written up in docs/ib/STUDY_TURTLE_CANDLES_TF.md.
//
// =============================================================================================
// 1. THE TIMEFRAME PARAMETER -- the change that actually matters
// ---------------------------------------------------------------------------------------------
// Every length in the original is a BAR COUNT, so `entry1 = 20` is five hours on a 15-minute chart
// and eighty hours on a 240-minute one. The four presets are therefore not four settings of one
// strategy; they are four different strategies, and the original's red "WRONG TIMEFRAME" banner is
// the script correctly refusing a question it was never asked.
//
// Measured, three markets x five timeframes x two blocks, percent of entry price per trade:
//
//     tf     carried (bar counts)        matched (reach held constant)
//            research   locked           research   locked
//     15m    -0.0512    -0.0388          +0.0076    -0.0234
//     30m    -0.0471    -0.0164          +0.0534    -0.0274
//     60m    -0.0525    -0.0940          +0.0525    -0.0601
//     120m   -0.0354    -0.0486          +0.0084    +0.0132
//     240m   +0.0369    -0.0467          (the reference -- the two readings coincide)
//
// Carried is negative at every timeframe except the one it was measured on. Matched is positive at
// four of five. Paired cell by cell (240m excluded, where they are identical by construction),
// matched beats carried in 9 of 12 research cells and 9 of 12 locked cells.
//
// AND IT IS NOT THE USUAL TRADE-COUNT ARTIFACT. The matched reading keeps only 12-64% of the
// trades, which is the shape that has faked an improvement repeatedly on this branch, so the same
// comparison was run on TOTAL return where trading less is a cost: matched still wins 11 of 12
// research cells and 9 of 12 locked, mean total +(-0.91%) against carried's -38.13% on research and
// +0.25% against -16.50% on the locked block.
//
// So `scaleToChart` ships ON. It is a UNITS FIX, not a fitted parameter -- nothing was chosen to
// make a number larger, and the reference reach is the preset's own. Turn it off to reproduce the
// original script exactly.
//
// WHAT IT DOES NOT CLAIM. It does not make this system profitable: the matched locked marginal is
// still negative at three of five timeframes. It claims only that the script throws away most of
// its own reach the moment it is moved, and that the fix costs nothing.
//
// =============================================================================================
// 2. THE CANDLESTICK SECTION -- and why almost all of it is unavailable
// ---------------------------------------------------------------------------------------------
// A System 1 entry needs `high > highest(high, 20)[1]`, and that maximum INCLUDES the previous
// bar's high, so `high > high[1]` follows by arithmetic -- measured at 100.00% of signal bars over
// fifteen market x timeframe cells. Every pattern whose definition requires `high <= high[1]` is
// therefore IMPOSSIBLE on a breakout bar, not merely unhelpful:
//
//     NEVER FIRES (5 of 32):  harami bullish, harami bearish, inside bar, piercing line, dragonfly
//     UNDER 5%   (14 of 32):  dark cloud, bearish marubozu, gap down, three black crows, bullish
//                             kicker, gravestone, evening star, hammer, three inside up, gap up,
//                             tweezer top, bearish engulfing, bullish marubozu, shooting star
//     USABLE     (13 of 32)
//     OVER 50%   (none)
//
// That last row is the interesting one. Eight confirmation families tested on this branch turned
// out to be the TRIGGER RESTATED (RSI>=55 on 94.7% of breakout bars, Aroon osc>=0 on 100.0%,
// MACD>0 on 99.8-100.0%, MFI>=50 on 91.7%). Discrete candlestick patterns are the first family that
// is NOT: none of them passes even half the signal bars. They fail the opposite test -- availability.
// The continuous shape readings do restate the trigger, as expected: 10-bar bullish share passes
// 93.3% of signal bars, five-bar up-closes 85.8%, close-above-previous-high 82.5%.
//
// EVERY CANDLESTICK INPUT BELOW SHIPS OFF. See the study for what each one scored.
// =============================================================================================
strategy("Turtle Long-Only (scaled lengths + candles)", overlay = true, pyramiding = 4, default_qty_type = strategy.fixed, default_qty_value = 1, initial_capital = 100000, calc_on_every_tick = false, process_orders_on_close = false, commission_type = strategy.commission.cash_per_order, commission_value = 0.72, slippage = 2)

// ----------------------------------------------------------------- preset
presetName = input.string("T1  240m  ADX<22 + not extended", "Preset", options = ["T1  240m  ADX<22 + not extended", "T2  240m  ADX<22", "T3  120m  ADX<22", "T4   60m  ADX<22 + not extended", "Spec defaults (no gate)", "Custom"])

// ----------------------------------------------------------------- timeframe scaling
grpTF = "Timeframe (the measured addition)"
scaleToChart = input.bool(true, "Scale lengths to this chart", group = grpTF, tooltip = "ON: the preset's REACH IN MINUTES is held constant, so its channels mean the same amount of market on any chart. Measured better than raw bar counts in 18 of 24 market x timeframe x block cells per trade, and 20 of 24 on total return. OFF: the original behaviour -- raw bar counts, and the preset only runs on its own chart.")
showEffective = input.bool(true, "Show the effective lengths on the panel", group = grpTF)

// ----------------------------------------------------------------- session (free, never locked)
grpS = "Entry session (free)"
sessOn    = input.bool(false, "Restrict entries to a session", group = grpS)
sessStart = input.session("0000-0000", "Entry session", group = grpS, tooltip = "Exits are NEVER gated -- a Turtle position is held for days, so only the decision to OPEN is restricted. Measured: 08:00-20:00 best out of sample; 09:00-16:00 RTH-only is harmful.")
sessTZ    = input.string("America/New_York", "Session timezone", group = grpS, options = ["America/New_York", "America/Chicago", "Europe/London", "UTC"])

// ----------------------------------------------------------------- candlestick filters
grpC = "Candlestick filters (all OFF -- see header)"
cndBody   = input.string("off", "Body share of range", group = grpC, options = ["off", "require large", "require small"], tooltip = "Large = body >= 50% of the bar's range. A breakout bar's body share passes 55.8% of signal bars against 50.0% of bars in general -- lift 1.12, so this is close to unconditional.")
cndClose  = input.string("off", "Close position in bar", group = grpC, options = ["off", "require upper half", "require lower half"], tooltip = "The rejection reading is 'lower half' -- a bar that breaks the channel and closes back near its low. Passes 59.2% of signal bars in the upper half against 50.0% of bars in general.")
cndWick   = input.string("off", "Upper wick", group = grpC, options = ["off", "refuse long upper wick", "require long upper wick"], tooltip = "Long = upper wick >= 50% of the range. NOTE: on a bar that CLOSES UP, upper-wick share and close position are an exact identity -- they sum to 1, measured at max |diff| 0.00e+00 -- so on those bars they are one filter wearing two names. A breakout bar closes up only 78-79% of the time, so over all signal bars they correlate -0.75 to -0.81 rather than -1.00, and the 21% where they differ is precisely the failed-break population. Switching both on is not two filters.")
cndPat    = input.string("off", "Discrete pattern", group = grpC, options = ["off", "require bullish engulfing", "require outside bar", "require three white soldiers", "refuse spinning top", "refuse shooting star"], tooltip = "Only patterns in the 5-50% usable band are offered. Harami, inside bar, piercing and dragonfly are omitted because a breakout bar makes them arithmetically impossible -- they fire on 0.000 of signal bars.")

// ----------------------------------------------------------------- custom only
grpX = "Custom only"
cEntry1   = input.int(20,  "Custom entry 1 (bars)", minval = 2, group = grpX)
cEntry2   = input.int(55,  "Custom entry 2 (bars)", minval = 2, group = grpX)
cExit1    = input.int(10,  "Custom exit 1 (bars)",  minval = 2, group = grpX)
cExit2    = input.int(20,  "Custom exit 2 (bars)",  minval = 2, group = grpX)
cAtrMult  = input.float(2.0, "Custom ATR stop multiple", minval = 0.1, group = grpX)
cPyrStep  = input.float(0.5, "Custom pyramid step (N)", minval = 0.0, group = grpX)
cMaxUnits = input.int(4,   "Custom max units", minval = 1, maxval = 4, group = grpX)
cAdxMax   = input.float(0, "Custom ADX ceiling (0 = off)", minval = 0, group = grpX)
cExtMax   = input.float(0, "Custom max distance above EMA100 in ATR (0 = off)", minval = 0, group = grpX)

// ----------------------------------------------------------------- resolved constants
isCustom = presetName == "Custom"
isSpec   = presetName == "Spec defaults (no gate)"
baseE1   = isCustom ? cEntry1   : 20
baseE2   = isCustom ? cEntry2   : 55
baseX1   = isCustom ? cExit1    : 10
baseX2   = isCustom ? cExit2    : 20
atrLen   = 20
atrMult  = isCustom ? cAtrMult  : 2.0
pyrStep  = isCustom ? cPyrStep  : 0.5
maxUnits = isCustom ? cMaxUnits : 4
skipWin  = true

adxMax = switch presetName
    "T1  240m  ADX<22 + not extended" => 22.0
    "T2  240m  ADX<22"                => 22.0
    "T3  120m  ADX<22"                => 22.0
    "T4   60m  ADX<22 + not extended" => 22.0
    "Spec defaults (no gate)"         => 0.0
    => cAdxMax

extMax = switch presetName
    "T1  240m  ADX<22 + not extended" => 3.964
    "T2  240m  ADX<22"                => 0.0
    "T3  120m  ADX<22"                => 0.0
    "T4   60m  ADX<22 + not extended" => 3.193
    "Spec defaults (no gate)"         => 0.0
    => cExtMax

// The reach a preset was measured at, IN MINUTES. This is what `scaleToChart` preserves.
designMin = switch presetName
    "T1  240m  ADX<22 + not extended" => 240.0
    "T2  240m  ADX<22"                => 240.0
    "T3  120m  ADX<22"                => 120.0
    "T4   60m  ADX<22 + not extended" => 60.0
    => 0.0

designTF = switch presetName
    "T1  240m  ADX<22 + not extended" => "240"
    "T2  240m  ADX<22"                => "240"
    "T3  120m  ADX<22"                => "120"
    "T4   60m  ADX<22 + not extended" => "60"
    => timeframe.period

// ----------------------------------------------------------------- the scale factor
// `math.max` and `math.round` are FLOAT-typed whatever they are handed, so the cast has to wrap
// the WHOLE expression -- `int x = math.max(1, int(y))` does not compile, and that error has
// shipped twice on this branch.
tfMin  = math.max(1.0, timeframe.in_seconds(timeframe.period) / 60.0)
canScale = scaleToChart and designMin > 0
kScale = canScale ? designMin / tfMin : 1.0
entry1 = int(math.max(2.0, math.round(baseE1 * kScale)))
entry2 = int(math.max(2.0, math.round(baseE2 * kScale)))
exit1  = int(math.max(2.0, math.round(baseX1 * kScale)))
exit2  = int(math.max(2.0, math.round(baseX2 * kScale)))

// With scaling ON the preset is meaningful on any chart, so the hard timeframe lock is released.
// With it OFF the original lock stands, because the preset's numbers then mean a different amount
// of market on every other chart.
onDesignTF = isCustom or isSpec or canScale or timeframe.period == designTF

// ----------------------------------------------------------------- series
atrN    = ta.atr(atrLen)
chanHi1 = ta.highest(high, entry1)
chanHi2 = ta.highest(high, entry2)
chanLo1 = ta.lowest(low,  exit1)
chanLo2 = ta.lowest(low,  exit2)
ema100  = ta.ema(close, 100)
[diPlus, diMinus, adxVal] = ta.dmi(14, 14)
distEma = atrN > 0 ? (close - ema100) / atrN : 0.0

// ----------------------------------------------------------------- candlestick series
rngBar   = math.max(high - low, syminfo.mintick / 100.0)
bodyBar  = math.abs(close - open)
upWick   = high - math.max(open, close)
bodyShr  = bodyBar / rngBar
closePos = (close - low) / rngBar
upShr    = upWick / rngBar
isUp     = close > open
engulfB  = isUp and close[1] < open[1] and close >= open[1] and open <= close[1]
outsideB = high > high[1] and low < low[1]
rng1Bar  = math.max(high[1] - low[1], syminfo.mintick / 100.0)
rng2Bar  = math.max(high[2] - low[2], syminfo.mintick / 100.0)
threeW   = isUp and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2] and bodyShr >= 0.5 and math.abs(close[1] - open[1]) >= 0.5 * rng1Bar and math.abs(close[2] - open[2]) >= 0.5 * rng2Bar
spinTop  = bodyShr <= 0.30 and upWick >= 0.25 * rngBar and (math.min(open, close) - low) >= 0.25 * rngBar
shootSt  = bodyBar <= 0.35 * rngBar and upWick >= 2.0 * bodyBar and (math.min(open, close) - low) <= 0.20 * rngBar and close[1] < close

cndOkBody  = cndBody  == "off" ? true : cndBody  == "require large" ? bodyShr >= 0.50 : bodyShr < 0.50
cndOkClose = cndClose == "off" ? true : cndClose == "require upper half" ? closePos >= 0.50 : closePos < 0.50
cndOkWick  = cndWick  == "off" ? true : cndWick  == "refuse long upper wick" ? upShr < 0.50 : upShr >= 0.50
cndOkPat   = cndPat   == "off" ? true : cndPat == "require bullish engulfing" ? engulfB : cndPat == "require outside bar" ? outsideB : cndPat == "require three white soldiers" ? threeW : cndPat == "refuse spinning top" ? not spinTop : not shootSt
cndOk = cndOkBody and cndOkClose and cndOkWick and cndOkPat

// ----------------------------------------------------------------- gates
adxOk  = adxMax <= 0 or adxVal < adxMax
extOk  = extMax <= 0 or distEma < extMax
inSess = not sessOn or not na(time(timeframe.period, sessStart, sessTZ))
gateOk = adxOk and extOk and inSess and onDesignTF and cndOk

// ----------------------------------------------------------------- state
// The stop and the ladder anchor to the ACTUAL FILL, not the signal bar's close: the research
// fills at the NEXT bar's open, so the anchoring happens one bar later from the real fill price.
var float stopLvl   = na
var float nextAdd   = na
var float firstFill = na
var float pendAtr   = na
var int   unitsOn   = 0
var int   sysOn     = 0
var int   lastCount = 0
var bool  lastWin   = false

// GUARD EVERY BLOCK THAT WRITES `var` STATE, not only the entries. `lastWin := close > firstFill`
// left unguarded reads a MID-BAR close, and `lastWin` decides which System 1 breakouts are taken --
// so an unguarded write lets the script choose its trades from a price the bar-close run cannot
// see. See docs/ib/STUDY_TICK_RECALC.md: ticking the recalculation boxes moved the same rules from
// -913 to +62,278 and the trade count from 11,398 to 14,462, and the bar-close run is the correct
// one.
if barstate.isconfirmed
    if strategy.position_size == 0 and lastCount > 0
        lastWin   := close > firstFill
        unitsOn   := 0
        sysOn     := 0
        stopLvl   := na
        nextAdd   := na
        lastCount := 0
    if strategy.opentrades > lastCount
        fillPx = strategy.opentrades.entry_price(strategy.opentrades - 1)
        anchorAtr = na(pendAtr) ? atrN : pendAtr
        if lastCount == 0
            firstFill := fillPx
        stopLvl   := fillPx - atrMult * anchorAtr
        nextAdd   := fillPx + pyrStep * anchorAtr
        unitsOn   := strategy.opentrades
        lastCount := strategy.opentrades

flat = strategy.position_size == 0

// ----------------------------------------------------------------- entries
sig2 = high > chanHi2[1]
sig1 = high > chanHi1[1]

if barstate.isconfirmed and flat and gateOk and atrN > 0
    if sig2
        strategy.entry("S2", strategy.long, qty = 1)
        sysOn   := 2
        pendAtr := atrN
    else if sig1
        if skipWin and lastWin
            lastWin := false
        else
            strategy.entry("S1", strategy.long, qty = 1)
            sysOn   := 1
            pendAtr := atrN

// ----------------------------------------------------------------- pyramid adds
if barstate.isconfirmed and not flat and unitsOn > 0 and unitsOn < maxUnits and pyrStep > 0
    if high >= nextAdd
        strategy.entry("add" + str.tostring(unitsOn + 1), strategy.long, qty = 1)
        pendAtr := atrN

// ----------------------------------------------------------------- exit
// One stop at the HIGHER of the ATR stop and the channel low: falling price reaches that level
// first. Worth +0.05 to +0.13 R/trade against the spec's "ATR stop checked first" ordering.
chanExit  = sysOn == 1 ? chanLo1[1] : chanLo2[1]
exitLevel = na(stopLvl) ? chanExit : (na(chanExit) ? stopLvl : math.max(stopLvl, chanExit))

if not flat and not na(exitLevel)
    strategy.exit("x", stop = exitLevel)

// ----------------------------------------------------------------- plots
plot(chanHi1, "Entry 1", color = color.new(color.aqua, 40))
plot(chanHi2, "Entry 2", color = color.new(color.blue, 40))
plot(chanLo1, "Exit 1",  color = color.new(color.red, 60))
plot(chanLo2, "Exit 2",  color = color.new(color.purple, 60))
plot(flat ? na : exitLevel, "Active stop", color = color.fuchsia, style = plot.style_linebr)

// A changed session, a scaled length or a wrong chart must never be invisible in a screenshot.
sessChanged = sessOn and sessStart != "0000-0000"
cndOnAny = cndBody != "off" or cndClose != "off" or cndWick != "off" or cndPat != "off"
var table hud = table.new(position.top_right, 1, 5, border_width = 1)
if barstate.islast
    table.cell(hud, 0, 0, presetName, text_color = color.white, bgcolor = onDesignTF ? color.new(color.teal, 20) : color.new(color.red, 10))
    tfTxt = canScale ? "scaled from " + str.tostring(designMin, "#") + "m -> " + str.tostring(tfMin, "#") + "m" : (onDesignTF ? "timeframe OK" : "WRONG TIMEFRAME - needs " + designTF)
    table.cell(hud, 0, 1, tfTxt, text_color = color.white, bgcolor = onDesignTF ? color.new(color.teal, 40) : color.red)
    lenTxt = showEffective ? "entry " + str.tostring(entry1) + "/" + str.tostring(entry2) + "  exit " + str.tostring(exit1) + "/" + str.tostring(exit2) : ""
    table.cell(hud, 0, 2, lenTxt, text_color = color.white, bgcolor = color.new(color.gray, 40))
    table.cell(hud, 0, 3, sessChanged ? "session " + sessStart + " " + sessTZ : "session: all hours", text_color = color.white, bgcolor = sessChanged ? color.new(color.orange, 20) : color.new(color.gray, 40))
    table.cell(hud, 0, 4, cndOnAny ? "CANDLE FILTER ON - not measured to help" : "candle filters: off", text_color = color.white, bgcolor = cndOnAny ? color.new(color.orange, 20) : color.new(color.gray, 40))
