// ================================================================================================
// TFI -- an intraday trend follower built from the branch's edge library (STUDY_NEW_DESIGN).
//
//     TRIGGER   close crosses above the 55-bar Donchian high (15-minute bars)
//     GATE      ADX(14) >= 20, AND the close is above the PRIOR COMPLETED RTH SESSION'S HIGH
//               (accumulated from this chart's own 09:30-16:00 bars and frozen at the close;
//               request.security on a daily bar would return the 24-hour high, which is wrong)
//     ENTRY     market order at the next bar's open, entries 09:30-14:00 New York, one unit
//     EXIT      2.5 x ATR(14) stop (ATR = ta.ema(ta.tr(true), 14), the research definition),
//               OR a close below the 20-bar Donchian low (exit at the next open),
//               OR the 16:00 flatten (order sent on the 15:45 bar's close). NO TARGET.
//
// MEASURED (docs/ib/STUDY_NEW_DESIGN.md), long only: NQ research n 145, 50.3% win, PF 1.40,
// +0.143 R, beats a random-bar control with the identical geometry at p 0.013; NQ locked n 81,
// 55.6%, PF 1.24, +0.047 R, p 0.327. US100 15m: PF 1.34 / 1.56 / 1.20 on research / validation /
// test with control p 0.000 / 0.000 / 0.080. US30: null (0.97 / 1.01 / 0.92). The prior-session-
// high gate is the component: without it NQ locked PF is 1.00. Every target tested made it worse.
// 61-63% of exits are the flatten -- the intraday constraint costs about half of what this family
// earns when it may hold overnight. It does NOT reach 66% / PF 1.5; see the study for why nothing
// honest on this data does.
//
// XAUUSD (STUDY_NEW_DESIGN §6): re-selecting every axis on gold's own research block gave 63% /
// PF 1.50 there and PF 0.91 on 2025-26; the best research cell went 1.75 -> 0.75; the unchanged NQ
// defaults went 0.89 -> 1.20, which is the wrong shape (gold's 2025 rally). NO GOLD SETTINGS ARE
// RECOMMENDED. The "Extra gates" group carries what was tested so it can be re-run: the two
// floors, and the session the prior-day level is taken from. On gold the one axis that moved
// research was the entry window 08:30-11:30 New York, and it did not carry.
//
// US30 (STUDY_NEW_DESIGN §7): this design is a null on US30 on every cell (PF 0.92-1.01 on its
// three blocks), and the branch's earlier US30 survivor (Donchian 30/20, ADX >= 15, 2.5 ATR, 2R
// target, all hours, no flatten) re-measured here at one unit is PF 1.05 / 0.86 / 0.98 on US30's
// own blocks and 1.25 on the ISO 2026 tail, where removing the ADX filter does BETTER (1.29) --
// a regime, not a rule. NO US30 SETTINGS ARE RECOMMENDED. The flatten switch and the 24-hour
// entry window are here so that form can be run.
//
// SECOND PASS (STUDY_NEW_DESIGN §7): window, flatten, ADX and stop re-chosen by two-feed
// agreement on NQ and US100 research -- the consensus IS these defaults. Holding overnight is
// worth PF 1.72 on US100 research and 1.22 on NQ, so the feeds disagree and it is not selected.
//
// EXTENDED HOURS ON, 15-MINUTE CHART. Every var write sits under barstate.isconfirmed.
// Research tooling for education and analysis -- not financial advice.
// ================================================================================================
//@version=6
strategy("TFI intraday trend (library build)", shorttitle = "TFI", overlay = true,
     pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = false,
     initial_capital = 50000, currency = currency.USD, default_qty_type = strategy.fixed,
     default_qty_value = 1, commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.72, slippage = 1)

grpR = "Rule"
donIn = input.int(55, "Entry channel (bars)", minval = 5, group = grpR)
donOut = input.int(20, "Exit channel (bars)", minval = 3, group = grpR)
adxLen = input.int(14, "ADX length", minval = 2, group = grpR)
adxFloor = input.float(20.0, "ADX floor", minval = 0.0, step = 1.0, group = grpR)
useGate = input.bool(true, "Require close above the prior RTH session high", group = grpR)
stopMult = input.float(2.5, "Stop, x ATR(14)", minval = 0.25, step = 0.25, group = grpR)
useTarget = input.bool(false, "Use a target (measured worse; here for the win-rate variant)",
     group = grpR)
tgtMult = input.float(1.0, "Target, x stop", minval = 0.25, step = 0.25, group = grpR)
allowShort = input.bool(false, "Allow the short mirror (measured PF 0.85)", group = grpR)

grpG = "Extra gates (measured on gold; default OFF, see STUDY_NEW_DESIGN §6)"
emaFloor = input.float(0.0, "EMA(100) distance floor, x ATR (0 = off)", minval = 0.0, step = 0.5,
     group = grpG)
atrFloor = input.float(0.0, "ATR expansion floor, ATR / SMA(ATR, 50) (0 = off)", minval = 0.0,
     step = 0.1, group = grpG)
lvlStartH = input.int(9, "Prior-session level: session start hour", minval = 0, maxval = 23,
     group = grpG)
lvlStartM = input.int(30, "Prior-session level: session start minute", minval = 0, maxval = 59,
     group = grpG)
lvlEndH = input.int(16, "Prior-session level: session end hour", minval = 0, maxval = 24,
     group = grpG)
lvlEndM = input.int(0, "Prior-session level: session end minute", minval = 0, maxval = 59,
     group = grpG)

grpS = "Session (New York)"
entStartH = input.int(9, "Entries from hour", minval = 0, maxval = 23, group = grpS)
entStartM = input.int(30, "Entries from minute", minval = 0, maxval = 59, group = grpS)
entEndH = input.int(14, "Last entry hour (24 = all hours)", minval = 0, maxval = 24, group = grpS)
entEndM = input.int(0, "Last entry minute", minval = 0, maxval = 59, group = grpS)
useFlatten = input.bool(true, "Flatten at the time below (off = hold on the channel / stop)",
     group = grpS)
flatH = input.int(16, "Flat by hour", minval = 0, maxval = 23, group = grpS)
flatM = input.int(0, "Flat by minute", minval = 0, maxval = 59, group = grpS)
showHud = input.bool(true, "Show panel", group = "Display")

tz = "America/New_York"
nyMod = hour(time, tz) * 60 + minute(time, tz)
nyDay = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
tfMin = timeframe.multiplier
entStart = entStartH * 60 + entStartM
entEnd = entEndH * 60 + entEndM
flatMin = flatH * 60 + flatM
lvlStart = lvlStartH * 60 + lvlStartM
lvlEnd = lvlEndH * 60 + lvlEndM
inRth = nyMod >= lvlStart and nyMod < lvlEnd       // the session the prior-day level is taken from
inEntry = nyMod >= entStart and nyMod < entEnd

// ---- indicators, the research definitions
atr14 = ta.ema(ta.tr(true), 14)
ema100 = ta.ema(close, 100)
atrSma = ta.sma(atr14, 50)
emaDist = atr14 > 0 ? (close - ema100) / atr14 : na
atrExp = atrSma > 0 ? atr14 / atrSma : na
floorsOkL = (emaFloor <= 0 or (not na(emaDist) and emaDist >= emaFloor))
     and (atrFloor <= 0 or (not na(atrExp) and atrExp >= atrFloor))
floorsOkS = (emaFloor <= 0 or (not na(emaDist) and emaDist <= -emaFloor))
     and (atrFloor <= 0 or (not na(atrExp) and atrExp >= atrFloor))
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)     // ta.dmi returns [+DI, -DI, ADX]
donHi = ta.highest(high, donIn)[1]
donLo = ta.lowest(low, donIn)[1]
exitLo = ta.lowest(low, donOut)[1]
exitHi = ta.highest(high, donOut)[1]

// ---- prior completed RTH session high / low, from this chart's own bars
var int curDay = na
var float rthH = na
var float rthL = na
var float priorH = na
var float priorL = na
if barstate.isconfirmed
    // a comparison against na is FALSE in Pine, so the first day must be caught explicitly
    if na(curDay) or nyDay != curDay
        if not na(rthH)
            priorH := rthH
            priorL := rthL
        curDay := nyDay
        rthH := na
        rthL := na
    if inRth
        rthH := na(rthH) ? high : math.max(rthH, high)
        rthL := na(rthL) ? low : math.min(rthL, low)

// ---- signals on the confirmed bar; orders fill at the next open
longSig = close > donHi and close[1] <= donHi[1] and adxVal >= adxFloor and floorsOkL
     and (not useGate or (not na(priorH) and close > priorH))
shortSig = allowShort and close < donLo and close[1] >= donLo[1] and adxVal >= adxFloor
     and floorsOkS and (not useGate or (not na(priorL) and close < priorL))
flattenDue = useFlatten and nyMod + tfMin >= flatMin   // last close before the flat time

var float stopLvl = na
var float tgtLvl = na
inPos = strategy.position_size != 0
if barstate.isconfirmed
    if inPos and flattenDue
        strategy.close_all(comment = "flat")
        stopLvl := na
    else if inPos
        chanExit = strategy.position_size > 0 ? close < exitLo : close > exitHi
        if chanExit
            strategy.close_all(comment = "channel")
            stopLvl := na
    else if inEntry and not flattenDue and not na(atr14) and atr14 > 0
        if longSig
            stopLvl := close - stopMult * atr14
            tgtLvl := useTarget ? close + tgtMult * stopMult * atr14 : na
            strategy.entry("L", strategy.long, comment = "L")
            if useTarget
                strategy.exit("Lx", from_entry = "L", stop = stopLvl, limit = tgtLvl)
            else
                strategy.exit("Lx", from_entry = "L", stop = stopLvl)
        else if shortSig
            stopLvl := close + stopMult * atr14
            tgtLvl := useTarget ? close - tgtMult * stopMult * atr14 : na
            strategy.entry("S", strategy.short, comment = "S")
            if useTarget
                strategy.exit("Sx", from_entry = "S", stop = stopLvl, limit = tgtLvl)
            else
                strategy.exit("Sx", from_entry = "S", stop = stopLvl)

plot(donHi, "Entry channel high", color = color.new(color.teal, 40))
plot(useGate ? priorH : na, "Prior RTH session high", color = color.new(color.orange, 0),
     style = plot.style_linebr, linewidth = 2)
plot(inPos ? stopLvl : na, "Stop", color = color.new(color.red, 0), style = plot.style_linebr,
     linewidth = 2)
plot(inPos and strategy.position_size > 0 ? exitLo : na, "Exit channel",
     color = color.new(color.gray, 30), style = plot.style_linebr)
bgcolor(inEntry ? color.new(color.blue, 96) : na)

var table hud = table.new(position.top_right, 2, 5, border_width = 1)
if showHud and barstate.islast
    table.cell(hud, 0, 0, "ADX", text_size = size.small)
    table.cell(hud, 1, 0, str.tostring(adxVal, "#.#"), text_size = size.small,
         text_color = adxVal >= adxFloor ? color.green : color.gray)
    table.cell(hud, 0, 1, "Prior RTH high", text_size = size.small)
    table.cell(hud, 1, 1, na(priorH) ? "-" : str.tostring(priorH, "#.##"), text_size = size.small,
         text_color = not na(priorH) and close > priorH ? color.green : color.gray)
    table.cell(hud, 0, 2, "Entry channel high", text_size = size.small)
    table.cell(hud, 1, 2, str.tostring(donHi, "#.##"), text_size = size.small)
    table.cell(hud, 0, 3, "Position", text_size = size.small)
    table.cell(hud, 1, 3, inPos ? (strategy.position_size > 0 ? "long" : "short") : "flat",
         text_size = size.small, text_color = inPos ? color.green : color.gray)
    table.cell(hud, 0, 4, "Timeframe", text_size = size.small)
    table.cell(hud, 1, 4, timeframe.period + (timeframe.isintraday ? "" : " (needs intraday)"),
         text_size = size.small)
