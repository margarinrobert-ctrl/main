//@version=5
// V11-MARKET -- the best MARKET-ORDER entry found. No resting limit, no partial, no ladder.
//
// ================================ WHY THIS ONE ================================
// It is the only configuration in this whole programme that passes BOTH controls on the research
// block, and the perturbation surface is the flattest measured here.
//
//   GATE 1, matched control -- the Donchian breakout against a RANDOM BAR with identical stop,
//   identical exits and identical trade count:   +12.19 vs +2.32 points/trade,  p = 0.007.
//   GATE 2, selectivity -- ADX >= 25 against a random filter of the SAME selectivity drawn from
//   the ungated breakout population:             +12.19 vs  +4.89 points/trade,  p = 0.016.
//
// Every earlier version of this system FAILED gate 1 (p 0.12 - 0.43). The difference is the ADX
// floor at 25 rather than 15, and removing the take-profit entirely.
//
// NQ 15-minute, 70,685 bars, 2022-12-26 -> 2025-12-12. Research = first 65% of sessions; LOCKED
// read ONCE after the parameters were fixed. 459 cells were swept, on research only.
//
//                                      research                    LOCKED
//                              n    PF   Sharpe  pts/tr     n    PF   Sharpe  pts/tr
//   V9-PROP as shipped        968  1.08   0.66   +2.00     477  1.17   1.23   +6.17
//   V11 (this script)         339  1.44   2.28  +12.19     178  1.29   1.36  +11.61
//
// Points per trade nearly DOUBLE on the block that chose nothing, on a third of the trades.
// The shape is right: it decays research -> locked rather than improving.
//
// ================================ ROBUSTNESS ================================
//   PERTURBATION IS A RIDGE, NOT A SPIKE. Every axis, +/-10 to 20%, moves profit factor by 0.05
//   or less: stop 2.0N/2.25N/2.75N/3.0N -> 1.43/1.41/1.49/1.47; ADX 22/28 -> 1.45/1.40;
//   Donchian 45/65 -> 1.43/1.44; exit channel 15/25 -> 1.39/1.45. Nothing here is balanced on a
//   parameter.
//   BOOTSTRAP of the mean: 95% CI [+2.46, +21.85], P(mean <= 0) = 0.0075.
//   10% RANDOM TRADE OMISSION: profit factor p5 1.28, median 1.38. Not carried by a few trades.
//   WALK-FORWARD, six folds, no refit: 5/6 positive, median PF 1.61, worst 0.98.
//   MONTE CARLO, 20,000 shuffles: realised drawdown 2,044 against a median of 1,284 and a p95 of
//   2,033 -- the realised sequence was UNLUCKY, not lucky, which is the rarer and safer direction.
//   SIZE FOR THE p99 OF 2,459 POINTS, not for the 2,044 you can see on the chart.
//
// ================================ WHAT IS HONEST TO FLAG ================================
//   * DRAWDOWN NEARLY TRIPLES OUT OF SAMPLE: 703 points on research, 2,044 on locked, so
//     return-over-drawdown falls from 5.88 to 1.01. Profit factor and Sharpe held; the drawdown
//     did not. Plan for the locked figure.
//   * ONE FOLD OF SIX IS FLAT (PF 0.98, Sharpe -0.12) and it carries the whole maximum drawdown.
//     A six-month dead patch is inside the normal behaviour of this system.
//   * THERE IS NO TAKE PROFIT. That is not an omission -- across 459 cells, no target beat having
//     none, on both the marginal average and the plateau. Trades end at the ATR stop or the
//     20-bar channel exit, and the winners are what pay for a 36% win rate.
//   * LONG ONLY, on a sample where NQ rose 89%. Not tested short.
//   * 459 cells were searched. Both controls are run on RESEARCH and the locked block was read
//     once; that is the discipline, but the multiplicity is real and the locked figures are the
//     ones to believe.
// ============================================================================

strategy("Turtle V11-MARKET (NQ 15m)", overlay = true, pyramiding = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 100000, calc_on_every_tick = false, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_order, commission_value = 0.72, slippage = 2)

// ===================== STRATEGY TESTER PROPERTIES =====================
//   Script execution   ON BAR CLOSE only -- see docs/ib/STUDY_TICK_RECALC.md.
//   Bar detalization   High, with Deep Backtesting.   Order execution delay  One tick.
//   Commission         $0.72 CASH PER ORDER = $1.44 a round turn, the real MNQ stack.
//   Slippage           2 ticks. A stop fills INTO the move that triggered it.
//   Leverage Infinity  stops silent order rejection; then read DOLLAR drawdown, not %.
//   Read the TRADE COUNT and the COMMISSION LOAD before the P&L.
// ======================================================================

gE      = "Entry"
donLen  = input.int(55,   "Donchian breakout length", minval = 2, group = gE,
     tooltip = "Flat from 45 to 65. The original Turtle's System 2 channel.")
adxMin  = input.float(25, "ADX floor", minval = 0, step = 1, group = gE,
     tooltip = "25, not 15. This is the single change that makes the breakout beat a random entry: at 15 the trigger fails its matched control, at 25 it passes at p 0.007.")

gX      = "Exit -- one unit, ATR stop or channel, whichever is nearer"
atrLen  = input.int(20,   "ATR length", minval = 2, group = gX)
atrMult = input.float(2.5,"ATR stop multiple", minval = 0.1, step = 0.1, group = gX,
     tooltip = "Flat from 2.0N to 3.0N. Wider is mildly better; tighter is measurably worse.")
exitCh  = input.int(20,   "Donchian exit channel", minval = 2, group = gX)
useTp   = input.bool(false,"Use a take profit", group = gX,
     tooltip = "OFF is not an omission. Across 459 cells no target beat having none.")
tpR     = input.float(3.0,"  target, in R", minval = 0.1, step = 0.1, group = gX)
qty     = input.int(1,    "Contracts", minval = 1, group = gX)

gS      = "Session window (off by default)"
sessOn  = input.bool(false, "Restrict entries to a window and flatten", group = gS)
startHH = input.int(7,  "Window start -- hour (New York)", minval = 0, maxval = 23, group = gS)
startMM = input.int(0,  "Window start -- minute",          minval = 0, maxval = 59, group = gS)
flatHH  = input.int(16, "Flatten -- hour (New York)",      minval = 0, maxval = 23, group = gS)
flatMM  = input.int(0,  "Flatten -- minute",               minval = 0, maxval = 59, group = gS)

// ----------------------------------------------------------------- series
// ta.atr IS Wilder's RMA of true range, which is what mirror.wilder_atr computes. That match is
// deliberate: the limit-distance work elsewhere on this branch uses ema(TR, n), a DIFFERENT
// series, and swapping the two silently moves every level in a script.
atrN    = ta.atr(atrLen)
donHi   = ta.highest(high, donLen)[1]   // EXCLUDES the current bar, or a break is impossible
chanLo  = ta.lowest(low,  exitCh)[1]
// ta.dmi returns [+DI, -DI, ADX] IN THAT ORDER -- the first element is +DI, not ADX.
[_pdi, _mdi, adxVal] = ta.dmi(14, 14)

// BARE `hour` AND `minute` ARE EXCHANGE TIME IN PINE -- Chicago for CME. Read New York explicitly.
modNY   = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
startM  = startHH * 60 + startMM
flatM   = flatHH * 60 + flatMM
barMin  = timeframe.in_seconds(timeframe.period) / 60
inWin   = not sessOn or (modNY >= startM and modNY < flatM - barMin)
atFlat  = sessOn and modNY >= flatM

okAdx   = adxMin <= 0 or (not na(adxVal) and adxVal >= adxMin)
ready   = not na(atrN) and atrN > 0 and not na(donHi)
gateOk  = ready and okAdx and inWin

// ----------------------------------------------------------------- state
var float sigAtr  = na       // ATR FROZEN AT THE SIGNAL BAR; the stop reads this for the whole trade
var float entryPx = na
var int   lastCnt = 0
var int   exitBar = -1

// EVERY var-STATE BLOCK IS GUARDED, AND SO IS THE EXIT CALL. Guarding part of a coupled set
// desynchronises it rather than partly fixing it -- see docs/ib/STUDY_TICK_RECALC.md.
if barstate.isconfirmed and strategy.position_size == 0 and lastCnt > 0
    exitBar := bar_index
    sigAtr  := na
    entryPx := na
    lastCnt := 0

if barstate.isconfirmed and strategy.opentrades > lastCnt
    entryPx := strategy.opentrades.entry_price(strategy.opentrades - 1)
    lastCnt := strategy.opentrades

flat = strategy.position_size == 0

// ----------------------------------------------------------------- entry
// `bar_index > exitBar` reproduces the engine resuming its scan at the bar AFTER the exit bar.
// The bracket rides with the entry so the ENTRY BAR is covered. Where `stop` and `loss` are both
// given Pine takes the SMALLER LOSS, which for a long is the HIGHER level -- exactly the engine's
// max(ATR stop, channel low), reproduced rather than approximated.
lossTk = int(math.max(1, math.round(atrMult * atrN / syminfo.mintick)))
tpTk   = useTp ? int(math.max(1, math.round(tpR * atrMult * atrN / syminfo.mintick))) : na

if barstate.isconfirmed and flat and gateOk and bar_index > exitBar and high > donHi
    sigAtr := atrN
    strategy.entry("B", strategy.long, qty = qty)
    strategy.exit("x0", from_entry = "B", stop = chanLo, loss = lossTk, profit = tpTk)

// ----------------------------------------------------------------- exit
atrStop   = na(entryPx) or na(sigAtr) ? na : entryPx - atrMult * sigAtr
exitLevel = na(atrStop) ? chanLo : (na(chanLo) ? atrStop : math.max(atrStop, chanLo))
tpLevel   = not useTp or na(entryPx) or na(sigAtr) ? na : entryPx + tpR * atrMult * sigAtr

if barstate.isconfirmed and not flat and lastCnt > 0 and not na(exitLevel)
    // "x0" covered the entry bar; "x" takes over. Cancel the first or both rest.
    strategy.cancel("x0")
    strategy.exit("x", stop = exitLevel, limit = tpLevel)

// ----------------------------------------------------------------- flatten
// LAST, so it cancels what the blocks above just placed.
if barstate.isconfirmed and atFlat
    strategy.cancel_all()
    if not flat
        strategy.close_all(comment = "flatten")

// ----------------------------------------------------------------- plots
plot(donHi,  "Breakout channel", color = color.new(color.aqua, 30))
plot(chanLo, "Exit channel",     color = color.new(color.red, 60))
plot(flat ? na : exitLevel, "Working stop", color = color.fuchsia, style = plot.style_linebr)
plot(flat or not useTp ? na : tpLevel, "Target", color = color.new(color.lime, 0), style = plot.style_linebr)

onTf = timeframe.period == "15"
var table hud = table.new(position.top_right, 1, 3, border_width = 1)
if barstate.islast
    table.cell(hud, 0, 0, "V11-MARKET - passes both controls (p 0.007 / 0.016)",
         text_color = color.white, bgcolor = color.new(color.teal, 20))
    table.cell(hud, 0, 1, onTf ? "15m chart" : "NOT 15m - studied on 15m only",
         text_color = color.white, bgcolor = onTf ? color.new(color.teal, 45) : color.red)
    table.cell(hud, 0, 2, "Drawdown TRIPLES out of sample (703 -> 2,044). Size for 2,459.",
         text_color = color.white, bgcolor = color.new(color.orange, 15))
