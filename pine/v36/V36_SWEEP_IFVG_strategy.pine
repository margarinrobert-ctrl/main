// =================================================================================================
// V36  LIQUIDITY SWEEP -> REVERSAL -> IFVG
//
// THIS STRATEGY FAILED VALIDATION. It is published so the rules can be inspected on a chart and
// replicated, NOT because it is tradeable. Measured on 1-minute NQ, 2022-12 to 2025-12, with real
// MNQ costs, one live order and a true 1-minute execution path:
//
//   5,400 declared configurations. Scored in R, 1.4% clear a profit factor of 1; scored in dollars,
//   16.1%. ALL TWENTY-FOUR MARGINAL AVERAGES ARE NEGATIVE IN BOTH UNITS -- there is no axis with a
//   positive region. The best cell sits in the intersection of the two worst marginals, has no
//   parameter neighbourhood (its family averages -0.0067 R, and changing the entry mode one step
//   takes it from +0.292 to -0.554), and loses 84% of its edge on validation. Out-of-sample was
//   never opened because nothing earned it.
//
//   See docs/ib/STUDY_V36_SWEEP_IFVG.md for the full report and the two measurement errors it
//   corrects -- R is unsafe as a unit when the stop is structural, and a best-of-N subgroup search
//   must be scored against a null that also takes its best of N.
//
// PINE CORRECTNESS NOTES, each of which has shipped broken on this branch once:
//   * ATR is ta.ema(ta.tr(true), n), NOT ta.atr, which is Wilder's RMA.
//   * Bare `hour` / `minute` are EXCHANGE time -- Chicago for CME, not New York. Every session
//     boundary here reads hour(time, "America/New_York").
//   * request.security on a daily bar returns the 24-HOUR futures high, not the session high, so
//     Asia / London / previous-day levels are accumulated on this chart's own bars and frozen.
//   * Every block that writes `var` state is guarded by barstate.isconfirmed, not just the entries.
//     Mid-bar `close` is the current price; unguarded state makes the report about the "Script
//     execution" checkboxes rather than about the rules.
//   * A pivot needs `right` bars to confirm, so ta.pivothigh(n,n) is only knowable n bars later.
//     That lag is respected, not back-dated.
// =================================================================================================
//@version=5
strategy("V36 Sweep -> IFVG Reversal [FAILED VALIDATION]", overlay=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=0.62,
     slippage=2, calc_on_every_tick=false, process_orders_on_close=false,
     margin_long=0, margin_short=0)

// ---- inputs -------------------------------------------------------------------------------------
grpS = "Sweep"
sweepDef  = input.string("wick", "Sweep definition", options=["wick", "close", "pen_only"],
     group=grpS, tooltip="wick: pierce then close back inside. close: close beyond then reclaim. pen_only: pierce only.")
penATR    = input.float(0.10, "Minimum penetration (ATR)", minval=0.0, step=0.05, group=grpS)
reclaimN  = input.int(15, "Reclaim window (bars)", minval=1, group=grpS)
poolLife  = input.int(480, "Pool lifetime (bars)", minval=20, group=grpS,
     tooltip="A swing low from two years ago is not live liquidity. Pools expire.")
cooldown  = input.int(12, "Bars between setups", minval=1, group=grpS)

grpL = "Liquidity pools"
usePiv    = input.bool(true, "Higher-timeframe swings", group=grpL)
pivLen    = input.int(3, "Pivot left/right", minval=1, group=grpL)
htf1      = input.timeframe("60", "Swing timeframe 1", group=grpL)
htf2      = input.timeframe("240", "Swing timeframe 2", group=grpL)
useAsia   = input.bool(true, "Asia high/low", group=grpL)
useLondon = input.bool(true, "London high/low", group=grpL)
usePD     = input.bool(true, "Previous day high/low", group=grpL)

grpF = "IFVG"
maxGap    = input.int(12, "Max bars, sweep to inversion", minval=1, group=grpF)
retestN   = input.int(12, "Bars to fill the retest limit", minval=1, group=grpF)
entryMode = input.string("edge", "Entry", options=["edge", "mid"], group=grpF)
reqDisp   = input.bool(false, "Require a displacement candle", group=grpF)
dispATR   = input.float(1.0, "Displacement size (ATR)", minval=0.0, step=0.1, group=grpF)

grpX = "Risk"
atrLen    = input.int(14, "ATR length", minval=2, group=grpX)
stopMode  = input.string("max", "Stop", options=["atr", "sweep", "max"], group=grpX)
stopK     = input.float(1.0, "ATR stop multiple", minval=0.1, step=0.25, group=grpX)
stopBuf   = input.float(0.25, "Buffer beyond sweep extreme (ATR)", minval=0.0, step=0.05, group=grpX)
tpR       = input.float(1.5, "Target (R)", minval=0.25, step=0.25, group=grpX)
useBE     = input.bool(false, "Move to breakeven", group=grpX)
beAt      = input.float(1.0, "Breakeven trigger (R)", minval=0.1, step=0.25, group=grpX)

grpT = "Session"
useWin    = input.bool(false, "Restrict entries to a window", group=grpT)
winStart  = input.int(930, "Window start (min since 18:00 NY)", minval=0, maxval=1440, group=grpT)
winEnd    = input.int(1320, "Window end", minval=0, maxval=1440, group=grpT)
useFlat   = input.bool(false, "Flatten at a time", group=grpT)
flatAt    = input.int(1315, "Flatten (min since 18:00 NY)", minval=0, maxval=1440, group=grpT)

// ---- New York clock. Pine has no forward references, so this block precedes every use. ----------
nyH   = hour(time, "America/New_York")
nyM   = minute(time, "America/New_York")
mod   = nyH * 60 + nyM
tmin  = (mod - 1080 + 1440) % 1440          // minutes since the 18:00 roll; monotone in a session
newTD = tmin < nz(tmin[1], 0)               // the trading day rolls when tmin wraps

// ---- ATR: ema of true range, NOT ta.atr --------------------------------------------------------
atr = ta.ema(ta.tr(true), atrLen)

// ---- session levels, accumulated here and FROZEN at the window end ------------------------------
var float asiaH = na, var float asiaL = na, var float asiaHF = na, var float asiaLF = na
var float lonH  = na, var float lonL  = na, var float lonHF  = na, var float lonLF  = na
var float rthH  = na, var float rthL  = na, var float pdH    = na, var float pdL    = na
inAsia = tmin >= 0   and tmin < 540
inLon  = tmin >= 540 and tmin < 930
inRTH  = tmin >= 930 and tmin < 1320

if barstate.isconfirmed
    if newTD
        pdH   := rthH
        pdL   := rthL
        rthH  := na
        rthL  := na
        asiaH := na
        asiaL := na
        lonH  := na
        lonL  := na
        asiaHF := na
        asiaLF := na
        lonHF  := na
        lonLF  := na
    if inAsia
        asiaH := na(asiaH) ? high : math.max(asiaH, high)
        asiaL := na(asiaL) ? low  : math.min(asiaL, low)
    if inLon
        lonH := na(lonH) ? high : math.max(lonH, high)
        lonL := na(lonL) ? low  : math.min(lonL, low)
        if na(asiaHF)
            asiaHF := asiaH
            asiaLF := asiaL
    if inRTH
        rthH := na(rthH) ? high : math.max(rthH, high)
        rthL := na(rthL) ? low  : math.min(rthL, low)
        if na(lonHF)
            lonHF := lonH
            lonLF := lonL

// ---- higher-timeframe swings, with the confirmation lag respected -------------------------------
ph1 = request.security(syminfo.tickerid, htf1, ta.pivothigh(pivLen, pivLen), lookahead=barmerge.lookahead_off)
pl1 = request.security(syminfo.tickerid, htf1, ta.pivotlow(pivLen, pivLen),  lookahead=barmerge.lookahead_off)
ph2 = request.security(syminfo.tickerid, htf2, ta.pivothigh(pivLen, pivLen), lookahead=barmerge.lookahead_off)
pl2 = request.security(syminfo.tickerid, htf2, ta.pivotlow(pivLen, pivLen),  lookahead=barmerge.lookahead_off)

var float[] poolHi = array.new_float()
var int[]   poolHiB = array.new_int()
var float[] poolLo = array.new_float()
var int[]   poolLoB = array.new_int()

addPool(float lvl, bool isHigh) =>
    if not na(lvl)
        if isHigh
            array.push(poolHi, lvl)
            array.push(poolHiB, bar_index)
        else
            array.push(poolLo, lvl)
            array.push(poolLoB, bar_index)

if barstate.isconfirmed
    if usePiv
        if not na(ph1) and (na(ph1[1]) or ph1 != ph1[1])
            addPool(ph1, true)
        if not na(pl1) and (na(pl1[1]) or pl1 != pl1[1])
            addPool(pl1, false)
        if not na(ph2) and (na(ph2[1]) or ph2 != ph2[1])
            addPool(ph2, true)
        if not na(pl2) and (na(pl2[1]) or pl2 != pl2[1])
            addPool(pl2, false)
    if useAsia and not na(asiaHF) and na(asiaHF[1])
        addPool(asiaHF, true)
        addPool(asiaLF, false)
    if useLondon and not na(lonHF) and na(lonHF[1])
        addPool(lonHF, true)
        addPool(lonLF, false)
    if usePD and not na(pdH) and na(pdH[1])
        addPool(pdH, true)
        addPool(pdL, false)

// ---- the sweep. A pool is CONSUMED when swept, so a level is never traded twice. -----------------
var int   lastSweep   = -10000
var int   sweepBar    = na
var int   sweepSide   = 0
var float sweepExt    = na
var float sweptLevel  = na

sweepHit(float lvl, int side) =>
    bool pierced = side > 0 ? low < lvl - penATR * atr : high > lvl + penATR * atr
    bool backIn  = side > 0 ? close > lvl : close < lvl
    bool beyond  = side > 0 ? close < lvl : close > lvl
    bool res = false
    if sweepDef == "pen_only"
        res := pierced
    else if sweepDef == "wick"
        res := pierced and backIn
    else
        res := pierced and backIn and (side > 0 ? close[1] < lvl : close[1] > lvl)
    res

// Returns the swept LEVEL, or na. It deliberately does NOT return an index.
//
// The first version did, and it was wrong: it pruned expired pools in the same downward pass that
// searched for a match, so every removal at a lower index shifted the recorded hit index down by
// one, and the caller's array.remove() then addressed a slot past the end -- "Index 14 is out of
// bounds, array size is 14". An index into a mutating array is not a durable reference.
//
// Two passes instead. Prune first, so the array is stable; then search, and remove the match at the
// moment it is found, while the index is still valid. Nothing outside this function ever holds an
// index into these arrays.
scanPools(bool isHigh) =>
    arr  = isHigh ? poolHi : poolLo
    arrB = isHigh ? poolHiB : poolLoB
    int  side = isHigh ? -1 : 1
    float hitLvl = na

    // pass 1 -- expire. Downward, so surviving lower indices are never disturbed.
    if array.size(arrB) > 0
        for i = array.size(arrB) - 1 to 0
            if i < array.size(arrB) and bar_index - array.get(arrB, i) > poolLife
                array.remove(arr, i)
                array.remove(arrB, i)

    // pass 2 -- match. The array is stable now, so the index is valid when it is used.
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            if i < array.size(arr)
                float lvl = array.get(arr, i)
                if sweepHit(lvl, side)
                    hitLvl := lvl
                    array.remove(arr, i)
                    array.remove(arrB, i)
                    break
    hitLvl

if barstate.isconfirmed and bar_index - lastSweep >= cooldown and not na(atr) and atr > 0
    float lvlL = scanPools(false)
    float lvlH = scanPools(true)
    if not na(lvlL)
        sweepBar   := bar_index
        sweepSide  := 1
        sweepExt   := low
        sweptLevel := lvlL
        lastSweep  := bar_index
    else if not na(lvlH)
        sweepBar   := bar_index
        sweepSide  := -1
        sweepExt   := high
        sweptLevel := lvlH
        lastSweep  := bar_index

// ---- FVG, invalidation, and the inversion --------------------------------------------------------
bullFVG = low > high[2]
bearFVG = high < low[2]
dispOK  = not reqDisp or math.abs(close[1] - open[1]) >= dispATR * atr

var float fvgLo = na, var float fvgHi = na, var int fvgPol = 0
if barstate.isconfirmed and dispOK
    if bullFVG
        fvgLo := high[2]
        fvgHi := low
        fvgPol := 1
    else if bearFVG
        fvgLo := high
        fvgHi := low[2]
        fvgPol := -1

// A BEARISH FVG closed through to the UPSIDE becomes a BULLISH IFVG -- support. That is the one a
// long reversal needs after sweeping lows. The mirror applies to shorts.
var float ifvgLo = na, var float ifvgHi = na, var int ifvgPol = 0, var int ifvgBar = na
if barstate.isconfirmed and fvgPol != 0
    if fvgPol == -1 and close > fvgHi
        ifvgLo := fvgLo
        ifvgHi := fvgHi
        ifvgPol := 1
        ifvgBar := bar_index
        fvgPol := 0
    else if fvgPol == 1 and close < fvgLo
        ifvgLo := fvgLo
        ifvgHi := fvgHi
        ifvgPol := -1
        ifvgBar := bar_index
        fvgPol := 0

// ---- the setup: an inversion of the matching polarity, after the sweep, within maxGap -------------
inWin  = not useWin or (tmin >= winStart and tmin < winEnd)
armed  = not na(sweepBar) and not na(ifvgBar) and ifvgPol == sweepSide and ifvgBar >= sweepBar
     and (ifvgBar - sweepBar) <= maxGap and (bar_index - ifvgBar) <= retestN

entryLvl = entryMode == "edge" ? (sweepSide > 0 ? ifvgHi : ifvgLo) : (ifvgLo + ifvgHi) / 2.0
stopATR  = sweepSide > 0 ? entryLvl - stopK * atr : entryLvl + stopK * atr
stopSW   = sweepSide > 0 ? sweepExt - stopBuf * atr : sweepExt + stopBuf * atr
stopLvl  = stopMode == "atr" ? stopATR : stopMode == "sweep" ? stopSW :
     (sweepSide > 0 ? math.min(stopATR, stopSW) : math.max(stopATR, stopSW))
riskPts  = math.abs(entryLvl - stopLvl)
tgtLvl   = sweepSide > 0 ? entryLvl + tpR * riskPts : entryLvl - tpR * riskPts

canGo = barstate.isconfirmed and armed and inWin and strategy.position_size == 0
     and not na(entryLvl) and not na(stopLvl) and riskPts > syminfo.mintick * 4

// A resting limit that is never cancelled is the V34 defect in Pine form: the order outlives its
// retest window and fills on a setup that has expired. It is cancelled the moment `armed` lapses.
// Note the policy question this raises. Re-issuing strategy.entry on each new setup RE-PRICES the
// live order, which STUDY_V15_BOOK measured as twice as bad as leaving it untouched -- "keep the
// order current" chases the market. Entries are therefore gated on having no live order.
var bool pending = false
if canGo and not pending
    if sweepSide > 0
        strategy.entry("L", strategy.long, limit=entryLvl)
    else
        strategy.entry("S", strategy.short, limit=entryLvl)
    pending := true

if barstate.isconfirmed and pending and strategy.position_size == 0 and not armed
    strategy.cancel("L")
    strategy.cancel("S")
    pending := false

if barstate.isconfirmed and strategy.position_size != 0
    pending := false

if strategy.position_size != 0
    float st = stopLvl
    if useBE
        float fav = strategy.position_size > 0 ? high - strategy.position_avg_price
             : strategy.position_avg_price - low
        if fav >= beAt * riskPts
            st := strategy.position_avg_price
    strategy.exit("X", stop=st, limit=tgtLvl)

if useFlat and barstate.isconfirmed and tmin >= flatAt and strategy.position_size != 0
    strategy.close_all(comment="flat")

// ---- plots ---------------------------------------------------------------------------------------
plot(useAsia   ? asiaHF : na, "Asia H",   color.new(color.orange, 40), style=plot.style_linebr)
plot(useAsia   ? asiaLF : na, "Asia L",   color.new(color.orange, 40), style=plot.style_linebr)
plot(useLondon ? lonHF  : na, "London H", color.new(color.blue, 40),   style=plot.style_linebr)
plot(useLondon ? lonLF  : na, "London L", color.new(color.blue, 40),   style=plot.style_linebr)
plot(usePD     ? pdH    : na, "PD H",     color.new(color.gray, 40),   style=plot.style_linebr)
plot(usePD     ? pdL    : na, "PD L",     color.new(color.gray, 40),   style=plot.style_linebr)
plotshape(barstate.isconfirmed and sweepBar == bar_index and sweepSide > 0, "Sweep low",
     shape.triangleup, location.belowbar, color.new(color.teal, 0), size=size.tiny)
plotshape(barstate.isconfirmed and sweepBar == bar_index and sweepSide < 0, "Sweep high",
     shape.triangledown, location.abovebar, color.new(color.maroon, 0), size=size.tiny)
bgcolor(armed ? color.new(sweepSide > 0 ? color.teal : color.maroon, 88) : na)
